class HttpServer:
    func constructor(self):
        self.routes = {}
        self.rute = self.routes
        self.defaultHandler = None
        self.penanganBawaan = self.defaultHandler

    func on(self, method, path, handler):
        k = method.upper() + ":" + path
        self.routes[k] = handler

    func pada(self, method, path, handler):
        self.on(method, path, handler)

    func get(self, path, handler):
        self.on("GET", path, handler)

    func post(self, path, handler):
        self.on("POST", path, handler)

    func put(self, path, handler):
        self.on("PUT", path, handler)

    func delete(self, path, handler):
        self.on("DELETE", path, handler)

    func handleRequest(self, req):
        k = req.method + ":" + req.path
        if k in self.routes:
            fn = self.routes[k]
            return fn(req)
        wc = "*:" + req.path
        if wc in self.routes:
            fn = self.routes[wc]
            return fn(req)
        if self.defaultHandler != None:
            return self.defaultHandler(req)
        return HttpResponse(404, "Not Found", {"Content-Type": "text/plain"}, "404 Not Found")

    func tanganiPermintaan(self, req):
        return self.handleRequest(req)

    func listen(self, port, directHandler = None):
        srv = self

        func netHandler(rawReq):
            hdr = HttpHeaders()
            if "header" in rawReq:
                ph = rawReq["header"]
                for k in ph:
                    hdr.set(k, ph[k])

            req = HttpRequest(
                rawReq["metode"],
                rawReq["path"],
                hdr,
                rawReq["tubuh"]
            )
            req.ip = rawReq["ip"]

            resp = directHandler(req) if directHandler != None else srv.handleRequest(req)

            if type(resp) == "string" or type(resp) == "str" or type(resp) == "teks":
                resp = HttpResponse(200, "OK", {"Content-Type": "text/plain"}, resp)
            elif type(resp) == "peta" or type(resp) == "dict":
                if "status" in resp and "tubuh" in resp:
                    return resp
                resp = HttpResponse(200, "OK", {"Content-Type": "application/json"}, jsonEncode(resp))

            out = {}
            out["status"] = resp.status
            out["tubuh"] = resp.body
            out["header"] = resp.header.all()
            return out

        httpListen(port, netHandler)

    func dengar(self, port, directHandler = None):
        self.listen(port, directHandler)

ServerHTTP = HttpServer

func textResponse(body, status = 200):
    return HttpResponse(status, httpStatusReason(status), {"Content-Type": "text/plain; charset=utf-8"}, body)

responsTeks = textResponse

func jsonResponse(data, status = 200):
    return HttpResponse(status, httpStatusReason(status), {"Content-Type": "application/json"}, jsonEncode(data))

responsJson = jsonResponse

func htmlResponse(html, status = 200):
    return HttpResponse(status, httpStatusReason(status), {"Content-Type": "text/html; charset=utf-8"}, html)

responsHtml = htmlResponse

func redirectResponse(loc, status = 302):
    return HttpResponse(status, httpStatusReason(status), {"Location": loc}, "")

responsRedirect = redirectResponse

func errorResponse(status, msg = ""):
    body = msg if msg != "" else httpStatusReason(status)
    return HttpResponse(status, httpStatusReason(status), {"Content-Type": "text/plain"}, body)

responsKesalahan = errorResponse
