class Alamat:
    func __init__(self, host = "127.0.0.1", port = 80):
        self.host = host
        self.port = port

    func ke_teks(self):
        return self.host + ":" + str(self.port)

class BufferJaringan:
    func __init__(self):
        self.data = ""

    func tulis(self, chunk):
        self.data += chunk

    func panjang_data(self):
        return len(self.data)

    func cari(self, sep):
        return self.data.find(sep)

    func intip(self, n = 0):
        if n <= 0 or n >= len(self.data):
            return self.data
        return self.data[:n]

    func baca(self, n):
        if n <= 0:
            return ""
        if n >= len(self.data):
            out = self.data
            self.data = ""
            return out
        out = self.data[:n]
        self.data = self.data[n:]
        return out

    func baca_sampai(self, sep):
        pos = self.data.find(sep)
        if pos == -1:
            return None
        slen = len(sep)
        out = self.data[:pos]
        self.data = self.data[pos + slen:]
        return out

    func kosongkan(self):
        self.data = ""

class KoneksiTCP:
    func __init__(self, fd, host = "", port = 0):
        self.fd = fd
        self.host = host
        self.port = port
        self.open = fd >= 0
        self.buf = ""

    func apakah_terbuka(self):
        return self.open and (self.fd >= 0)

    func kirim(self, data):
        if not self.apakah_terbuka():
            return -1
        tot = len(data)
        if tot == 0:
            return 0

        sent = 0
        while sent < tot:
            chunk = data[sent:]
            n = tcp_kirim(self.fd, chunk)
            if n <= 0:
                self.tutup()
                return -1
            sent += n
        return sent

    func kirim_baris(self, line = ""):
        return self.kirim(line + "\r\n")

    func terima(self, maxlen = 4096):
        if not self.apakah_terbuka():
            return ""
        return tcp_terima(self.fd, maxlen)

    func baca_persis(self, target_len, chunk_sz = 4096):
        while len(self.buf) < target_len:
            if not self.apakah_terbuka():
                break
            chunk = tcp_terima(self.fd, chunk_sz)
            if chunk == "":
                break
            self.buf += chunk

        if len(self.buf) >= target_len:
            out = self.buf[:target_len]
            self.buf = self.buf[target_len:]
            return out

        out = self.buf
        self.buf = ""
        return out

    func baca_sampai(self, sep, chunk_sz = 4096, max_limit = 1048576):
        pos = self.buf.find(sep)
        while pos == -1:
            if len(self.buf) > max_limit:
                return None
            if not self.apakah_terbuka():
                break
            chunk = tcp_terima(self.fd, chunk_sz)
            if chunk == "":
                break
            self.buf += chunk
            pos = self.buf.find(sep)

        if pos != -1:
            slen = len(sep)
            out = self.buf[:pos]
            self.buf = self.buf[pos + slen:]
            return out

        return None

    func baca_baris(self, chunk_sz = 1024):
        line = self.baca_sampai("\r\n", chunk_sz)
        if line != None:
            return line
        return self.baca_sampai("\n", chunk_sz)

    func baca_semua(self, chunk_sz = 4096):
        while self.apakah_terbuka():
            chunk = tcp_terima(self.fd, chunk_sz)
            if chunk == "":
                break
            self.buf += chunk
        out = self.buf
        self.buf = ""
        return out

    func tutup(self):
        if self.open:
            self.open = False
            if self.fd >= 0:
                try:
                    tcp_tutup(self.fd)
                except:
                    pass
                self.fd = -1

func konek(host, port):
    try:
        fd = tcp_konek(host, port)
        if fd < 0:
            return None
        return KoneksiTCP(fd, host, port)
    except:
        return None

func buka_koneksi(host, port):
    fd = tcp_konek(host, port)
    if fd < 0:
        lempar "Gagal terhubung ke " + host + ":" + str(port)
    return KoneksiTCP(fd, host, port)

func kirim_email(host, port, dari, kepada, subjek, tubuh):
    conn = konek(host, port)
    if conn == None:
        return False

    func baca_balasan():
        return conn.terima(4096)

    func cek_ok(resp):
        if len(resp) >= 3:
            c = resp[0]
            return (c == "2" or c == "3")
        return False

    func kirim_dan_cek(cmd):
        if conn.kirim_baris(cmd) < 0:
            return False
        r = baca_balasan()
        return cek_ok(r)

    greeting = baca_balasan()
    if not cek_ok(greeting):
        conn.tutup()
        return False

    if not kirim_dan_cek("EHLO nusantara"):
        conn.tutup()
        return False
    if not kirim_dan_cek("MAIL FROM:<" + dari + ">"):
        conn.tutup()
        return False
    if not kirim_dan_cek("RCPT TO:<" + kepada + ">"):
        conn.tutup()
        return False
    if not kirim_dan_cek("DATA"):
        conn.tutup()
        return False

    msg = "From: " + dari + "\r\nTo: " + kepada + "\r\nSubject: " + subjek + "\r\n\r\n" + tubuh + "\r\n."
    ok = kirim_dan_cek(msg)

    conn.kirim_baris("QUIT")
    conn.tutup()
    return ok
