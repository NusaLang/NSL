fileExistsRaw = file_ada
readFileRaw = baca_file

func readU16(buf, off):
    return ord(buf[off]) | (ord(buf[off + 1]) << 8)

func readU32(buf, off):
    return ord(buf[off]) | (ord(buf[off + 1]) << 8) | (ord(buf[off + 2]) << 16) | (ord(buf[off + 3]) << 24)

func toHexByte(b):
    hexChars = "0123456789abcdef"
    return hexChars[(b >> 4) & 15] + hexChars[b & 15]

func loadWav(path):
    info = {
        "ok": False,
        "format": 0,
        "channels": 0,
        "sampleRate": 0,
        "bitsPerSample": 0,
        "dataStart": 0,
        "dataSize": 0,
        "buf": ""
    }

    if not fileExistsRaw(path):
        return info

    buf = readFileRaw(path)
    tot = len(buf)
    if tot < 12:
        return info

    if buf[0:4] != "RIFF" or buf[8:12] != "WAVE":
        return info

    pos = 12
    haveFmt = False
    haveData = False

    while pos + 8 <= tot:
        cid = buf[pos:pos + 4]
        sz = readU32(buf, pos + 4)
        bStart = pos + 8
        if bStart + sz > tot:
            break

        if cid == "fmt " and sz >= 16:
            info["format"] = readU16(buf, bStart)
            info["channels"] = readU16(buf, bStart + 2)
            info["sampleRate"] = readU32(buf, bStart + 4)
            info["sample_rate"] = info["sampleRate"]
            info["bitsPerSample"] = readU16(buf, bStart + 14)
            info["bits_per_sample"] = info["bitsPerSample"]
            haveFmt = True
        elif cid == "data":
            info["dataStart"] = bStart
            info["data_start"] = bStart
            info["dataSize"] = sz
            info["data_size"] = sz
            haveData = True

        pos = bStart + sz + (sz % 2)

    if not haveFmt or not haveData:
        return info
    if info["format"] != 1:
        return info
    bps = info["bitsPerSample"]
    if bps != 8 and bps != 16 and bps != 24 and bps != 32:
        return info
    if info["channels"] == 0:
        return info

    info["buf"] = buf
    info["ok"] = True
    return info

muatWav = loadWav

func wavInfo(path):
    w = loadWav(path)
    if not w["ok"]:
        return "{\"ok\": false, \"error\": \"failed to open/parse WAV (supports raw PCM only, 8/16/24/32-bit)\"}"

    bps = w["bitsPerSample"] / 8
    nSamp = 0
    if bps > 0 and w["channels"] > 0:
        nSamp = w["dataSize"] / bps / w["channels"]

    return (
        "{\"ok\": true, \"sample_rate\": " + str(w["sampleRate"]) +
        ", \"channels\": " + str(w["channels"]) +
        ", \"bit_depth\": " + str(w["bitsPerSample"]) +
        ", \"num_samples\": " + str(nSamp) + "}"
    )

func wavLsbExtract(path, nBit):
    w = loadWav(path)
    if not w["ok"]:
        return ""
    if nBit < 1 or nBit > 8:
        return ""

    bps = w["bitsPerSample"] / 8
    stride = bps
    buf = w["buf"]
    dStart = w["dataStart"]
    dSize = w["dataSize"]

    out = ""
    cur = 0
    filled = 0
    off = 0

    while off + stride <= dSize:
        v = ord(buf[dStart + off])
        bit = nBit - 1
        while bit >= 0:
            bVal = (v >> bit) & 1
            cur = (cur << 1) | bVal
            filled += 1
            if filled == 8:
                out += toHexByte(cur)
                cur = 0
                filled = 0
            bit -= 1
        off += stride

    if filled > 0:
        cur = cur << (8 - filled)
        out += toHexByte(cur)

    return out
