# class Color(Enum): RED = 1  -- members are objects with .name and .value (made by the parser's _enum_init)
class Enum:
    def __str__(self):
        return type(self).__name__ + "." + self.name
    def __repr__(self):
        return "<" + type(self).__name__ + "." + self.name + ": " + repr(self.value) + ">"
    def __hash__(self):
        return hash(self.name)

class IntEnum(Enum):
    pass

class StrEnum(Enum):
    pass

class Flag(Enum):
    pass

class IntFlag(Flag):
    pass

def auto():
    return {"__auto__": True}

def unique(cls):
    return cls
