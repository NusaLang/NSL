import os
import glob as _glob
import fnmatch
import shutil

class Path:
    def __init__(self, *parts):
        p = ""
        for x in parts:
            s = str(x)
            if s.startswith("/"):
                p = s
            elif p == "":
                p = s
            else:
                p = p + ("" if p.endswith("/") else "/") + s
        if p == "":
            p = "."
        while len(p) > 1 and p.endswith("/"):
            p = p[:-1]
        self._p = p
    def __str__(self):
        return self._p
    def __repr__(self):
        return "PosixPath('" + self._p + "')"
    def __truediv__(self, other):
        return Path(self._p, str(other))
    def __eq__(self, other):
        return str(other) == self._p
    def __lt__(self, other):
        return self._p < str(other)
    def joinpath(self, *others):
        return Path(self._p, *others)
    @property
    def name(self):
        return self._p.split("/")[-1] if self._p != "/" else ""
    @property
    def suffix(self):
        n = self.name
        i = n.rfind(".")
        return n[i:] if i > 0 else ""
    @property
    def suffixes(self):
        n = self.name
        parts = n.split(".")
        return ["." + s for s in parts[1:]] if n.startswith(".") is False else []
    @property
    def stem(self):
        n = self.name
        i = n.rfind(".")
        return n[:i] if i > 0 else n
    @property
    def parent(self):
        i = self._p.rfind("/")
        if i < 0:
            return Path(".")
        if i == 0:
            return Path("/")
        return Path(self._p[:i])
    @property
    def parents(self):
        out = []
        p = self.parent
        while True:
            out.append(p)
            if str(p) in (".", "/"):
                break
            p = p.parent
        return out
    @property
    def parts(self):
        segs = [s for s in self._p.split("/") if s != ""]
        if self._p.startswith("/"):
            return tuple(["/"] + segs)
        return tuple(segs)
    @property
    def anchor(self):
        return "/" if self._p.startswith("/") else ""
    def is_absolute(self):
        return self._p.startswith("/")
    def exists(self):
        return os.path.exists(self._p)
    def is_file(self):
        return os.path.isfile(self._p)
    def is_dir(self):
        return os.path.isdir(self._p)
    def read_text(self, encoding=None):
        with open(self._p) as f:
            return f.read()
    def write_text(self, data, encoding=None):
        with open(self._p, "w") as f:
            f.write(data)
        return len(data)
    def read_bytes(self):
        return self.read_text()
    def write_bytes(self, data):
        return self.write_text(data)
    def open(self, mode="r", **kw):
        return open(self._p, mode)
    def mkdir(self, mode=0o777, parents=False, exist_ok=False):
        if os.path.exists(self._p):
            if exist_ok:
                return None
            raise FileExistsError(self._p)
        if parents:
            os.makedirs(self._p)
        else:
            os.mkdir(self._p)
    def unlink(self, missing_ok=False):
        if not os.path.exists(self._p) and missing_ok:
            return None
        os.remove(self._p)
    def rmdir(self):
        os.rmdir(self._p)
    def rename(self, target):
        os.rename(self._p, str(target))
        return Path(target)
    def replace(self, target):
        return self.rename(target)
    def touch(self, exist_ok=True):
        if not os.path.exists(self._p):
            with open(self._p, "w") as f:
                f.write("")
    def iterdir(self):
        for n in os.listdir(self._p):
            yield Path(self._p, n)
    def glob(self, pattern):
        for p in _glob.glob(self._p + "/" + pattern, recursive=True):
            yield Path(p)
    def rglob(self, pattern):
        for p in _glob.glob(self._p + "/**/" + pattern, recursive=True):
            yield Path(p)
    def resolve(self):
        return Path(os.path.abspath(self._p))
    def absolute(self):
        return self.resolve()
    def expanduser(self):
        return Path(os.path.expanduser(self._p))
    def with_suffix(self, suffix):
        return self.parent / (self.stem + suffix)
    def with_name(self, name):
        return self.parent / name
    def with_stem(self, stem):
        return self.parent / (stem + self.suffix)
    def relative_to(self, other):
        o = str(other)
        if not self._p.startswith(o):
            raise ValueError(self._p + " is not in the subpath of " + o)
        return Path(self._p[len(o):].lstrip("/"))
    def stat(self):
        return {"st_size": os.path.getsize(self._p), "st_mtime": os.path.getmtime(self._p)}
    def samefile(self, other):
        return os.path.abspath(self._p) == os.path.abspath(str(other))
    @staticmethod
    def cwd():
        return Path(os.getcwd())
    @staticmethod
    def home():
        return Path(os.path.expanduser("~"))

PurePath = Path
PosixPath = Path
PurePosixPath = Path
