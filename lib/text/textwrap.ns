def wrap(text, width=70, **kw):
    words = text.split()
    lines = []
    cur = ""
    for w in words:
        if cur == "":
            cur = w
        elif len(cur) + 1 + len(w) <= width:
            cur = cur + " " + w
        else:
            lines.append(cur)
            cur = w
    if cur != "":
        lines.append(cur)
    return lines

def fill(text, width=70, **kw):
    return "\n".join(wrap(text, width))

def dedent(text):
    lines = text.split("\n")
    margin = None
    for l in lines:
        if l.strip() == "":
            continue
        indent = len(l) - len(l.lstrip())
        if margin is None or indent < margin:
            margin = indent
    if not margin:
        return text
    return "\n".join([l[margin:] if l.strip() != "" else l.strip() for l in lines])

def indent(text, prefix, predicate=None):
    out = []
    for l in text.split("\n"):
        if (predicate is None and l.strip() != "") or (predicate is not None and predicate(l)):
            out.append(prefix + l)
        else:
            out.append(l)
    return "\n".join(out)

def shorten(text, width, placeholder=" [...]"):
    t = " ".join(text.split())
    if len(t) <= width:
        return t
    words = t.split()
    out = ""
    for w in words:
        cand = w if out == "" else out + " " + w
        if len(cand) + len(placeholder) > width:
            break
        out = cand
    return out + placeholder
