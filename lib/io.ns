class StringIO:
    def __init__(self, initial_value=""):
        self._buf = initial_value
        self._pos = 0
        self.closed = False
    def write(self, s):
        self._buf = self._buf + s
        return len(s)
    def read(self, n=None):
        rest = self._buf[self._pos:]
        if n is not None:
            rest = rest[:n]
        self._pos = self._pos + len(rest)
        return rest
    def readline(self):
        rest = self._buf[self._pos:]
        i = rest.find("\n")
        line = rest if i < 0 else rest[:i + 1]
        self._pos = self._pos + len(line)
        return line
    def readlines(self):
        out = []
        while True:
            l = self.readline()
            if l == "":
                break
            out.append(l)
        return out
    def getvalue(self):
        return self._buf
    def seek(self, pos, whence=0):
        self._pos = pos
        return pos
    def tell(self):
        return self._pos
    def truncate(self, size=None):
        self._buf = self._buf[:size if size is not None else self._pos]
    def close(self):
        self.closed = True
    def flush(self):
        pass
    def __iter__(self):
        return iter(self.readlines())
    def __enter__(self):
        return self
    def __exit__(self, a, b, c):
        self.closed = True
        return False

BytesIO = StringIO
TextIOWrapper = StringIO
