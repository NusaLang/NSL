# try/catch and throw. Caught runtime errors carry the message in `pesan`.
func safeDivide(a, b):
    try:
        return a / b
    catch e:
        return "error: " + e.pesan

print(safeDivide(7, 2))
print(safeDivide(1, 0))

try:
    throw {"pesan": "stok habis", "kode": 404}
catch e:
    print(e.pesan, e["kode"])

try:
    items = [1, 2]
    print(items[5])
catch e:
    print("caught an index error:", len(e.pesan) > 0)
