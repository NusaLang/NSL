nama = "Nusantara"

func sapa(siapa):
    cetak("Halo,", siapa)

sapa(nama)

func faktorial(n):
    if n <= 1:
        return 1
    return n * faktorial(n - 1)

cetak(faktorial(5))

i = 0
while i < 5:
    cetak(i)
    i = i + 1

func buat_penambah(x):
    func tambah(y):
        return x + y
    return tambah

tambah10 = buat_penambah(10)
cetak(tambah10(7))

cetak(2 < 3 and 3 < 4)
cetak(1 == 1.0)
cetak(salah or benar)
cetak(kosong)
