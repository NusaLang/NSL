# Whole numbers never lose digits, and int and float stay apart, as in Python.
big = 9223372036854775807
print(big + 1)
print(big * big)

fact = 1
for i in range(1, 26):
    fact = fact * i
print(fact)

a = 0
b = 1
for i in range(100):
    a, b = b, a + b
print(a)

print(7 // 2, -7 // 2, 7 % -3, 10 / 4, 6 / 3)
print(1 / 3, 0.1 + 0.2, 1e16, 1e22, 1e-5)
print(9007199254740993 == 9007199254740992.0)
print(int(3.99), int(-3.99), float(1 << 62))
