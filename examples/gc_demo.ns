// Buktiin garbage collector: instance yang dibikin di dalam loop nggak
// numpuk di memori walau loop-nya jalan ribuan kali. Bandingin
// `total_alokasi` (naik terus, satu per instance) sama `hidup` (harusnya
// tetep kecil & datar, bukan ikut naik). VM nggak punya Environment sama
// sekali, jadi demo ini dipaksa jalan di tree-walker lewat pragma di bawah.
// nusa:tree-walker

cetak("sebelum loop:", gc_info());

kelas PenghitungSesaat {
    fungsi konstruktor(x) {
        ini.x = x;
    }
    fungsi kuadrat() {
        hasil ini.x * ini.x;
    }
}

buat i = 0;
selama i < 20000 {
    buat p = PenghitungSesaat(i);
    p.kuadrat();
    i = i + 1;
}

cetak("sesudah loop:", gc_info());
gc_paksa();
cetak("(statement ini yang bikin collect di atas beneran kepakai)");
cetak("sesudah gc_paksa:", gc_info());
