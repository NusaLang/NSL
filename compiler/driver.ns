builtinsSys = impor("sys")

func loadCore(path):
    candidates = [
        path,
        "parser/" + path,
        "../core/" + path,
        "core/" + path,
        path.split("/")[-1]
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor(path)

Lexer = loadCore("parser/lexer.ns").Lexer
Parser = loadCore("parser/parser.ns").Parser
resolverModule = loadCore("resolver.ns")
resolveModulePath = resolverModule.resolveModulePath

JalankanPerintah = jalankan_perintah
FileAda = file_ada
BacaFile = baca_file
TulisFile = tulis_file

func detectTarget():
    unameM = JalankanPerintah("uname", ["-m"])
    arch = unameM.keluaran
    if len(arch) > 0 and arch[len(arch) - 1] == "\n":
        arch = arch[:len(arch) - 1]
    if arch == "":
        arch = "x86_64"

    unameS = JalankanPerintah("uname", ["-s"])
    osName = unameS.keluaran
    if len(osName) > 0 and osName[len(osName) - 1] == "\n":
        osName = osName[:len(osName) - 1]
    if osName == "":
        osName = "Linux"

    if arch == "aarch64" or arch == "arm64":
        targetArch = "arm64"
    else:
        targetArch = "x86_64"
    return {"arch": targetArch, "os": osName}

func loadSubmodule(path):
    candidates = [
        path,
        "../" + path,
        "../compiler/" + path,
        "compiler/" + path,
        "experiment/" + path,
        path.split("/")[-1]
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor(path)

assemblerModule = loadSubmodule("compiler/assembler/assembler.ns")
assembleToFile = assemblerModule.assembleToFile

func getBackendCompiler(targetArch):
    if targetArch == "arm64":
        arm64Mod = loadSubmodule("compiler/backend/arm64/compiler.ns")
        return arm64Mod.Arm64Compiler
    else:
        x86Mod = loadSubmodule("compiler/backend/x86_64/compiler.ns")
        return x86Mod.X86_64Compiler

func getCwd():
    res = JalankanPerintah("pwd", [])
    out = res.keluaran
    if len(out) > 0 and out[len(out) - 1] == "\n":
        out = out[:len(out) - 1]
    return out

func buildGoBridge():
    try:
        goBridgeAddon = impor(getCwd() + "/nusa_packages/nusa-gobridge/nusaGoBridge.ns")
        return goBridgeAddon.buildGoBridge()
    except e:
        print("native: Go bridge belum terpasang -- jalankan: nusa get https://github.com/NusaLang/nusa-gobridge")
        builtinsSys.exit(1)

class DriverCompiler:
    func __init__(self, targetArch = None):
        if targetArch == None:
            self.target = detectTarget()
        else:
            self.target = {"arch": targetArch, "os": "Linux"}
        CompilerCls = getBackendCompiler(self.target["arch"])
        self.backend = CompilerCls()
        self.usesGoBridge = False

    func compile(self, tree, sourceDir = None):
        asm = self.backend.compile(tree, sourceDir)
        self.usesGoBridge = self.backend.usesGoBridge
        return asm

NativeCompiler = DriverCompiler

func compile(tree, targetArch = None, sourceDir = None):
    compiler = DriverCompiler(targetArch)
    return compiler.compile(tree, sourceDir)

toolchainOptions = {"external": False}

func absolutePath(p):
    if p.startswith("/"):
        return p
    return getCwd() + "/" + p

func writeDeps(path, inputFile, backend):
    lines = [absolutePath(inputFile)]
    for name in backend.importOrder:
        resolved = backend.resolvedOf[name] if name in backend.resolvedOf else None
        if resolved != None:
            lines.append(absolutePath(resolved))
    TulisFile(path, "\n".join(lines) + "\n")

func isTermux():
    return FileAda("/data/data/com.termux/files/usr/bin") or FileAda("/data/data/com.termux")

func runToolChain(candidates, stepName, inputFile):
    lastError = ""
    hadRealError = False
    for cand in candidates:
        res = JalankanPerintah(cand[0], cand[1])
        if res.status == 0:
            return True
        errText = res.error if len(res.error) > 0 else res.keluaran
        if len(errText) > 0:
            lastError = errText
            hadRealError = True

    print(stepName + " gagal:")
    if hadRealError:
        print(lastError)
    else:
        print("tidak ada toolchain (" + stepName + ") yang terpasang di sistem.")

    if isTermux():
        print("\nDi Android/Termux, pasang compiler native dengan:")
        print("    pkg install clang   (atau: pkg install binutils)")
        print("\nAtau gunakan mode script portabel:")
        print("    nusa build " + inputFile + " --script")
    else:
        print("\nPasang assembler dan linker di sistem:")
        print("    sudo apt-get install clang   (atau: binutils gcc)")
    builtinsSys.exit(1)

func build(inputFile, outputFile, keepAsm = False, targetArch = None):
    if not FileAda(inputFile):
        print("native: file '" + inputFile + "' not found")
        builtinsSys.exit(1)

    sourceDir = "."
    lastSlash = -1
    si = len(inputFile) - 1
    while si >= 0:
        if inputFile[si] == "/":
            lastSlash = si
            break
        si -= 1
    if lastSlash != -1:
        sourceDir = inputFile[:lastSlash]

    src = BacaFile(inputFile)
    parser = Parser(Lexer(src).tokenize())
    tree = parser.parse()
    if parser.errorCount > 0:
        print("native: syntax errors in " + inputFile)
        builtinsSys.exit(1)
    compiler = DriverCompiler(targetArch)
    try:
        asm = compiler.compile(tree, sourceDir)
    except e:
        print(e)
        builtinsSys.exit(1)

    depsPath = ambil_env("NUSA_DEPS")
    if depsPath != None and depsPath != "":
        writeDeps(depsPath, inputFile, compiler.backend)

    asmPath = outputFile + ".s"
    objPath = outputFile + ".o"
    TulisFile(asmPath, asm)

    target = compiler.target
    arch = target["arch"]
    osName = target["os"]

    hostArch = detectTarget()["arch"]
    isNativeHost = arch == hostArch

    if not toolchainOptions["external"] and not compiler.usesGoBridge:
        assembled = False
        try:
            assembleToFile(asm, arch, outputFile)
            assembled = True
        except e:
            print("assembler internal gagal, memakai toolchain sistem: " + str(e))
        if assembled:
            if not keepAsm:
                JalankanPerintah("rm", ["-f", asmPath])
            return None

    if arch == "x86_64":
        asmCandidates = [
            ["as", ["-o", objPath, asmPath]],
            ["clang", ["-c", asmPath, "-o", objPath]],
            ["gcc", ["-c", asmPath, "-o", objPath]],
            ["cc", ["-c", asmPath, "-o", objPath]]
        ]
        if compiler.usesGoBridge:
            bridgeA = buildGoBridge()
            linkCandidates = [["cc", ["-o", outputFile, objPath, bridgeA, "-lpthread", "-no-pie"]]]
        else:
            linkCandidates = [
                ["ld", ["-o", outputFile, objPath]],
                ["clang", ["-nostdlib", "-static", "-o", outputFile, objPath]],
                ["gcc", ["-nostdlib", "-static", "-o", outputFile, objPath]]
            ]
    elif isNativeHost:
        asmCandidates = [
            ["as", ["-o", objPath, asmPath]],
            ["clang", ["-c", asmPath, "-o", objPath]],
            ["gcc", ["-c", asmPath, "-o", objPath]],
            ["cc", ["-c", asmPath, "-o", objPath]]
        ]
        linkCandidates = [
            ["ld.lld", ["-o", outputFile, objPath]],
            ["ld", ["-o", outputFile, objPath]],
            ["clang", ["-nostdlib", "-static", "-fuse-ld=lld", "-o", outputFile, objPath]],
            ["clang", ["-nostdlib", "-static", "-o", outputFile, objPath]],
            ["gcc", ["-nostdlib", "-static", "-o", outputFile, objPath]],
            ["cc", ["-nostdlib", "-static", "-o", outputFile, objPath]]
        ]
    else:
        asmCandidates = [
            ["clang", ["--target=aarch64-linux-gnu", "-c", asmPath, "-o", objPath]],
            ["aarch64-linux-gnu-as", ["-o", objPath, asmPath]],
            ["aarch64-linux-gnu-gcc", ["-c", asmPath, "-o", objPath]]
        ]
        linkCandidates = [
            ["clang", ["--target=aarch64-linux-gnu", "-nostdlib", "-static", "-fuse-ld=lld", "-o", outputFile, objPath]],
            ["ld.lld", ["-m", "aarch64linux", "-o", outputFile, objPath]],
            ["aarch64-linux-gnu-ld", ["-o", outputFile, objPath]]
        ]

    runToolChain(asmCandidates, "assembler", inputFile)
    runToolChain(linkCandidates, "linker", inputFile)

    JalankanPerintah("rm", ["-f", objPath])
    if not keepAsm:
        JalankanPerintah("rm", ["-f", asmPath])

func main():
    args = builtinsSys.argv
    if len(args) < 2:
        print("usage: nusa compiler/driver.ns <file.ns> [-o output] [-S] [--external] [--target x86_64|arm64]")
        builtinsSys.exit(1)
    inputFile = args[1]
    outputFile = "a.out"
    keepAsm = False
    targetArch = None
    i = 2
    while i < len(args):
        if (args[i] == "-o" or args[i] == "--output") and i + 1 < len(args):
            outputFile = args[i + 1]
            i += 2
        elif args[i] == "-S" or args[i] == "-s" or args[i] == "--keep-asm":
            keepAsm = True
            i += 1
        elif args[i] == "--external":
            toolchainOptions["external"] = True
            i += 1
        elif args[i] == "--target" and i + 1 < len(args):
            targetArch = args[i + 1]
            i += 2
        else:
            i += 1
    build(inputFile, outputFile, keepAsm, targetArch)

if len(builtinsSys.argv) > 0:
    firstArg = builtinsSys.argv[0]
    if "driver.ns" in firstArg or (len(builtinsSys.argv) > 1 and "driver.ns" in builtinsSys.argv[1]):
        main()
