# Exact comparison of ints, big ints and floats.
# The text below is Nusantara source that is compiled into every program that needs it.

TEXT = """# -1, 0, 1, or 2 when a float is nan
func nsRtCmpIntFloat(i, x):
    p = floatParts(x)
    if p[3] == 2:
        return 2
    if p[3] == 1:
        if p[0] == 1:
            return 1
        return -1
    pi = nsRtParts(i)
    fm = nsRtFmod(x, 1.0)
    fl = x - fm
    pf = nsRtParts(nsRtIntFromFloat(fl))
    c = nsRtBigCmp(pi[0], pi[1], pf[0], pf[1])
    if c != 0:
        return c
    if fm != 0.0:
        return -1
    return 0

func nsRtNumCmp(a, b):
    ka = nsKind(a)
    kb = nsKind(b)
    if ka == 1 and kb == 1:
        if a < b:
            return -1
        if a > b:
            return 1
        if a == b:
            return 0
        return 2
    if ka == 1:
        c = nsRtCmpIntFloat(b, a)
        if c == 2:
            return 2
        return 0 - c
    if kb == 1:
        return nsRtCmpIntFloat(a, b)
    pa = nsRtParts(a)
    pb = nsRtParts(b)
    return nsRtBigCmp(pa[0], pa[1], pb[0], pb[1])
"""
