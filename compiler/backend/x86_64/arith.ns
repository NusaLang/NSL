rtSdExpPlus:
    cmp edx, 43
    jne rtSdExpLoop
    inc rsi
    dec rcx
rtSdExpLoop:
    test rcx, rcx
    jz rtSdExpDone
    movzx edx, byte ptr [rsi]
    sub edx, 48
    cmp edx, 9
    ja rtSdExpDone
    imul rdi, rdi, 10
    add rdi, rdx
    inc rsi
    dec rcx
    jmp rtSdExpLoop
rtSdExpDone:
    test r11, r11
    jz rtSdExpApply
    neg rdi
rtSdExpApply:
    sub rdi, r9
    mov r9, rdi
    jmp rtSdScale
rtSdEnd:
    test r11, r11
    jz rtSdBad
    neg r9
rtSdScale:
    cvtsi2sd xmm0, rax
    test r9, r9
    jz rtSdSign2
    mov rcx, r9
    sar rcx, 63
    mov rdx, r9
    xor rdx, rcx
    sub rdx, rcx
    cmp rdx, 400
    jbe rtSdPowInit
    mov rdx, 400
rtSdPowInit:
    mov rax, 1
    cvtsi2sd xmm1, rax
    mov rax, 10
    cvtsi2sd xmm2, rax
rtSdPow:
    test rdx, rdx
    jz rtSdPowDone
    mulsd xmm1, xmm2
    dec rdx
    jmp rtSdPow
rtSdPowDone:
    test r9, r9
    js rtSdDiv
    mulsd xmm0, xmm1
    jmp rtSdSign2
rtSdDiv:
    divsd xmm0, xmm1
rtSdSign2:
    test r8, r8
    jz rtSdRet
    mov rax, 0x8000000000000000
    movq xmm1, rax
    xorpd xmm0, xmm1
rtSdRet:
    ret
rtSdBad:
    lea rdi, [strBadNum]
    jmp rtFail
"""
