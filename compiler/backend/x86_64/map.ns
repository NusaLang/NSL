    xor r11, r11
rtMoCopy:
    cmp r11, r9
    jae rtMoDone
    mov rdx, [r8+r11*8]
    mov [rax+r11*8], rdx
    inc r11
    jmp rtMoCopy
rtMoDone:
    mov rax, [rdi+8]
    dec rax
rtMoStore:
    mov rdx, [rdi+32]
    mov [rdx+rax*8], rsi
    ret
rtMapGet:
    call rtMapFind
    cmp qword ptr [rax], 0
    je rtMgNone
    mov rax, [rax+8]
