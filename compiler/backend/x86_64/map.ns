    mov r13, rax
    pop rax
    mov rdi, [rax+8]
    call rtRepr
    mov rdi, r13
    mov rsi, rax
    call rtConcat
    mov r13, rax
    inc r14
    jmp rtMsLoop
rtMsEnd:
    mov rdi, r13
    lea rsi, [strRc]
    call rtConcat
    pop r15
    pop r14
    pop r13
    pop r12
    ret
rtMapNew:
    mov rdi, 176
    call rtAlloc
    mov qword ptr [rax], 4
    mov qword ptr [rax+16], 8
    lea rdx, [rax+48]
    mov [rax+24], rdx
