rtMsFind:
    mov rdi, r12
    mov rsi, r13
    call rtMapFind
    cmp qword ptr [rax], 0
    jne rtMsStore
    inc qword ptr [r12+8]
    mov [rax], r13
    push rax
    mov rdi, r12
    mov rsi, r13
    call rtMapOrderAdd
    pop rax
rtMsStore:
    mov [rax+8], r14
    mov rax, r14
