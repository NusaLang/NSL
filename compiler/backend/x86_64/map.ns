    and r14, rcx
rtMfLoop:
    mov rax, [r12+24]
    mov rdx, r14
    shl rdx, 4
    add rax, rdx
    mov rdi, [rax]
    test rdi, rdi
    jz rtMfDone
    cmp rdi, r13
    je rtMfDone
    test dil, 1
    jnz rtMfNext
    test r13b, 1
    jnz rtMfNext
    push rax
    mov rsi, r13
    call rtEq
    mov rdx, rax
    pop rax
    test rdx, rdx
    jnz rtMfDone
rtMfNext:
    inc r14
    mov rcx, [r12+16]
    dec rcx
    and r14, rcx
    jmp rtMfLoop
rtMfDone:
    pop r14
    pop r13
    pop r12
    ret
rtMapGrow:
    push r12
    push r13
    push r14
    push r15
    mov r12, rdi
    mov r13, [r12+24]
    mov r15, [r12+16]
    mov rdi, r15
    shl rdi, 5
    call rtAlloc
    mov [r12+24], rax
    shl qword ptr [r12+16], 1
    xor r14, r14
rtMgLoop:
    cmp r14, r15
    jae rtMgDone
    mov rax, r14
    shl rax, 4
    add rax, r13
    mov rsi, [rax]
    test rsi, rsi
    jz rtMgNext
    push rsi
    push qword ptr [rax+8]
    mov rdi, r12
    call rtMapFind
    pop rdx
    pop rsi
    mov [rax], rsi
    mov [rax+8], rdx
rtMgNext:
    inc r14
    jmp rtMgLoop
rtMgDone:
    pop r15
    pop r14
    pop r13
    pop r12
