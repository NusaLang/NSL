MAP_RUNTIME = """rtMapStr:
    cmp rsp, [stackLimit]
    jb rtStackOverflow
    push r12
    push r13
    push r14
    push r15
    mov r12, rdi
    lea r13, [strLc]
    xor r14, r14
    xor r15, r15
rtMsLoop:
    cmp r14, [r12+8]
    jae rtMsEnd
    mov rax, [r12+32]
    mov rsi, [rax+r14*8]
    mov rdi, r12
    call rtMapFind
    push rax
    test r15, r15
    jz rtMsNoSep
    mov rdi, r13
    lea rsi, [strComma]
    call rtConcat
    mov r13, rax
rtMsNoSep:
    mov r15, 1
    mov rax, [rsp]
    mov rdi, [rax]
    call rtToStr
    mov rdi, r13
    mov rsi, rax
    call rtConcat
    mov rdi, rax
    lea rsi, [strColon]
