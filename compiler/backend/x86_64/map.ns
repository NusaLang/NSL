    lea rsi, [rdi+16]
    mov rax, 0xcbf29ce484222325
    mov rdx, 0x100000001b3
rtHLoop:
    test rcx, rcx
    jz rtHDone
    movzx r8, byte ptr [rsi]
    xor rax, r8
    imul rax, rdx
    inc rsi
    dec rcx
    jmp rtHLoop
rtHDone:
    ret
rtHashAddr:
    mov rax, rdi
    shr rax, 3
    ret
rtHashSmall:
    lea rax, [rdi+1000003]
