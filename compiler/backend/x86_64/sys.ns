SYS_RUNTIME = """rtFail:
    cmp qword ptr [excTop], 0
    jne rtThrow
    push rdi
    lea rdi, [strErr]
    mov rsi, 2
    call rtWriteFd
    pop rdi
    mov rsi, 2
    call rtWriteFd
    lea rdi, [strNl]
    mov rsi, 2
    call rtWriteFd
    mov rax, 231
    mov rdi, 1
    syscall
rtThrow:
    mov r11, [excTop]
    test r11, r11
    jz rtUncaught
    mov rax, [r11]
    mov [excTop], rax
    mov rbp, [r11+8]
    mov rsp, [r11+16]
    mov r10, [r11+24]
    add rsp, 32
    mov rax, rdi
    jmp r10
rtUncaught:
    push rdi
    lea rdi, [strUncaught]
    mov rsi, 2
    call rtWriteFd
    pop rdi
    call rtToStr
    mov rdi, rax
    mov rsi, 2
    call rtWriteFd
    lea rdi, [strNl]
    mov rsi, 2
    call rtWriteFd
    mov rax, 231
    mov rdi, 1
    syscall
rtWriteFd:
    mov rdx, [rdi+8]
    lea rax, [rdi+16]
    mov rdi, rsi
    mov rsi, rax
    mov rax, 1
    syscall
    ret
rtWriteStr:
    mov rsi, 1
    jmp rtWriteFd

rtCStrToStr:
    push rdi
    call rtCStrLen
    pop rsi
    push rsi
    push rax
    mov rdi, rax
    call rtStrNew
    pop rcx
    pop rsi
    lea rdi, [rax+16]
    rep movsb
    ret
rtSysExit:
    sar rdi, 1
    mov rax, 231
    syscall
    ret
rtSysInit:
    call rtArrNew
    mov [gvsys_argv], rax
    push r12
    push r13
    push r14
    mov r12, rax
    mov r13, [gArgc]
    xor r14, r14
rtSysInitLoop:
    cmp r14, r13
    jge rtSysInitDone
    mov rax, [gArgv]
    mov rdi, [rax+r14*8]
    call rtCStrToStr
    mov rdi, r12
    mov rsi, rax
    call rtArrPush
    inc r14
    jmp rtSysInitLoop
rtSysInitDone:
    pop r14
    pop r13
    pop r12
    call rtMapNew
    mov [gvsys], rax
    mov rdi, rax
    lea rsi, [strArgvKey]
    mov rdx, [gvsys_argv]
    call rtMapSet
    mov rdi, [gvsys]
    lea rsi, [strExitKey]
    lea rdx, [rtSysExit]
    lea rdx, [rdx*2+1]
    call rtMapSet
    ret
"""
