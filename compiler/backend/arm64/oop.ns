    ldr x2, [x0]
    cmp x2, 5
    b.ne rtMapGet
    stp lr, x19, [sp, -16]!
    mov x19, x0
    ldr x2, [x0, 8]
    ldr x0, [x2, 16]
    bl rtMapGet
    cbz x0, rtFgMiss
    asr x0, x0, 1
    ldr x0, [x19, x0]
    ldp lr, x19, [sp], 16
    ret
rtFgMiss:
    mov x0, 0
    ldp lr, x19, [sp], 16
    ret
rtFieldSet:
    tbnz x0, 0, rtMapSet
    cmp x0, 4
    b.ls rtMapSet
    ldr x3, [x0]
    cmp x3, 5
    b.ne rtMapSet
    stp lr, x19, [sp, -16]!
    stp x20, xzr, [sp, -16]!
    mov x19, x0
    mov x20, x2
    ldr x3, [x0, 8]
    ldr x0, [x3, 16]
