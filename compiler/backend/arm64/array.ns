ARRAY_RUNTIME = """rtArrNew:
    stp lr, xzr, [sp, -16]!
    mov x0, 32
    bl rtAlloc
    mov x1, 3
    str x1, [x0]
    ldp lr, xzr, [sp], 16
    ret
rtArrPush:
    tbnz x0, 0, rtApNotList
    cmp x0, 4
    b.ls rtApNotList
    ldr x9, [x0]
    cmp x9, 3
    b.ne rtApNotList
    ldr x2, [x0, 8]
    ldr x3, [x0, 16]
    cmp x2, x3
    b.lo rtApStore
    stp lr, x19, [sp, -16]!
    stp x20, xzr, [sp, -16]!
    mov x19, x0
    mov x20, x1
    lsl x3, x3, 1
    cmp x3, 4
    b.hs rtApCap
    mov x3, 4
rtApCap:
    str x3, [x19, 16]
    lsl x0, x3, 3
    bl rtAlloc
    ldr x4, [x19, 24]
    ldr x5, [x19, 8]
    str x0, [x19, 24]
    mov x6, 0
rtApCopy:
    cmp x6, x5
    b.ge rtApCopyDone
    ldr x7, [x4, x6, lsl 3]
    str x7, [x0, x6, lsl 3]
    add x6, x6, 1
    b rtApCopy
rtApCopyDone:
    mov x0, x19
    mov x1, x20
    ldp x20, xzr, [sp], 16
    ldp lr, x19, [sp], 16
rtApStore:
    ldr x2, [x0, 8]
    ldr x3, [x0, 24]
    str x1, [x3, x2, lsl 3]
    add x2, x2, 1
    str x2, [x0, 8]
    lsl x0, x2, 1
    add x0, x0, 1
    ret
rtApNotList:
    ldr x0, =strNeedList
    b rtFail
rtArrPop:
    tbnz x0, 0, rtApNotList
    cmp x0, 4
    b.ls rtApNotList
    ldr x9, [x0]
    cmp x9, 3
    b.ne rtApNotList
    ldr x1, [x0, 8]
    cbz x1, rtApEmpty
    sub x1, x1, 1
    str x1, [x0, 8]
    ldr x2, [x0, 24]
    ldr x0, [x2, x1, lsl 3]
    ret
rtApEmpty:
    ldr x0, =strPopEmpty
    b rtFail
"""
