    ldp lr, xzr, [sp], 16
    ret
rtStrToDouble:
    ldr x1, [x0, 8]
    add x2, x0, 16
    mov x3, 0
    mov x4, 0
    mov x5, 0
    mov x6, 0
    mov x13, 0
rtSdSkip:
    cbz x1, rtSdEnd
    ldrb w7, [x2]
    cmp w7, 32
    b.ne rtSdSign
    add x2, x2, 1
    sub x1, x1, 1
    b rtSdSkip
rtSdSign:
    cmp w7, 45
    b.ne rtSdPlus
    mov x4, 1
    add x2, x2, 1
    sub x1, x1, 1
    b rtSdLoop
rtSdPlus:
    cmp w7, 43
    b.ne rtSdLoop
    add x2, x2, 1
    sub x1, x1, 1
rtSdLoop:
    cbz x1, rtSdEnd
    ldrb w7, [x2]
    cmp w7, 46
    b.ne rtSdDigit
    cbnz x6, rtSdEnd
    mov x6, 1
    b rtSdNext
rtSdDigit:
    sub w8, w7, 48
    cmp w8, 9
    b.hi rtSdExpCheck
    mov x13, 1
    ldr x9, =100000000000000000
    cmp x3, x9
    b.hs rtSdBig
    mov x10, 10
    mul x3, x3, x10
    add x3, x3, x8
    cbz x6, rtSdNext
    add x5, x5, 1
    b rtSdNext
rtSdBig:
    cbnz x6, rtSdNext
    sub x5, x5, 1
rtSdNext:
    add x2, x2, 1
    sub x1, x1, 1
    b rtSdLoop
rtSdExpCheck:
    cmp w7, 101
    b.eq rtSdExp
    cmp w7, 69
    b.ne rtSdEnd
rtSdExp:
    cbz x13, rtSdBad
    add x2, x2, 1
    sub x1, x1, 1
    mov x11, 0
    mov x12, 0
    cbz x1, rtSdExpDone
    ldrb w7, [x2]
    cmp w7, 45
    b.ne rtSdExpPlus
    mov x12, 1
    add x2, x2, 1
    sub x1, x1, 1
    b rtSdExpLoop
rtSdExpPlus:
    cmp w7, 43
    b.ne rtSdExpLoop
    add x2, x2, 1
    sub x1, x1, 1
rtSdExpLoop:
    cbz x1, rtSdExpDone
    ldrb w7, [x2]
    sub w8, w7, 48
    cmp w8, 9
    b.hi rtSdExpDone
    mov x10, 10
    mul x11, x11, x10
    add x11, x11, x8
    add x2, x2, 1
    sub x1, x1, 1
    b rtSdExpLoop
rtSdExpDone:
    cbz x12, rtSdExpApply
    neg x11, x11
rtSdExpApply:
    sub x5, x11, x5
    b rtSdScale
rtSdEnd:
    cbz x13, rtSdBad
    neg x5, x5
rtSdScale:
    scvtf d0, x3
    cmp x5, 0
    b.eq rtSdSign2
    cneg x9, x5, lt
    mov x10, 400
    cmp x9, x10
    csel x9, x9, x10, lo
    fmov d1, 1.0
    fmov d2, 10.0
rtSdPow:
    cbz x9, rtSdPowDone
    fmul d1, d1, d2
    sub x9, x9, 1
    b rtSdPow
rtSdPowDone:
    cmp x5, 0
    b.lt rtSdDiv
    fmul d0, d0, d1
    b rtSdSign2
rtSdDiv:
    fdiv d0, d0, d1
rtSdSign2:
    cbz x4, rtSdRet
    fneg d0, d0
rtSdRet:
    ret
rtSdBad:
    ldr x0, =strBadNum
    b rtFail
"""
