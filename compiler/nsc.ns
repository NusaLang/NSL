import sys

func loadModule(name):
    try:
        return impor(name)
    except e:
        return impor("core/" + name)

Lexer = loadModule("lexer").Lexer
Parser = loadModule("parser").Parser
JalankanPerintah = jalankan_perintah

func compile(inputFile, outputFile):
    if not file_ada(inputFile):
        print("error: file '" + inputFile + "' not found")
        sys.exit(1)

    try:
        source = baca_file(inputFile)
        lex = Lexer(source)
        tokens = lex.tokenize()
        parser = Parser(tokens)
        parser.parse()

        cleanSource = source
        if cleanSource.startswith("#!"):
            nl = cleanSource.find("\n")
            if nl != -1:
                cleanSource = cleanSource[nl + 1:]

        bundle = "#!/usr/bin/env nusa\n" + cleanSource
        tulis_file(outputFile, bundle)
        JalankanPerintah("chmod", ["+x", outputFile])
    except e:
        print("compile error: " + str(e))
        sys.exit(1)

func compileNative(inputFile, outputFile):
    NativeCompiler = loadModule("compiler/native.ns").NativeCompiler
    tree = Parser(Lexer(baca_file(inputFile)).tokenize()).parse()
    asm = NativeCompiler().compile(tree)
    asmPath = outputFile + ".s"
    objPath = outputFile + ".o"
    tulis_file(asmPath, asm)
    JalankanPerintah("as", ["-o", objPath, asmPath])
    JalankanPerintah("ld", ["-o", outputFile, objPath])
    JalankanPerintah("rm", ["-f", objPath, asmPath])

func main():
    args = sys.argv
    if len(args) < 2:
        print("usage: nusa compiler/nsc.ns <file.ns> [-o output] [--native]")
        sys.exit(1)

    inputFile = args[1]
    outputFile = "a.out"
    isNative = False

    i = 2
    while i < len(args):
        if (args[i] == "-o" or args[i] == "--output") and i + 1 < len(args):
            outputFile = args[i + 1]
            i += 2
        elif args[i] == "-n" or args[i] == "--native":
            isNative = True
            i += 1
        else:
            i += 1

    if isNative:
        compileNative(inputFile, outputFile)
    else:
        compile(inputFile, outputFile)

if len(sys.argv) > 0:
    firstArg = sys.argv[0]
    if "nsc.ns" in firstArg or (len(sys.argv) > 1 and "nsc.ns" in sys.argv[1]):
        main()
