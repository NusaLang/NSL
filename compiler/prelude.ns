# The runtime written in Nusantara itself, compiled into each program.
# The parts live in compiler/prelude/; core/bigint.ns is added by the backends.

func load(name):
    candidates = [name, "prelude/" + name, "compiler/prelude/" + name, "../compiler/prelude/" + name]
    for candidate in candidates:
        try:
            return impor(candidate)
        except err:
            pass
    return impor("compiler/prelude/" + name)

floatformatPart = load("floatformat.ns")
collectionsPart = load("collections.ns")
floatmathPart = load("floatmath.ns")
convertPart = load("convert.ns")
comparePart = load("compare.ns")
bitsPart = load("bits.ns")
numopPart = load("numop.ns")

PRELUDE = floatformatPart.TEXT + "\n" + collectionsPart.TEXT + "\n" + floatmathPart.TEXT + "\n" + convertPart.TEXT + "\n" + comparePart.TEXT + "\n" + bitsPart.TEXT + "\n" + numopPart.TEXT
PRELUDEGLUE = ""
