func loadDriver():
    candidates = [
        "compiler/driver.ns",
        "../compiler/driver.ns",
        "driver.ns",
        "../driver.ns"
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor("compiler/driver.ns")

driverMod = loadDriver()

NativeCompiler = driverMod.NativeCompiler
DriverCompiler = driverMod.DriverCompiler
compile = driverMod.compile
build = driverMod.build
detectTarget = driverMod.detectTarget
buildGoBridge = driverMod.buildGoBridge

builtinsSys = impor("sys")

func main():
    args = builtinsSys.argv
    if len(args) < 2:
        print("usage: nusa compiler/native.ns <file.ns> [-o output] [-S] [--target x86_64|arm64]")
        builtinsSys.exit(1)
    inputFile = args[1]
    outputFile = "a.out"
    keepAsm = False
    targetArch = None
    i = 2
    while i < len(args):
        if (args[i] == "-o" or args[i] == "--output") and i + 1 < len(args):
            outputFile = args[i + 1]
            i += 2
        elif args[i] == "-S" or args[i] == "-s" or args[i] == "--keep-asm":
            keepAsm = True
            i += 1
        elif args[i] == "--target" and i + 1 < len(args):
            targetArch = args[i + 1]
            i += 2
        else:
            i += 1
    build(inputFile, outputFile, keepAsm, targetArch)

if len(builtinsSys.argv) > 0:
    firstArg = builtinsSys.argv[0]
    if "native.ns" in firstArg or (len(builtinsSys.argv) > 1 and "native.ns" in builtinsSys.argv[1]):
        main()
