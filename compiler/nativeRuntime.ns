func loadSubmodule(path):
    candidates = [
        path,
        "compiler/backend/x86_64/" + path,
        "backend/x86_64/" + path,
        "../" + path,
        "../compiler/backend/x86_64/" + path
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor(path.split("/")[-1])

runtimeModule = loadSubmodule("runtime.ns")
RUNTIME = runtimeModule.RUNTIME
DATA = runtimeModule.DATA
