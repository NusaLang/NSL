    if k in m:
        v = m[k]
        hapus m[k]
        return v
    if d != None:
        return d
    lempar "KeyError: " + str(k)

popPeta = popMap

func clearMap(m):
    kl = keys(m)
    for k in kl:
        hapus m[k]
    return m

clearPeta = clearMap

func copyMap(m):
    c = {}
    for k in m:
        c[k] = m[k]
    return c

copyPeta = copyMap

func hasKey(m, k):
    return k in m

