PI = 3.14159265358979323846
E = 2.71828182845904523536
TAU = 6.28318530717958647692

func abs(x):
    if x < 0:
        return -x
    return x

func floor(x):
    return x - (x % 1)

func ceil(x):
    rem = x % 1
    if rem == 0:
        return x
    return x - rem + 1

func trunc(x):
    if x >= 0:
        return floor(x)
    return ceil(x)

func round(x, d = 0):
    if d == 0:
        if x >= 0:
            return floor(x + 0.5)
        return ceil(x - 0.5)
    f = 10 ** d
    if x >= 0:
        return floor(x * f + 0.5) / f
    return ceil(x * f - 0.5) / f

func pow(b, p, mod = None):
    r = b ** p
    if mod != None:
        r = r % mod
        if r < 0:
            r += mod
    return r

func sqrt(x):
    if x < 0:
        raise "ValueError: domain error - sqrt() tidak menerima bilangan negatif"
    return x ** 0.5

func cbrt(x):
    if x < 0:
        return -((-x) ** (1.0 / 3.0))
    return x ** (1.0 / 3.0)

func hypot(a, b):
    return sqrt(a * a + b * b)

func fmod(x, y):
    if y == 0:
        raise "ZeroDivisionError: modulo oleh nol"
    return x % y

func copysign(x, y):
    ax = abs(x)
    if y < 0:
        return -ax
    return ax

func min(a, b = None):
    if b == None and type(a) == "larik":
        if len(a) == 0:
            raise "ValueError: min(): larik kosong"
        m = a[0]
        for x in a:
            if x < m:
                m = x
        return m
    if b == None:
        return a
    if a < b:
        return a
    return b

func max(a, b = None):
    if b == None and type(a) == "larik":
        if len(a) == 0:
            raise "ValueError: max(): larik kosong"
        m = a[0]
        for x in a:
            if x > m:
                m = x
        return m
    if b == None:
        return a
    if a > b:
        return a
    return b

func gcd(a, b):
    x = abs(a)
    y = abs(b)
    while y != 0:
        t = x % y
        x = y
        y = t
    return x

func lcm(a, b):
    if a == 0 or b == 0:
        return 0
    return abs(a * b) / gcd(a, b)

func factorial(n):
    if n < 0:
        raise "ValueError: factorial(): tidak menerima bilangan negatif"
    n_int = floor(n)
    r = 1
    i = 2
    while i <= n_int:
        r *= i
        i += 1
    return r

func isclose(a, b, rel_tol = 1e-9, abs_tol = 0.0):
    d = abs(a - b)
    tol = max(rel_tol * max(abs(a), abs(b)), abs_tol)
    return d <= tol

func radians(deg):
    return deg * PI / 180.0

deg2rad = radians

func degrees(rad):
    return rad * 180.0 / PI

rad2deg = degrees

func sin(x):
    x = x % TAU
    if x < 0:
        x += TAU
    if x > PI:
        x -= TAU
    term = x
    tot = x
    x2 = x * x
    i = 1
    while i <= 10:
        term = -term * x2 / ((2 * i) * (2 * i + 1))
        tot += term
        i += 1
    return tot

func cos(x):
    x = x % TAU
    if x < 0:
        x += TAU
    if x > PI:
        x -= TAU
    term = 1
    tot = 1
    x2 = x * x
    i = 1
    while i <= 10:
        term = -term * x2 / ((2 * i - 1) * (2 * i))
        tot += term
        i += 1
    return tot

func tan(x):
    c = cos(x)
    if c == 0:
        raise "ValueError: tan() tak terdefinisi"
    return sin(x) / c

func exp(x):
    term = 1
    tot = 1
    i = 1
    while i <= 25:
        term = term * x / i
        tot += term
        i += 1
    return tot

func ln(x):
    if x <= 0:
        raise "ValueError: domain error - log() hanya menerima bilangan positif"
    k = 0
    while x > 2:
        x /= E
        k += 1
    while x < 0.5:
        x *= E
        k -= 1
    y = (x - 1) / (x + 1)
    y2 = y * y
    term = y
    tot = 0
    i = 1
    while i <= 20:
        tot += term / (2 * i - 1)
        term *= y2
        i += 1
    return 2 * tot + k

func log(x, base = None):
    if base == None:
        return ln(x)
    return ln(x) / ln(base)

func log10(x):
    return log(x, 10)

func log2(x):
    return log(x, 2)

class NSStd:
    func __init__(self):
        pass
