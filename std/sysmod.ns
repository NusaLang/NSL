loadedModules = {}
loadPluginRaw = muat_plugin
readFileRaw = baca_file
writeFileRaw = tulis_file
runCommandRaw = JalankanPerintah
fileExistsRaw = file_ada
envRaw = ambil_env

func loadPlugin(pluginName):
    if pluginName in loadedModules:
        return loadedModules[pluginName]
    try:
        mod = loadPluginRaw(pluginName)
        loadedModules[pluginName] = mod
        return mod
    except e:
        lempar "system module '" + pluginName + "' not found: " + str(e)

load = loadPlugin
muat = loadPlugin
muatPlugin = loadPlugin

func callPlugin(pluginName, funcName, args = []):
    mod = loadPlugin(pluginName)
    if not (funcName in mod):
        lempar "system module '" + pluginName + "' does not have function '" + funcName + "'"
    fn = mod[funcName]
    return fn(args)

call = callPlugin
panggil = callPlugin
panggilPlugin = callPlugin

func isAbs(path):
    return len(path) > 0 and path[0] == "/"

isabs = isAbs
apakahMutlak = isAbs

func baseName(path):
    n = len(path)
    pos = -1
    i = n - 1
    while i >= 0:
        if path[i] == "/":
            pos = i
            break
        i -= 1
    if pos == -1:
        return path
    return path[pos + 1:]

basename = baseName
namaDasar = baseName

func dirName(path):
    n = len(path)
    pos = -1
    i = n - 1
    while i >= 0:
        if path[i] == "/":
            pos = i
            break
        i -= 1
    if pos == -1:
        return ""
    if pos == 0:
        return "/"
    return path[:pos]

dirname = dirName
namaDirektori = dirName

func splitExt(path):
    n = len(path)
    slash = -1
    dot = -1
    i = n - 1
    while i >= 0:
        if path[i] == "." and dot == -1:
            dot = i
        if path[i] == "/":
            slash = i
            break
        i -= 1
    if dot == -1 or (slash != -1 and dot < slash) or dot == 0 or (slash != -1 and dot == slash + 1):
        return [path, ""]
    return [path[:dot], path[dot:]]

splitext = splitExt
pisahEkstensi = splitExt

func joinPath(parts):
    resultPath = ""
    for part in parts:
        p = str(part)
        if isAbs(p):
            resultPath = p
        elif resultPath == "" or resultPath[len(resultPath) - 1] == "/":
            resultPath += p
        else:
            resultPath = resultPath + "/" + p
    return resultPath

joinpath = joinPath
gabungPath = joinPath

func normPath(path):
    if path == "":
        return "."
    absolute = isAbs(path)
    parts = []
    cur = ""
    n = len(path)
    i = 0
    while i < n:
        if path[i] == "/":
            if cur != "":
                parts.append(cur)
                cur = ""
        else:
            cur += path[i]
        i += 1
    if cur != "":
        parts.append(cur)

    stack = []
    for b in parts:
        if b == ".":
            pass
        elif b == "..":
            if len(stack) > 0 and stack[len(stack) - 1] != "..":
                stack.pop()
            elif not absolute:
                stack.append("..")
        else:
            stack.append(b)

    resultPath = ""
    m = len(stack)
    k = 0
    while k < m:
        if k > 0:
            resultPath += "/"
        resultPath += stack[k]
        k += 1

    if absolute:
        return "/" + resultPath
    if resultPath == "":
        return "."
    return resultPath

normpath = normPath
normalkanPath = normPath

func expandUser(path):
    if len(path) > 0 and path[0] == "~":
        home = envRaw("HOME")
        if home != "":
            return home + path[1:]
    return path

expanduser = expandUser
perluasUser = expandUser

func getEnv(key, defaultVal = None):
    val = envRaw(key)
    if val == "":
        return defaultVal
    return val

getenv = getEnv
ambilEnv = getEnv

func getCwd():
    res = runCommand("pwd", [])
    if res.status == 0:
        out = res.keluaran
        if len(out) > 0 and out[len(out) - 1] == "\n":
            out = out[:len(out) - 1]
        return out
    return "."

getcwd = getCwd
ambilCwd = getCwd

func absPath(path):
    if isAbs(path):
        return normPath(path)
    return normPath(getCwd() + "/" + path)

abspath = absPath
pathMutlak = absPath

func exists(path):
    return fileExistsRaw(path)

berkasAda = exists

func readFile(path):
    return readFileRaw(path)

readfile = readFile
