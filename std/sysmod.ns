func writeFile(path, content):
    writeFileRaw(path, content)

writefile = writeFile
tulisBerkas = writeFile

func appendFile(path, content):
    oldContent = ""
    if exists(path):
        oldContent = readFile(path)
    writeFile(path, oldContent + content)

appendfile = appendFile
tambahBerkas = appendFile

