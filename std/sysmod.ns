func listDir(dir = "."):
    res = runCommand("ls", ["-1", dir])
    if res.status != 0:
        lempar "OSError: cannot open directory '" + dir + "': " + res.error
    text = res.keluaran
    files = []
    cur = ""
    n = len(text)
    i = 0
    while i < n:
        if text[i] == "\n":
            if cur != "" and cur != "." and cur != "..":
                files.append(cur)
            cur = ""
        else:
            cur += text[i]
        i += 1
    if cur != "" and cur != "." and cur != "..":
        files.append(cur)
    return files

listdir = listDir
daftarDir = listDir

func isFile(path):
    res = runCommand("test", ["-f", path])
    return res.status == 0

isfile = isFile
