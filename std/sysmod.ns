func isDir(path):
    res = runCommand("test", ["-d", path])
    return res.status == 0

isdir = isDir
apakahDirektori = isDir

func getSize(path):
    res = runCommand("wc", ["-c", path])
    if res.status == 0:
        out = res.keluaran
        s = ""
        n = len(out)
        i = 0
        while i < n and (out[i] == " " or out[i] == "\t"):
            i += 1
        while i < n and out[i] in "0123456789":
            s += out[i]
            i += 1
        if s != "":
            return float(s)
    lempar "OSError: failed to get file size for '" + path + "'"

getsize = getSize
ukuranBerkas = getSize

func pid():
    res = runCommand("sh", ["-c", "echo $$"])
    if res.status == 0:
        out = res.keluaran
        s = ""
        n = len(out)
        i = 0
        while i < n and (out[i] == " " or out[i] == "\t"):
            i += 1
        while i < n and out[i] in "0123456789":
            s += out[i]
            i += 1
        if s != "":
            return float(s)
    return 0

getPid = pid

