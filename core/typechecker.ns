func normalizeType(raw):
    if raw == None or raw == "" or raw == "any" or raw == "apa":
        return ""
    alias = {
        "num": "number", "int": "number", "float": "number", "angka": "number", "number": "number",
        "str": "string", "string": "string", "teks": "string",
        "bool": "bool", "boolean": "bool",
        "array": "list", "list": "list", "larik": "list",
        "map": "map", "dict": "map", "peta": "map",
        "func": "func", "function": "func", "fungsi": "func",
        "class": "class", "objek": "class", "object": "class", "kelas": "class",
        "null": "null", "None": "null", "nil": "null", "kosong": "null"
    };
    if raw in alias:
        return alias[raw]
    return raw

class StaticType:
    func __init__(self, name):
        self.name = name
        self.nama = name
        self.isFunc = False
        self.paramTypes = []
        self.returnType = ""
        self.variadic = False
        self.requiredArgs = -1

    func equals(self, other):
        if other == None:
            return False
        if self.name == "" or other.name == "":
            return True
        return self.name == other.name

    func sama(self, other):
        return self.equals(other)

class TypeError:
    func __init__(self, msg, line, col):
        self.message = msg
        self.line = line
        self.col = col

    func toString(self):
        if self.line != None and self.line > 0:
            return self.message + " (line " + str(self.line) + ", col " + str(self.col) + ")"
        return self.message

    func teks(self):
        return self.toString()

class TypeChecker:
    func __init__(self):
        self.scopes = []
        self.returnTypeStack = []
        self.errors = []

    func canonicalizeType(self, raw):
        return normalizeType(raw)

    func pushScope(self):
        self.scopes.append({})

    func popScope(self):
        self.scopes.pop()

    func define(self, name, stype):
        if len(self.scopes) > 0:
            self.scopes[-1][name] = stype

    func lookup(self, name):
        i = len(self.scopes) - 1
        while i >= 0:
            if name in self.scopes[i]:
                return self.scopes[i][name]
            i -= 1
        return None

    func error(self, msg, node):
        line = None
        col = None
        if node != None:
            if hasattr(node, "line"):
                line = node.line
            elif hasattr(node, "baris"):
                line = node.baris
            if hasattr(node, "col"):
                col = node.col
            elif hasattr(node, "kolom"):
                col = node.kolom
            if hasattr(node, "span") and node.span != None:
                line = node.span.line if hasattr(node.span, "line") else node.span.baris
                col = node.span.column if hasattr(node.span, "column") else node.span.kolom
        err = TypeError(msg, line, col)
        self.errors.append(err.toString())

    func primitiveType(self, name):
        return name == "number" or name == "string" or name == "bool" or name == "angka" or name == "teks" or name == "boolean"

    func checkComparable(self, l, r, op, node):
        if l.name == "" or r.name == "":
            return None
        if not self.primitiveType(l.name) or not self.primitiveType(r.name):
            return None
        bothNum = (l.name == "number" or l.name == "angka") and (r.name == "number" or r.name == "angka")
        bothStr = (l.name == "string" or l.name == "teks") and (r.name == "string" or r.name == "teks")
        if not bothNum and not bothStr:
            self.error("operator '" + op + "' requires two numbers or two strings, got " + l.name + " and " + r.name, node)

    func nodeType(self, node):
        if node == None:
            return ""
        if hasattr(node, "type"):
            return node.type
        if hasattr(node, "jenis"):
            return node.jenis
        return ""

    func inferExpr(self, expr):
        if expr == None:
            return StaticType("")

        t = self.nodeType(expr)

        if t == "NUMBER" or t == "ANGKA":
            return StaticType("number")
        elif t == "STRING" or t == "TEKS":
            return StaticType("string")
        elif t == "BOOL":
            return StaticType("bool")
        elif t == "NULL" or t == "KOSONG":
            return StaticType("null")
        elif t == "IDENT" or t == "PENGENAL":
            name = expr.name if hasattr(expr, "name") else expr.nama
            st = self.lookup(name)
            if st != None:
                return st
            return StaticType("")
        elif t == "UNARY" or t == "UNER":
            operandType = self.inferExpr(expr.operand)
            if expr.op == "-":
                if operandType.name != "" and operandType.name != "number" and operandType.name != "angka":
                    self.error("unary operator '-' requires number, got " + operandType.name, expr)
                return StaticType("number")
            return StaticType("bool")
        elif t == "BINARY" or t == "BINER":
            leftExpr = expr.left if hasattr(expr, "left") else expr.kiri
            rightExpr = expr.right if hasattr(expr, "right") else expr.kanan
            l = self.inferExpr(leftExpr)
            r = self.inferExpr(rightExpr)
            op = expr.op

            if op == "and" or op == "or" or op == "dan" or op == "atau" or op == "&&" or op == "||" or op == "?" or op == ":":
                return StaticType("")
            if op == "==" or op == "!=":
                return StaticType("bool")
            if op == "<" or op == "<=" or op == ">" or op == ">=":
                self.checkComparable(l, r, op, expr)
                return StaticType("bool")
            if op == "+":
                if l.name == "" or r.name == "":
                    return StaticType("")
                if (l.name == "list" or l.name == "larik") and (r.name == "list" or r.name == "larik"):
                    return StaticType("list")
                if not self.primitiveType(l.name) or not self.primitiveType(r.name):
                    return StaticType("")
                bothNum = (l.name == "number" or l.name == "angka") and (r.name == "number" or r.name == "angka")
                bothStr = (l.name == "string" or l.name == "teks") and (r.name == "string" or r.name == "teks")
                if not bothNum and not bothStr:
                    self.error("operator '+' requires two numbers or two strings, got " + l.name + " and " + r.name, expr)
                    return StaticType("")
                return StaticType("number" if bothNum else "string")

            if op == "%" and (l.name == "string" or l.name == "teks"):
                return StaticType("string")
            if op == "-" and (l.name == "list" or l.name == "larik") and (r.name == "list" or r.name == "larik"):
                return StaticType("list")
            if op == "*":
                isLeftStr = (l.name == "string" or l.name == "teks")
                isRightStr = (r.name == "string" or r.name == "teks")
                isLeftNum = (l.name == "number" or l.name == "angka" or l.name == "")
                isRightNum = (r.name == "number" or r.name == "angka" or r.name == "")
                if (isLeftStr and isRightNum) or (isRightStr and isLeftNum):
                    return StaticType("string")
                if l.name == "list" or l.name == "larik" or r.name == "list" or r.name == "larik":
                    return StaticType("list")

            if l.name == "" or r.name == "":
                return StaticType("")

            if l.name != "" and l.name != "number" and l.name != "angka":
                self.error("operator '" + op + "' requires number, got " + l.name + " on left side", expr)
            if r.name != "" and r.name != "number" and r.name != "angka":
                self.error("operator '" + op + "' requires number, got " + r.name + " on right side", expr)
            return StaticType("number")

        elif t == "LIST" or t == "LARIK":
            elements = expr.elements if hasattr(expr, "elements") else expr.elemen
            for el in elements:
                self.inferExpr(el)
            return StaticType("list")

        elif t == "MAP" or t == "PETA":
            keys = expr.keys if hasattr(expr, "keys") else expr.kunci
            values = expr.values if hasattr(expr, "values") else expr.nilai
            m = len(keys)
            i = 0
            while i < m:
                self.inferExpr(values[i])
                i += 1
            return StaticType("map")

        elif t == "CALL" or t == "PANGGIL":
            calleeType = self.nodeType(expr.callee)
            if calleeType == "IDENT" or calleeType == "PENGENAL":
                fnName = expr.callee.name if hasattr(expr.callee, "name") else expr.callee.nama
                fnType = self.lookup(fnName)
                if fnType != None and fnType.isFunc:
                    minArgs = fnType.requiredArgs if fnType.requiredArgs >= 0 else len(fnType.paramTypes)
                    nArgs = len(expr.args)
                    maxArgs = len(fnType.paramTypes)

                    if nArgs < minArgs or (not fnType.variadic and nArgs > maxArgs):
                        self.error("function '" + fnName + "' requires " + str(minArgs) + " arguments, called with " + str(nArgs), expr)

                    i = 0
                    while i < nArgs:
                        argType = self.inferExpr(expr.args[i])
                        if i < maxArgs:
                            want = fnType.paramTypes[i]
                            canonWant = self.canonicalizeType(want)
                            canonArg = self.canonicalizeType(argType.name)
                            if canonWant != "" and canonArg != "" and canonWant != canonArg:
                                self.error("function '" + fnName + "' argument " + str(i + 1) + " expected type " + want + ", got " + argType.name, expr.args[i])
                        i += 1
                    return StaticType(fnType.returnType)

            self.inferExpr(expr.callee)
            for a in expr.args:
                self.inferExpr(a)
            return StaticType("")

        elif t == "INDEX":
            self.inferExpr(expr.target)
            self.inferExpr(expr.index)
            return StaticType("")

        elif t == "SLICE" or t == "IRISAN":
            self.inferExpr(expr.target)
            startExpr = expr.start if hasattr(expr, "start") else expr.awal
            stopExpr = expr.stop if hasattr(expr, "stop") else expr.sampai
            if startExpr != None:
                self.inferExpr(startExpr)
            if stopExpr != None:
                self.inferExpr(stopExpr)
            return StaticType("")

        elif t == "MEMBER":
            self.inferExpr(expr.target)
            return StaticType("")

        elif t == "TERNARY" or t == "TERNER":
            condExpr = expr.condition if hasattr(expr, "condition") else expr.kondisi
            self.inferExpr(condExpr)
            thenVal = expr.thenVal if hasattr(expr, "thenVal") else expr.nilaiJika
            elseVal = expr.elseVal if hasattr(expr, "elseVal") else expr.nilaiLain
            thenType = self.inferExpr(thenVal)
            elseType = self.inferExpr(elseVal)
            if thenType.name != "" and thenType.name == elseType.name:
                return thenType
            return StaticType("")

        elif t == "LAMBDA":
            return StaticType("func")

        elif t == "ASSIGN" or t == "TUGAS":
            valExpr = expr.value if hasattr(expr, "value") else expr.nilai
            valType = self.inferExpr(valExpr)
            targetType = self.nodeType(expr.target)
            if targetType == "IDENT" or targetType == "PENGENAL":
                targetName = expr.target.name if hasattr(expr.target, "name") else expr.target.nama
                varType = self.lookup(targetName)
                if varType != None and varType.name != "" and valType.name != "" and varType.name != valType.name:
                    self.error("cannot assign variable '" + targetName + "' (type " + varType.name + ") with value of type " + valType.name, expr)
                return varType if varType != None else valType
            elif targetType == "INDEX":
                self.inferExpr(expr.target.target)
                self.inferExpr(expr.target.index)
                return valType
            elif targetType == "MEMBER":
                self.inferExpr(expr.target.target)
                return valType
            return valType

        return StaticType("")

    func checkStmt(self, stmt):
        if stmt == None:
            return None

        t = self.nodeType(stmt)

        if t == "VAR" or t == "BUAT":
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            valType = self.inferExpr(valExpr)
            tracked = StaticType("")

            rawAnnot = ""
            if hasattr(stmt, "typeAnnotation") and stmt.typeAnnotation != None:
                rawAnnot = stmt.typeAnnotation
            elif hasattr(stmt, "tipe") and stmt.tipe != None:
                rawAnnot = stmt.tipe

            stmtName = stmt.name if hasattr(stmt, "name") else stmt.nama
            if rawAnnot != "":
                canon = self.canonicalizeType(rawAnnot)
                if canon != "" and valType.name != "" and canon != valType.name:
                    self.error("variable '" + stmtName + "' annotated with type " + canon + ", but initialized with type " + valType.name, stmt)
                tracked.name = canon

            self.define(stmtName, tracked)

        elif t == "FUNC" or t == "FUNGSI":
            sig = StaticType("func")
            sig.isFunc = True
            nParams = len(stmt.params)

            paramTypes = []
            i = 0
            while i < nParams:
                rawP = ""
                if hasattr(stmt, "paramTypes") and i < len(stmt.paramTypes):
                    rawP = stmt.paramTypes[i]
                paramTypes.append(self.canonicalizeType(rawP))
                i += 1
            sig.paramTypes = paramTypes

            rawRet = ""
            if hasattr(stmt, "returnType") and stmt.returnType != None:
                rawRet = stmt.returnType
            elif hasattr(stmt, "tipeHasil") and stmt.tipeHasil != None:
                rawRet = stmt.tipeHasil
            sig.returnType = self.canonicalizeType(rawRet)

            stmtName = stmt.name if hasattr(stmt, "name") else stmt.nama
            self.define(stmtName, sig)

            self.pushScope()
            i = 0
            while i < nParams:
                self.define(stmt.params[i], StaticType(sig.paramTypes[i]))
                i += 1

            self.returnTypeStack.append(sig.returnType)

            bodyNode = stmt.body if hasattr(stmt, "body") else stmt.badan
            bodyStmts = bodyNode.stmts if hasattr(bodyNode, "stmts") else [bodyNode]
            for s in bodyStmts:
                self.checkStmt(s)

            self.returnTypeStack.pop()
            self.popScope()

        elif t == "BLOCK" or t == "BLOK":
            self.pushScope()
            stmts = stmt.stmts if hasattr(stmt, "stmts") else []
            for s in stmts:
                self.checkStmt(s)
            self.popScope()

        elif t == "IF" or t == "JIKA":
            condExpr = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            self.inferExpr(condExpr)
            self.pushScope()
            thenBranch = stmt.thenBranch if hasattr(stmt, "thenBranch") else stmt.maka
            thenStmts = thenBranch.stmts if hasattr(thenBranch, "stmts") else [thenBranch]
            for s in thenStmts:
                self.checkStmt(s)
            self.popScope()

            elseBranch = stmt.elseBranch if hasattr(stmt, "elseBranch") else stmt.lain
            if elseBranch != None:
                self.pushScope()
                elseStmts = elseBranch.stmts if hasattr(elseBranch, "stmts") else [elseBranch]
                for s in elseStmts:
                    self.checkStmt(s)
                self.popScope()

        elif t == "WHILE" or t == "SELAMA":
            condExpr = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            self.inferExpr(condExpr)
            self.pushScope()
            bodyNode = stmt.body if hasattr(stmt, "body") else stmt.badan
            bodyStmts = bodyNode.stmts if hasattr(bodyNode, "stmts") else [bodyNode]
            for s in bodyStmts:
                self.checkStmt(s)
            self.popScope()

        elif t == "FOR" or t == "UNTUK":
            self.pushScope()
            initStmt = stmt.init if hasattr(stmt, "init") else stmt.inisialisasi
            if initStmt != None:
                self.checkStmt(initStmt)
            condExpr = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            if condExpr != None:
                self.inferExpr(condExpr)
            self.pushScope()
            bodyNode = stmt.body if hasattr(stmt, "body") else stmt.badan
            bodyStmts = bodyNode.stmts if hasattr(bodyNode, "stmts") else [bodyNode]
            for s in bodyStmts:
                self.checkStmt(s)
            self.popScope()
            postExpr = stmt.post if hasattr(stmt, "post") else stmt.pasca
            if postExpr != None:
                self.inferExpr(postExpr)
            self.popScope()

        elif t == "FOR_IN" or t == "UNTUK_DALAM":
            iterExpr = stmt.iterable if hasattr(stmt, "iterable") else stmt.iter
            varName = stmt.variable if hasattr(stmt, "variable") else stmt.variabel
            self.inferExpr(iterExpr)
            self.pushScope()
            self.define(varName, StaticType(""))
            bodyNode = stmt.body if hasattr(stmt, "body") else stmt.badan
            bodyStmts = bodyNode.stmts if hasattr(bodyNode, "stmts") else [bodyNode]
            for s in bodyStmts:
                self.checkStmt(s)
            self.popScope()

        elif t == "RETURN" or t == "HASIL":
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            valType = self.inferExpr(valExpr) if valExpr != None else StaticType("null")
            if len(self.returnTypeStack) > 0:
                want = self.returnTypeStack[-1]
                canonWant = self.canonicalizeType(want)
                canonVal = self.canonicalizeType(valType.name)
                if canonWant != "" and canonVal != "" and canonWant != canonVal:
                    self.error("return value of type " + valType.name + ", but function annotated with return type " + want, stmt)

        elif t == "TRY" or t == "COBA":
            self.pushScope()
            tryBlock = stmt.tryBlock if hasattr(stmt, "tryBlock") else (stmt.cobaBlok if hasattr(stmt, "cobaBlok") else None)
            tryStmts = tryBlock.stmts if hasattr(tryBlock, "stmts") else [tryBlock]
            for s in tryStmts:
                self.checkStmt(s)
            self.popScope()

            catchBlock = stmt.catchBlock if hasattr(stmt, "catchBlock") else (stmt.tangkapBlok if hasattr(stmt, "tangkapBlok") else None)
            catchVar = stmt.catchVar if hasattr(stmt, "catchVar") else (stmt.tangkapVar if hasattr(stmt, "tangkapVar") else None)
            if catchBlock != None:
                self.pushScope()
                if catchVar != None:
                    self.define(catchVar, StaticType(""))
                catchStmts = catchBlock.stmts if hasattr(catchBlock, "stmts") else [catchBlock]
                for s in catchStmts:
                    self.checkStmt(s)
                self.popScope()

            finallyBlock = stmt.finallyBlock if hasattr(stmt, "finallyBlock") else (stmt.akhirnyaBlok if hasattr(stmt, "akhirnyaBlok") else None)
            if finallyBlock != None:
                self.pushScope()
                finStmts = finallyBlock.stmts if hasattr(finallyBlock, "stmts") else [finallyBlock]
                for s in finStmts:
                    self.checkStmt(s)
                self.popScope()

        elif t == "THROW" or t == "LEMPAR":
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            self.inferExpr(valExpr)
        elif t == "EXPR" or t == "EKSPRESI":
            self.inferExpr(stmt.expr)
        elif t == "CLASS" or t == "KELAS":
            className = stmt.name if hasattr(stmt, "name") else stmt.nama
            self.define(className, StaticType("class"))
            methods = stmt.methods if hasattr(stmt, "methods") else (stmt.metode if hasattr(stmt, "metode") else [])
            self.pushScope()
            for m in methods:
                self.checkStmt(m)
            self.popScope()

    func check(self, progAst):
        self.scopes = []
        self.returnTypeStack = []
        self.errors = []

        self.pushScope()

        stmts = progAst
        if hasattr(progAst, "stmts"):
            stmts = progAst.stmts
        elif hasattr(progAst, "statements"):
            stmts = progAst.statements

        for stmt in stmts:
            self.checkStmt(stmt)

        self.popScope()

        return len(self.errors) == 0

    func getErrors(self):
        return self.errors

    func daftarError(self):
        return self.getErrors()

func validateType(val, expected):
    target = normalizeType(expected)
    if target == "":
        return True

    t = type(val)
    if target == "number":
        return t == "angka" or t == "number" or t == "int" or t == "float"
    elif target == "string":
        return t == "teks" or t == "string" or t == "str"
    elif target == "bool":
        return t == "boolean" or t == "bool"
    elif target == "list":
        return t == "larik" or t == "list" or t == "array"
    elif target == "map":
        return t == "peta" or t == "map" or t == "dict"
    elif target == "func":
        return t == "fungsi" or t == "func" or t == "function" or callable(val) or hasattr(val, "isFunction") or (type(val) == "map" and "isBuiltin" in val) or (type(val) == "peta" and "isBuiltin" in val) or (hasattr(val, "code") and hasattr(val, "constants"))
    elif target == "class":
        return t == "kelas" or t == "class" or hasattr(val, "isClass") or hasattr(val, "isInstance")
    elif target == "null":
        return val == None

    return t == target

func assertType(varName, val, expected):
    if not validateType(val, expected):
        act = type(val)
        print("TypeError: variable '" + varName + "' expected type '" + expected + "', got '" + str(act) + "'")
        return False
    return True

normalize = normalizeType
normalisasiTipe = normalizeType
validasiTipe = validateType
pastikanTipe = assertType
