import sys

func loadModule(path):
    try:
        return impor(path)
    except e:
        try:
            return impor("core/" + path)
        except e2:
            return impor("../" + path)

resolverModule = loadModule("resolver.ns")
resolveModulePath = resolverModule.resolveModulePath

func runtimeImpor(name):
    resolved = resolveModulePath(name, file_ada)
    if resolved != None:
        return impor(resolved)
    return impor(name)

Op = {
    "CONST": 1,
    "NULL": 2,
    "TRUE": 3,
    "FALSE": 4,

    "ADD": 5,
    "SUB": 6,
    "MUL": 7,
    "DIV": 8,
    "MOD": 9,
    "NEG": 10,
    "NOT": 11,

    "EQ": 12,
    "NEQ": 13,
    "LT": 14,
    "LTE": 15,
    "GT": 16,
    "GTE": 17,

    "POP": 18,

    "GETLOCAL": 19,
    "SETLOCAL": 20,
    "DEFINELOCAL": 21,

    "GETGLOBAL": 22,
    "SETGLOBAL": 23,
    "DEFINEGLOBAL": 24,

    "JUMPIFFALSE": 25,
    "JUMP": 26,
    "JUMPIFFALSEKEEP": 27,
    "JUMPIFTRUEKEEP": 28,
    "LOOP": 29,

    "CALL": 30,
    "MAKECLOSURE": 31,
    "RETURN": 32,
    "RETURNNULL": 33,

    "PRINT": 34,
    "LENGTH": 35,
    "PUSH": 36,

    "NEWARRAY": 37,
    "NEWMAP": 38,
    "GETINDEX": 39,
    "SETINDEX": 40,
    "GETFIELD": 41,
    "SETFIELD": 42,

    "CALLMETHOD": 43,
    "MAKECLASS": 44,

    "THROW": 45,
    "IN": 46,
    "SLICE": 47,
    "INCLOCAL": 48,
    "DECLOCAL": 49,
    "ADDLOCAL": 50,
    "TOSTRING": 51,

    "BITAND": 52,
    "BITOR": 53,
    "BITXOR": 54,
    "SHL": 55,
    "SHR": 56,
    "BITNOT": 57,
    "GETARGCOUNT": 58,
    "SUPER": 59,
    "TRYSTART": 60,
    "TRYEND": 61,
    "GETUPVALUE": 62,
    "SETUPVALUE": 63,
    "TOITER": 64
}

opNames = {}
for k in Op:
    opNames[Op[k]] = k

class VmCell:
    func __init__(self, val):
        self.val = val

class VmClosure:
    func __init__(self, fn):
        self.isClosure = True
        self.fn = fn
        self.upvalues = []

class VmFunction:
    func __init__(self, name, params):
        self.isFunction = True
        self.name = name
        self.nama = name
        self.params = params
        self.arity = len(params)
        self.code = []
        self.constants = []
        self.numLocals = self.arity
        self.upvalues = []

    func addConstant(self, val):
        self.constants.append(val)
        return len(self.constants) - 1

    func tambahKonstanta(self, val):
        return self.addConstant(val)

    func disassemble(self):
        lines = []
        lines.append("Disassembly: " + self.name + " (arity=" + str(self.arity) + ", locals=" + str(self.numLocals) + ")")
        i = 0
        n = len(self.code)
        while i < n:
            offset = i
            op = self.code[i]
            i += 1
            opName = opNames[op] if op in opNames else ("OP" + str(op))
            detail = ""

            if op == Op.CONST or op == Op.GETGLOBAL or op == Op.SETGLOBAL or op == Op.DEFINEGLOBAL or op == Op.GETFIELD or op == Op.SETFIELD:
                idx = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = str(idx) + " ('" + str(self.constants[idx]) + "')"
            elif op == Op.GETLOCAL or op == Op.SETLOCAL or op == Op.DEFINELOCAL or op == Op.INCLOCAL or op == Op.DECLOCAL:
                slot = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = "slot " + str(slot)
            elif op == Op.GETUPVALUE or op == Op.SETUPVALUE:
                idx = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = "upvalue " + str(idx)
            elif op == Op.MAKECLOSURE:
                fnIdx = self.code[i] | (self.code[i + 1] << 8)
                cnt = self.code[i + 2] | (self.code[i + 3] << 8)
                i += 4
                detail = "fn=" + str(fnIdx) + " count=" + str(cnt)
                k = 0
                while k < cnt:
                    i += 3
                    k += 1
            elif op == Op.ADDLOCAL:
                slot = self.code[i] | (self.code[i + 1] << 8)
                idx = self.code[i + 2] | (self.code[i + 3] << 8)
                i += 4
                detail = "slot " + str(slot) + " const " + str(idx)
            elif op == Op.JUMP or op == Op.JUMPIFFALSE or op == Op.JUMPIFFALSEKEEP or op == Op.JUMPIFTRUEKEEP:
                off = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = "+" + str(off) + " -> " + str(i + off)
            elif op == Op.LOOP:
                off = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = "-" + str(off) + " -> " + str(i - off)
            elif op == Op.CALL or op == Op.PRINT:
                argc = self.code[i]
                i += 1
                detail = "argc=" + str(argc)
            elif op == Op.NEWARRAY or op == Op.NEWMAP:
                cnt = self.code[i] | (self.code[i + 1] << 8)
                i += 2
                detail = "count=" + str(cnt)

            lines.append(str(offset) + ": " + opName + " " + detail)
        return "\n".join(lines)

class CallFrame:
    func __init__(self, fn, args, closure = None):
        self.fn = fn
        self.closure = closure
        self.ip = 0
        self.handlers = []
        self.cells = {}
        self.hasCells = False
        self.providedCount = len(args)
        maxLoc = fn.numLocals if hasattr(fn, "numLocals") else fn.arity
        diff = maxLoc - len(args)
        if diff <= 0:
            self.locals = args[:]
        else:
            self.locals = args[:] + [None] * diff

class VmClass:
    func __init__(self, name, baseClass):
        self.isClass = True
        self.isKelas = True
        self.name = name
        self.nama = name
        self.baseClass = baseClass
        self.methods = {}
        self.metode = self.methods

class VmInstance:
    func __init__(self, clsObj):
        self.isInstance = True
        self.isInstans = True
        self.cls = clsObj
        self.kelas = clsObj
        self.fields = {}
        self.bidang = self.fields

class FnCompiler:
    func __init__(self, enclosing, fn):
        self.enclosing = enclosing
        self.fn = fn
        self.locals = []
        self.scopeDepth = 0
        self.loopStack = []
        self.upvalues = []

    func beginScope(self):
        self.scopeDepth += 1

    func endScope(self):
        self.scopeDepth -= 1
        while len(self.locals) > 0 and self.locals[-1]["depth"] > self.scopeDepth:
            self.locals.pop()

    func addLocal(self, name):
        slot = len(self.locals)
        self.locals.append({"name": name, "depth": self.scopeDepth, "slot": slot})
        if slot + 1 > self.fn.numLocals:
            self.fn.numLocals = slot + 1
        return slot

    func resolveLocal(self, name):
        i = len(self.locals) - 1
        while i >= 0:
            if self.locals[i]["name"] == name:
                return self.locals[i]["slot"]
            i -= 1
        return -1

    func addUpvalue(self, isLocal, index, name):
        i = 0
        while i < len(self.upvalues):
            u = self.upvalues[i]
            if u["isLocal"] == isLocal and u["index"] == index:
                return i
            i += 1
        self.upvalues.append({"isLocal": isLocal, "index": index, "name": name})
        self.fn.upvalues = self.upvalues
        return len(self.upvalues) - 1

    func resolveUpvalue(self, name):
        if self.enclosing == None:
            return -1
        localIdx = self.enclosing.resolveLocal(name)
        if localIdx != -1:
            return self.addUpvalue(True, localIdx, name)
        upIdx = self.enclosing.resolveUpvalue(name)
        if upIdx != -1:
            return self.addUpvalue(False, upIdx, name)
        return -1

class VmCompiler:
    func __init__(self):
        self.current = None
        self.currentFn = None
        self.fnStack = []
        self.scopeDepth = 0
        self.locals = []
        self.loopStack = []
        self.programFunctions = []
        self.globalNames = {
            "print": True, "cetak": True, "len": True, "panjang": True,
            "str": True, "ke_teks": True, "int": True, "float": True,
            "ke_angka": True, "type": True, "tipe": True, "range": True,
            "rentang": True, "list": True, "larik": True, "map": True,
            "peta": True, "readFile": True, "baca_file": True,
            "writeFile": True, "tulis_file": True, "fileExists": True,
            "file_ada": True, "import": True, "impor": True,
            "time": True, "waktu": True, "gcInfo": True, "gc_info": True,
            "gcForce": True, "gc_paksa": True, "env": True, "ambil_env": True,
            "push": True, "tambah": True, "pop": True, "hapus_akhir": True,
            "split": True, "pisah": True, "join": True, "gabung": True,
            "runCommand": True, "JalankanPerintah": True, "jalankanPerintah": True,
            "callable": True, "input": True, "sys": True
        }

    func beginScope(self):
        self.current.beginScope()
        self.scopeDepth = self.current.scopeDepth

    func endScope(self):
        self.current.endScope()
        self.scopeDepth = self.current.scopeDepth
        self.locals = self.current.locals

    func addLocal(self, name):
        slot = self.current.addLocal(name)
        self.locals = self.current.locals
        return slot

    func resolveLocal(self, name):
        return self.current.resolveLocal(name)

    func resolveUpvalue(self, name):
        return self.current.resolveUpvalue(name)

    func emitByte(self, b):
        self.current.fn.code.append(b)

    func emitOp(self, op):
        self.emitByte(op)

    func emitU16(self, v):
        self.emitByte(v & 255)
        self.emitByte((v >> 8) & 255)

    func addConstant(self, val):
        return self.current.fn.addConstant(val)

    func emitConstant(self, val):
        idx = self.addConstant(val)
        self.emitOp(Op.CONST)
        self.emitU16(idx)

    func emitJump(self, op):
        self.emitOp(op)
        self.emitU16(65535)
        return len(self.current.fn.code) - 2

    func patchJump(self, offset):
        jump = len(self.current.fn.code) - offset - 2
        self.current.fn.code[offset] = jump & 255
        self.current.fn.code[offset + 1] = (jump >> 8) & 255

    func emitLoop(self, loopStart):
        self.emitOp(Op.LOOP)
        off = len(self.current.fn.code) - loopStart + 2
        self.emitU16(off)

    func nodeType(self, node):
        if node == None:
            return ""
        if hasattr(node, "type"):
            return node.type
        if hasattr(node, "jenis"):
            return node.jenis
        return ""

    func compile(self, progAst):
        topFn = VmFunction("<script>", [])
        self.current = FnCompiler(None, topFn)
        self.currentFn = topFn
        self.programFunctions = [topFn]
        self.locals = self.current.locals
        self.scopeDepth = 0
        self.loopStack = self.current.loopStack
        self.fnStack = []

        stmts = progAst
        if hasattr(progAst, "stmts"):
            stmts = progAst.stmts
        elif hasattr(progAst, "statements"):
            stmts = progAst.statements

        for stmt in stmts:
            self.compileStmt(stmt, True)

        self.emitOp(Op.RETURNNULL)
        return topFn

    func compileBlock(self, stmts):
        for s in stmts:
            self.compileStmt(s, False)

    func compileStmt(self, stmt, isTopLevel):
        if stmt == None:
            return None

        t = self.nodeType(stmt)

        if t == "BLOCK" or t == "BLOK":
            stmts = stmt.stmts if hasattr(stmt, "stmts") else []
            self.compileBlock(stmts)
        elif t == "VAR" or t == "BUAT":
            name = stmt.name if hasattr(stmt, "name") else stmt.nama
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            self.compileExpr(valExpr)
            if isTopLevel and self.current.enclosing == None and self.current.scopeDepth == 0:
                constIdx = self.addConstant(name)
                self.globalNames[name] = True
                self.emitOp(Op.DEFINEGLOBAL)
                self.emitU16(constIdx)
            else:
                slot = self.addLocal(name)
                self.emitOp(Op.DEFINELOCAL)
                self.emitU16(slot)
        elif t == "FUNC" or t == "FUNGSI":
            self.compileFn(stmt, isTopLevel)
        elif t == "IF" or t == "JIKA":
            cond = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            thenBranch = stmt.thenBranch if hasattr(stmt, "thenBranch") else stmt.maka
            elseBranch = stmt.elseBranch if hasattr(stmt, "elseBranch") else stmt.lain
            condType = self.nodeType(cond)
            if condType == "BOOL":
                cVal = cond.value if hasattr(cond, "value") else cond.nilai
                if cVal:
                    self.compileStmt(thenBranch, False)
                elif elseBranch != None:
                    self.compileStmt(elseBranch, False)
                return None
            self.compileExpr(cond)
            elseJump = self.emitJump(Op.JUMPIFFALSE)
            self.compileStmt(thenBranch, False)
            endJump = self.emitJump(Op.JUMP)
            self.patchJump(elseJump)
            if elseBranch != None:
                self.compileStmt(elseBranch, False)
            self.patchJump(endJump)
        elif t == "WHILE" or t == "SELAMA":
            cond = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            body = stmt.body if hasattr(stmt, "body") else stmt.badan
            loopStart = len(self.currentFn.code)
            self.compileExpr(cond)
            exitJump = self.emitJump(Op.JUMPIFFALSE)
            self.loopStack.append({"breakJumps": [], "continueJumps": []})
            self.compileStmt(body, False)
            curLoop = self.loopStack.pop()
            for cj in curLoop["continueJumps"]:
                self.patchJump(cj)
            self.emitLoop(loopStart)
            self.patchJump(exitJump)
            for bj in curLoop["breakJumps"]:
                self.patchJump(bj)
        elif t == "FOR" or t == "UNTUK":
            initStmt = stmt.init if hasattr(stmt, "init") else stmt.inisialisasi
            cond = stmt.condition if hasattr(stmt, "condition") else stmt.kondisi
            postExpr = stmt.post if hasattr(stmt, "post") else stmt.pasca
            body = stmt.body if hasattr(stmt, "body") else stmt.badan
            self.beginScope()
            if initStmt != None:
                self.compileStmt(initStmt, False)
            loopStart = len(self.currentFn.code)
            exitJump = -1
            if cond != None:
                self.compileExpr(cond)
                exitJump = self.emitJump(Op.JUMPIFFALSE)
            self.loopStack.append({"breakJumps": [], "continueJumps": []})
            self.compileStmt(body, False)
            curLoop = self.loopStack.pop()
            for cj in curLoop["continueJumps"]:
                self.patchJump(cj)
            if postExpr != None:
                self.compileExpr(postExpr)
                self.emitOp(Op.POP)
            self.emitLoop(loopStart)
            if exitJump != -1:
                self.patchJump(exitJump)
            for bj in curLoop["breakJumps"]:
                self.patchJump(bj)
            self.endScope()
        elif t == "FOR_IN" or t == "UNTUK_DALAM":
            iterExpr = stmt.iterable if hasattr(stmt, "iterable") else stmt.iter
            varName = stmt.variable if hasattr(stmt, "variable") else stmt.variabel
            body = stmt.body if hasattr(stmt, "body") else stmt.badan
            self.beginScope()
            self.compileExpr(iterExpr)
            self.emitOp(Op.TOITER)
            iterSlot = self.addLocal("$iter")
            self.emitOp(Op.DEFINELOCAL)
            self.emitU16(iterSlot)
            self.emitOp(Op.GETLOCAL)
            self.emitU16(iterSlot)
            self.emitOp(Op.LENGTH)
            lenSlot = self.addLocal("$len")
            self.emitOp(Op.DEFINELOCAL)
            self.emitU16(lenSlot)
            self.emitConstant(0)
            idxSlot = self.addLocal("$idx")
            self.emitOp(Op.DEFINELOCAL)
            self.emitU16(idxSlot)
            varSlot = self.addLocal(varName)
            self.emitOp(Op.NULL)
            self.emitOp(Op.DEFINELOCAL)
            self.emitU16(varSlot)
            loopStart = len(self.currentFn.code)
            self.emitOp(Op.GETLOCAL)
            self.emitU16(idxSlot)
            self.emitOp(Op.GETLOCAL)
            self.emitU16(lenSlot)
            self.emitOp(Op.LT)
            exitJump = self.emitJump(Op.JUMPIFFALSE)
            self.emitOp(Op.GETLOCAL)
            self.emitU16(iterSlot)
            self.emitOp(Op.GETLOCAL)
            self.emitU16(idxSlot)
            self.emitOp(Op.GETINDEX)
            self.emitOp(Op.SETLOCAL)
            self.emitU16(varSlot)
            self.emitOp(Op.POP)
            self.loopStack.append({"breakJumps": [], "continueJumps": []})
            self.compileStmt(body, False)
            curLoop = self.loopStack.pop()
            for cj in curLoop["continueJumps"]:
                self.patchJump(cj)
            self.emitOp(Op.INCLOCAL)
            self.emitU16(idxSlot)
            self.emitLoop(loopStart)
            self.patchJump(exitJump)
            for bj in curLoop["breakJumps"]:
                self.patchJump(bj)
            self.endScope()
        elif t == "RETURN" or t == "HASIL":
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            if valExpr != None:
                self.compileExpr(valExpr)
                self.emitOp(Op.RETURN)
            else:
                self.emitOp(Op.RETURNNULL)
        elif t == "BREAK" or t == "BERHENTI":
            if len(self.loopStack) == 0:
                print("CompileError: break outside loop")
                return None
            jmp = self.emitJump(Op.JUMP)
            self.loopStack[-1]["breakJumps"].append(jmp)
        elif t == "CONTINUE" or t == "LANJUT":
            if len(self.loopStack) == 0:
                print("CompileError: continue outside loop")
                return None
            jmp = self.emitJump(Op.JUMP)
            self.loopStack[-1]["continueJumps"].append(jmp)
        elif t == "EXPR" or t == "EKSPRESI":
            exprInner = stmt.expr if hasattr(stmt, "expr") else stmt.expr
            innerType = self.nodeType(exprInner)
            fused = False
            if innerType == "ASSIGN" or innerType == "TUGAS":
                target = exprInner.target if hasattr(exprInner, "target") else exprInner.target
                val = exprInner.value if hasattr(exprInner, "value") else exprInner.nilai
                targetType = self.nodeType(target)
                if targetType == "IDENT" or targetType == "PENGENAL":
                    name = target.name if hasattr(target, "name") else target.nama
                    slot = self.resolveLocal(name)
                    if slot != -1:
                        valType = self.nodeType(val)
                        if exprInner.op == "+=" and (valType == "NUMBER" or valType == "ANGKA"):
                            v = val.value if hasattr(val, "value") else val.nilai
                            if v == 1:
                                self.emitOp(Op.INCLOCAL)
                                self.emitU16(slot)
                                fused = True
                            elif v == -1:
                                self.emitOp(Op.DECLOCAL)
                                self.emitU16(slot)
                                fused = True
                            else:
                                cIdx = self.addConstant(v)
                                self.emitOp(Op.ADDLOCAL)
                                self.emitU16(slot)
                                self.emitU16(cIdx)
                                fused = True
                        elif exprInner.op == "-=" and (valType == "NUMBER" or valType == "ANGKA"):
                            v = val.value if hasattr(val, "value") else val.nilai
                            if v == 1:
                                self.emitOp(Op.DECLOCAL)
                                self.emitU16(slot)
                                fused = True
                            elif v == -1:
                                self.emitOp(Op.INCLOCAL)
                                self.emitU16(slot)
                                fused = True
                            else:
                                cIdx = self.addConstant(-v)
                                self.emitOp(Op.ADDLOCAL)
                                self.emitU16(slot)
                                self.emitU16(cIdx)
                                fused = True
                        elif exprInner.op == "=" and (valType == "BINARY" or valType == "BINER"):
                            bLeft = val.left if hasattr(val, "left") else val.kiri
                            bRight = val.right if hasattr(val, "right") else val.kanan
                            bLeftType = self.nodeType(bLeft)
                            bRightType = self.nodeType(bRight)
                            bLeftName = bLeft.name if hasattr(bLeft, "name") else (bLeft.nama if hasattr(bLeft, "nama") else "")
                            if val.op == "+" and (bLeftType == "IDENT" or bLeftType == "PENGENAL") and bLeftName == name and (bRightType == "NUMBER" or bRightType == "ANGKA"):
                                v = bRight.value if hasattr(bRight, "value") else bRight.nilai
                                if v == 1:
                                    self.emitOp(Op.INCLOCAL)
                                    self.emitU16(slot)
                                    fused = True
                                elif v == -1:
                                    self.emitOp(Op.DECLOCAL)
                                    self.emitU16(slot)
                                    fused = True
                                else:
                                    cIdx = self.addConstant(v)
                                    self.emitOp(Op.ADDLOCAL)
                                    self.emitU16(slot)
                                    self.emitU16(cIdx)
                                    fused = True
                            elif val.op == "-" and (bLeftType == "IDENT" or bLeftType == "PENGENAL") and bLeftName == name and (bRightType == "NUMBER" or bRightType == "ANGKA"):
                                v = bRight.value if hasattr(bRight, "value") else bRight.nilai
                                if v == 1:
                                    self.emitOp(Op.DECLOCAL)
                                    self.emitU16(slot)
                                    fused = True
                                elif v == -1:
                                    self.emitOp(Op.INCLOCAL)
                                    self.emitU16(slot)
                                    fused = True
                                else:
                                    cIdx = self.addConstant(-v)
                                    self.emitOp(Op.ADDLOCAL)
                                    self.emitU16(slot)
                                    self.emitU16(cIdx)
                                    fused = True
            if not fused:
                self.compileExpr(stmt.expr)
                self.emitOp(Op.POP)
        elif t == "THROW" or t == "LEMPAR":
            valExpr = stmt.value if hasattr(stmt, "value") else stmt.nilai
            self.compileExpr(valExpr)
            self.emitOp(Op.THROW)
        elif t == "TRY" or t == "COBA":
            tryBlock = stmt.tryBlock if hasattr(stmt, "tryBlock") else stmt.coba_blok
            catchVar = stmt.catchVar if hasattr(stmt, "catchVar") else stmt.tangkap_var
            catchBlock = stmt.catchBlock if hasattr(stmt, "catchBlock") else stmt.tangkap_blok
            finallyBlock = stmt.finallyBlock if hasattr(stmt, "finallyBlock") else stmt.akhirnya_blok
            tryStmts = tryBlock.stmts if hasattr(tryBlock, "stmts") else [tryBlock]

            handlerJump = self.emitJump(Op.TRYSTART)
            self.compileBlock(tryStmts)
            self.emitOp(Op.TRYEND)
            if finallyBlock != None:
                finallyStmts = finallyBlock.stmts if hasattr(finallyBlock, "stmts") else [finallyBlock]
                self.compileBlock(finallyStmts)
            normalDoneJump = self.emitJump(Op.JUMP)

            self.patchJump(handlerJump)
            if catchBlock != None:
                catchStmts = catchBlock.stmts if hasattr(catchBlock, "stmts") else [catchBlock]
                slot = self.addLocal(catchVar)
                self.emitOp(Op.SETLOCAL)
                self.emitU16(slot)
                self.emitOp(Op.POP)
                self.compileBlock(catchStmts)
                if finallyBlock != None:
                    finallyStmts = finallyBlock.stmts if hasattr(finallyBlock, "stmts") else [finallyBlock]
                    self.compileBlock(finallyStmts)
            else:
                if finallyBlock != None:
                    finallyStmts = finallyBlock.stmts if hasattr(finallyBlock, "stmts") else [finallyBlock]
                    self.compileBlock(finallyStmts)
                self.emitOp(Op.THROW)
            self.patchJump(normalDoneJump)
        elif t == "CLASS" or t == "KELAS":
            name = stmt.name if hasattr(stmt, "name") else stmt.nama
            baseClass = stmt.baseClass if hasattr(stmt, "baseClass") else (stmt.induk if hasattr(stmt, "induk") else None)
            methods = stmt.methods if hasattr(stmt, "methods") else stmt.metode
            clsFnMap = {}
            if methods != None:
                for m in methods:
                    mName = m.name if hasattr(m, "name") else m.nama
                    mBody = m.body if hasattr(m, "body") else m.badan
                    hasSelf = len(m.params) > 0 and (m.params[0] == "self" or m.params[0] == "this" or m.params[0] == "ini")
                    mParams = m.params if hasSelf else (["self"] + m.params)
                    mFn = VmFunction(name + "." + mName, mParams)
                    self.programFunctions.append(mFn)
                    parentCompiler = self.current
                    fnCompiler = FnCompiler(parentCompiler, mFn)
                    self.current = fnCompiler
                    self.currentFn = mFn
                    self.fnStack.append(parentCompiler.fn)

                    self.beginScope()
                    mDefaults = m.defaults if hasattr(m, "defaults") else {}
                    i = 0
                    for p in mParams:
                        slot = self.addLocal(p)
                        if p in mDefaults:
                            self.emitOp(Op.GETARGCOUNT)
                            self.emitConstant(i)
                            self.emitOp(Op.LTE)
                            skipJump = self.emitJump(Op.JUMPIFFALSE)
                            self.compileExpr(mDefaults[p])
                            self.emitOp(Op.SETLOCAL)
                            self.emitU16(slot)
                            self.emitOp(Op.POP)
                            self.patchJump(skipJump)
                        i += 1
                    for alias in ["ini", "this", "self"]:
                        if alias not in mParams:
                            aSlot = self.addLocal(alias)
                            self.emitOp(Op.GETLOCAL)
                            self.emitU16(0)
                            self.emitOp(Op.SETLOCAL)
                            self.emitU16(aSlot)
                            self.emitOp(Op.POP)
                    bodyStmts = mBody.stmts if hasattr(mBody, "stmts") else [mBody]
                    self.compileBlock(bodyStmts)
                    self.endScope()
                    self.emitOp(Op.RETURNNULL)

                    self.current = parentCompiler
                    self.currentFn = parentCompiler.fn
                    self.fnStack.pop()
                    clsFnMap[mName] = mFn
            c = VmClass(name, baseClass)
            c.methods = clsFnMap
            c.metode = clsFnMap
            self.emitConstant(c)
            if isTopLevel and self.current.enclosing == None and self.current.scopeDepth == 0:
                constIdx = self.addConstant(name)
                self.globalNames[name] = True
                self.emitOp(Op.DEFINEGLOBAL)
                self.emitU16(constIdx)
            else:
                slot = self.addLocal(name)
                self.emitOp(Op.DEFINELOCAL)
                self.emitU16(slot)

    func compileFn(self, stmt, isTopLevel):
        name = stmt.name if hasattr(stmt, "name") else stmt.nama
        body = stmt.body if hasattr(stmt, "body") else stmt.badan
        subFn = VmFunction(name, stmt.params)
        self.programFunctions.append(subFn)

        parentCompiler = self.current
        fnCompiler = FnCompiler(parentCompiler, subFn)
        self.current = fnCompiler
        self.currentFn = subFn
        self.fnStack.append(parentCompiler.fn)

        self.beginScope()
        defaults = stmt.defaults if hasattr(stmt, "defaults") else {}
        i = 0
        for p in stmt.params:
            slot = self.addLocal(p)
            if p in defaults:
                self.emitOp(Op.GETARGCOUNT)
                self.emitConstant(i)
                self.emitOp(Op.LTE)
                skipJump = self.emitJump(Op.JUMPIFFALSE)
                self.compileExpr(defaults[p])
                self.emitOp(Op.SETLOCAL)
                self.emitU16(slot)
                self.emitOp(Op.POP)
                self.patchJump(skipJump)
            i += 1

        bodyStmts = body.stmts if hasattr(body, "stmts") else [body]
        self.compileBlock(bodyStmts)
        self.endScope()

        self.emitOp(Op.RETURNNULL)

        self.current = parentCompiler
        self.currentFn = parentCompiler.fn
        self.fnStack.pop()

        if len(subFn.upvalues) > 0:
            fnIdx = self.addConstant(subFn)
            self.emitOp(Op.MAKECLOSURE)
            self.emitU16(fnIdx)
            self.emitU16(len(subFn.upvalues))
            for uv in subFn.upvalues:
                self.emitByte(1 if uv["isLocal"] else 0)
                self.emitU16(uv["index"])
        else:
            self.emitConstant(subFn)

        if isTopLevel and self.current.enclosing == None and self.current.scopeDepth == 0:
            constIdx = self.addConstant(name)
            self.globalNames[name] = True
            self.emitOp(Op.DEFINEGLOBAL)
            self.emitU16(constIdx)
        else:
            slot = self.addLocal(name)
            self.emitOp(Op.DEFINELOCAL)
            self.emitU16(slot)

    func compileExpr(self, expr):
        if expr == None:
            self.emitOp(Op.NULL)
            return None

        t = self.nodeType(expr)

        if t == "NUMBER" or t == "ANGKA":
            val = expr.value if hasattr(expr, "value") else expr.nilai
            self.emitConstant(val)
        elif t == "STRING" or t == "TEKS":
            val = expr.value if hasattr(expr, "value") else expr.nilai
            self.emitConstant(val)
        elif t == "BOOL":
            val = expr.value if hasattr(expr, "value") else expr.nilai
            self.emitOp(Op.TRUE if val else Op.FALSE)
        elif t == "NULL" or t == "KOSONG":
            self.emitOp(Op.NULL)
        elif t == "IDENT" or t == "PENGENAL":
            name = expr.name if hasattr(expr, "name") else expr.nama
            self.compileIdentGet(name)
        elif t == "BINARY" or t == "BINER":
            left = expr.left if hasattr(expr, "left") else expr.kiri
            right = expr.right if hasattr(expr, "right") else expr.kanan
            op = expr.op

            leftType = self.nodeType(left)
            rightType = self.nodeType(right)
            if (leftType == "NUMBER" or leftType == "ANGKA") and (rightType == "NUMBER" or rightType == "ANGKA"):
                v1 = left.value if hasattr(left, "value") else left.nilai
                v2 = right.value if hasattr(right, "value") else right.nilai
                if op == "+":
                    self.emitConstant(v1 + v2)
                    return None
                elif op == "-":
                    self.emitConstant(v1 - v2)
                    return None
                elif op == "*":
                    self.emitConstant(v1 * v2)
                    return None
                elif op == "/" and v2 != 0:
                    self.emitConstant(v1 / v2)
                    return None
                elif op == "%" and v2 != 0:
                    self.emitConstant(v1 % v2)
                    return None
                elif op == "&":
                    self.emitConstant(v1 & v2)
                    return None
                elif op == "|":
                    self.emitConstant(v1 | v2)
                    return None
                elif op == "^":
                    self.emitConstant(v1 ^ v2)
                    return None
                elif op == "<<":
                    self.emitConstant(v1 << v2)
                    return None
                elif op == ">>":
                    self.emitConstant(v1 >> v2)
                    return None
                elif op == "==":
                    self.emitOp(Op.TRUE if v1 == v2 else Op.FALSE)
                    return None
                elif op == "!=":
                    self.emitOp(Op.TRUE if v1 != v2 else Op.FALSE)
                    return None
                elif op == "<":
                    self.emitOp(Op.TRUE if v1 < v2 else Op.FALSE)
                    return None
                elif op == "<=":
                    self.emitOp(Op.TRUE if v1 <= v2 else Op.FALSE)
                    return None
                elif op == ">":
                    self.emitOp(Op.TRUE if v1 > v2 else Op.FALSE)
                    return None
                elif op == ">=":
                    self.emitOp(Op.TRUE if v1 >= v2 else Op.FALSE)
                    return None
            elif (leftType == "STRING" or leftType == "TEKS") and (rightType == "STRING" or rightType == "TEKS") and op == "+":
                v1 = left.value if hasattr(left, "value") else left.nilai
                v2 = right.value if hasattr(right, "value") else right.nilai
                self.emitConstant(v1 + v2)
                return None

            if op == "dan" or op == "&&" or op == "and":
                self.compileExpr(left)
                jumpKeep = self.emitJump(Op.JUMPIFFALSEKEEP)
                self.emitOp(Op.POP)
                self.compileExpr(right)
                self.patchJump(jumpKeep)
            elif op == "atau" or op == "||" or op == "or":
                self.compileExpr(left)
                jumpKeep = self.emitJump(Op.JUMPIFTRUEKEEP)
                self.emitOp(Op.POP)
                self.compileExpr(right)
                self.patchJump(jumpKeep)
            else:
                self.compileExpr(left)
                self.compileExpr(right)
                if op == "+":
                    self.emitOp(Op.ADD)
                elif op == "-":
                    self.emitOp(Op.SUB)
                elif op == "*":
                    self.emitOp(Op.MUL)
                elif op == "/":
                    self.emitOp(Op.DIV)
                elif op == "%":
                    self.emitOp(Op.MOD)
                elif op == "==":
                    self.emitOp(Op.EQ)
                elif op == "!=":
                    self.emitOp(Op.NEQ)
                elif op == "<":
                    self.emitOp(Op.LT)
                elif op == "<=":
                    self.emitOp(Op.LTE)
                elif op == ">":
                    self.emitOp(Op.GT)
                elif op == ">=":
                    self.emitOp(Op.GTE)
                elif op == "in" or op == "dalam":
                    self.emitOp(Op.IN)
                elif op == "&":
                    self.emitOp(Op.BITAND)
                elif op == "|":
                    self.emitOp(Op.BITOR)
                elif op == "^":
                    self.emitOp(Op.BITXOR)
                elif op == "<<":
                    self.emitOp(Op.SHL)
                elif op == ">>":
                    self.emitOp(Op.SHR)
        elif t == "UNARY" or t == "UNER":
            operand = expr.operand if hasattr(expr, "operand") else expr.operand
            self.compileExpr(operand)
            if expr.op == "-":
                self.emitOp(Op.NEG)
            elif expr.op == "!" or expr.op == "not" or expr.op == "bukan":
                self.emitOp(Op.NOT)
            elif expr.op == "~":
                self.emitOp(Op.BITNOT)
        elif t == "CALL" or t == "PANGGIL":
            callee = expr.callee if hasattr(expr, "callee") else expr.callee
            args = expr.args if hasattr(expr, "args") else expr.args
            calleeType = self.nodeType(callee)
            calleeName = callee.name if hasattr(callee, "name") else (callee.nama if hasattr(callee, "nama") else "")
            if (calleeType == "IDENT" or calleeType == "PENGENAL") and (calleeName == "super" or calleeName == "induk") and len(args) == 0:
                self.emitOp(Op.SUPER)
            elif (calleeType == "IDENT" or calleeType == "PENGENAL") and (calleeName == "cetak" or calleeName == "print"):
                for a in args:
                    self.compileExpr(a)
                self.emitOp(Op.PRINT)
                self.emitByte(len(args))
            elif (calleeType == "IDENT" or calleeType == "PENGENAL") and (calleeName == "panjang" or calleeName == "len"):
                if len(args) > 0:
                    self.compileExpr(args[0])
                else:
                    self.emitOp(Op.NULL)
                self.emitOp(Op.LENGTH)
            elif (calleeType == "IDENT" or calleeType == "PENGENAL") and (calleeName == "push" or calleeName == "tambah") and len(args) == 2:
                self.compileExpr(args[0])
                self.compileExpr(args[1])
                self.emitOp(Op.PUSH)
            elif (calleeType == "IDENT" or calleeType == "PENGENAL") and (calleeName == "str" or calleeName == "ke_teks") and len(args) == 1:
                self.compileExpr(args[0])
                self.emitOp(Op.TOSTRING)
            elif calleeType == "MEMBER" or calleeType == "AKSES_ANGGOTA":
                target = callee.target if hasattr(callee, "target") else callee.target
                memberName = callee.name if hasattr(callee, "name") else (callee.nama if hasattr(callee, "nama") else "")
                self.compileExpr(target)
                for a in args:
                    self.compileExpr(a)
                mIdx = self.addConstant(memberName)
                self.emitOp(Op.CALLMETHOD)
                self.emitU16(mIdx)
                self.emitByte(len(args))
            else:
                self.compileExpr(callee)
                for a in args:
                    self.compileExpr(a)
                self.emitOp(Op.CALL)
                self.emitByte(len(args))
        elif t == "TERNARY" or t == "TERNER":
            cond = expr.condition if hasattr(expr, "condition") else expr.kondisi
            self.compileExpr(cond)
            elseJump = self.emitJump(Op.JUMPIFFALSE)
            self.compileExpr(expr.thenVal)
            endJump = self.emitJump(Op.JUMP)
            self.patchJump(elseJump)
            self.compileExpr(expr.elseVal)
            self.patchJump(endJump)
        elif t == "LAMBDA":
            body = expr.body if hasattr(expr, "body") else expr.badan
            lambdaFn = VmFunction("<lambda>", expr.params)
            self.programFunctions.append(lambdaFn)

            parentCompiler = self.current
            fnCompiler = FnCompiler(parentCompiler, lambdaFn)
            self.current = fnCompiler
            self.currentFn = lambdaFn
            self.fnStack.append(parentCompiler.fn)

            self.beginScope()
            for p in expr.params:
                self.addLocal(p)
            if hasattr(body, "stmts"):
                self.compileBlock(body.stmts)
                self.emitOp(Op.RETURNNULL)
            elif hasattr(body, "type") or hasattr(body, "jenis"):
                self.compileExpr(body)
                self.emitOp(Op.RETURN)
            else:
                self.emitOp(Op.RETURNNULL)
            self.endScope()

            self.current = parentCompiler
            self.currentFn = parentCompiler.fn
            self.fnStack.pop()

            if len(lambdaFn.upvalues) > 0:
                fnIdx = self.addConstant(lambdaFn)
                self.emitOp(Op.MAKECLOSURE)
                self.emitU16(fnIdx)
                self.emitU16(len(lambdaFn.upvalues))
                for uv in lambdaFn.upvalues:
                    self.emitByte(1 if uv["isLocal"] else 0)
                    self.emitU16(uv["index"])
            else:
                self.emitConstant(lambdaFn)
        elif t == "LIST" or t == "LARIK":
            elements = expr.elements if hasattr(expr, "elements") else expr.elemen
            for el in elements:
                self.compileExpr(el)
            self.emitOp(Op.NEWARRAY)
            self.emitU16(len(elements))
        elif t == "MAP" or t == "PETA":
            keys = expr.keys if hasattr(expr, "keys") else expr.kunci
            values = expr.values if hasattr(expr, "values") else expr.nilai
            m = len(keys)
            k = 0
            while k < m:
                self.emitConstant(keys[k])
                self.compileExpr(values[k])
                k += 1
            self.emitOp(Op.NEWMAP)
            self.emitU16(m)
        elif t == "INDEX":
            self.compileExpr(expr.target)
            self.compileExpr(expr.index)
            self.emitOp(Op.GETINDEX)
        elif t == "SLICE" or t == "IRISAN":
            self.compileExpr(expr.target)
            start = expr.start if hasattr(expr, "start") else expr.awal
            stop = expr.stop if hasattr(expr, "stop") else expr.sampai
            self.compileExpr(start)
            self.compileExpr(stop)
            self.emitOp(Op.SLICE)
        elif t == "MEMBER" or t == "AKSES_ANGGOTA":
            target = expr.target if hasattr(expr, "target") else expr.target
            name = expr.name if hasattr(expr, "name") else expr.nama
            self.compileExpr(target)
            fIdx = self.addConstant(name)
            self.emitOp(Op.GETFIELD)
            self.emitU16(fIdx)
        elif t == "ASSIGN" or t == "TUGAS":
            target = expr.target if hasattr(expr, "target") else expr.target
            val = expr.value if hasattr(expr, "value") else expr.nilai
            targetType = self.nodeType(target)
            if targetType == "IDENT" or targetType == "PENGENAL":
                name = target.name if hasattr(target, "name") else target.nama
                if expr.op == "=":
                    self.compileExpr(val)
                    self.compileIdentSet(name)
                else:
                    self.compileIdentGet(name)
                    self.compileExpr(val)
                    bop = expr.op[0]
                    if bop == "+":
                        self.emitOp(Op.ADD)
                    elif bop == "-":
                        self.emitOp(Op.SUB)
                    elif bop == "*":
                        self.emitOp(Op.MUL)
                    elif bop == "/":
                        self.emitOp(Op.DIV)
                    self.compileIdentSet(name)
            elif targetType == "INDEX":
                self.compileExpr(target.target)
                self.compileExpr(target.index)
                self.compileExpr(val)
                self.emitOp(Op.SETINDEX)
            elif targetType == "MEMBER" or targetType == "AKSES_ANGGOTA":
                mTarget = target.target if hasattr(target, "target") else target.target
                mName = target.name if hasattr(target, "name") else target.nama
                self.compileExpr(mTarget)
                self.compileExpr(val)
                fIdx = self.addConstant(mName)
                self.emitOp(Op.SETFIELD)
                self.emitU16(fIdx)

    func compileIdentGet(self, name):
        slot = self.resolveLocal(name)
        if slot != -1:
            self.emitOp(Op.GETLOCAL)
            self.emitU16(slot)
            return None
        upIdx = self.resolveUpvalue(name)
        if upIdx != -1:
            self.emitOp(Op.GETUPVALUE)
            self.emitU16(upIdx)
            return None
        cIdx = self.addConstant(name)
        self.emitOp(Op.GETGLOBAL)
        self.emitU16(cIdx)

    func compileIdentSet(self, name):
        slot = self.resolveLocal(name)
        if slot != -1:
            self.emitOp(Op.SETLOCAL)
            self.emitU16(slot)
            return None
        upIdx = self.resolveUpvalue(name)
        if upIdx != -1:
            self.emitOp(Op.SETUPVALUE)
            self.emitU16(upIdx)
            return None
        if self.current.enclosing != None:
            if name in self.globalNames:
                cIdx = self.addConstant(name)
                self.emitOp(Op.SETGLOBAL)
                self.emitU16(cIdx)
                return None
            slot = self.addLocal(name)
            self.emitOp(Op.SETLOCAL)
            self.emitU16(slot)
            return None
        self.globalNames[name] = True
        cIdx = self.addConstant(name)
        self.emitOp(Op.SETGLOBAL)
        self.emitU16(cIdx)

func makeLazyRange(a, b = None, c = None):
    start = 0
    stop = 0
    step = 1
    if b == None:
        stop = a
    elif c == None:
        start = a
        stop = b
    else:
        start = a
        stop = b
        step = c
    if step == 0:
        lempar "range() arg 3 must not be zero"
    return {"isRange": True, "start": start, "stop": stop, "step": step}

func nusaLen(x):
    if (type(x) == "peta" or type(x) == "dict") and "isRange" in x:
        start = x["start"]
        stop = x["stop"]
        step = x["step"]
        if step > 0:
            return 0 if start >= stop else (stop - start + step - 1) // step
        else:
            return 0 if start <= stop else (start - stop - step - 1) // (-step)
    return panjang(x)

func nusaStr(x):
    if (type(x) == "peta" or type(x) == "dict") and "isRange" in x:
        if x["step"] == 1:
            return "range(" + str(x["start"]) + ", " + str(x["stop"]) + ")"
        return "range(" + str(x["start"]) + ", " + str(x["stop"]) + ", " + str(x["step"]) + ")"
    return str(x)

func nusaList(arg = None):
    if arg == None:
        return []
    if (type(arg) == "peta" or type(arg) == "dict") and "isRange" in arg:
        start = arg["start"]
        stop = arg["stop"]
        step = arg["step"]
        count = 0
        if step > 0 and stop > start:
            count = (stop - start + step - 1) // step
        elif step < 0 and start > stop:
            count = (start - stop - step - 1) // (-step)
        if count > 10000000:
            lempar "rentang(): terlalu besar untuk dialokasikan sebagai list"
        res = []
        cur = start
        if step > 0:
            while cur < stop:
                res.append(cur)
                cur += step
        else:
            while cur > stop:
                res.append(cur)
                cur += step
        return res
    res = []
    for item in arg:
        res.append(item)
    return res

class VmRunner:
    func __init__(self):
        self.stack = []
        self.frames = []
        self.frame = None
        self.globals = {}
        self.registerBuiltins()

    func registerBuiltins(self):
        self.globals["print"] = print
        self.globals["cetak"] = cetak
        self.globals["len"] = nusaLen
        self.globals["panjang"] = nusaLen
        self.globals["str"] = nusaStr
        self.globals["ke_teks"] = nusaStr
        self.globals["int"] = int
        self.globals["float"] = float
        self.globals["ke_angka"] = ke_angka
        self.globals["type"] = type
        self.globals["tipe"] = tipe
        self.globals["range"] = makeLazyRange
        self.globals["rentang"] = makeLazyRange
        self.globals["list"] = nusaList
        self.globals["larik"] = nusaList
        self.globals["map"] = lambda: {}
        self.globals["peta"] = lambda: {}
        self.globals["PetaBaru"] = peta_baru
        self.globals["petaBaru"] = peta_baru
        self.globals["peta_baru"] = peta_baru
        self.globals["newMap"] = peta_baru
        self.globals["readFile"] = baca_file
        self.globals["baca_file"] = baca_file
        self.globals["writeFile"] = tulis_file
        self.globals["tulis_file"] = tulis_file
        self.globals["fileExists"] = file_ada
        self.globals["file_ada"] = file_ada
        self.globals["import"] = runtimeImpor
        self.globals["impor"] = runtimeImpor
        self.globals["time"] = waktu
        self.globals["waktu"] = waktu
        self.globals["gcInfo"] = gc_info
        self.globals["gc_info"] = gc_info
        self.globals["gcForce"] = gc_paksa
        self.globals["gc_paksa"] = gc_paksa
        self.globals["env"] = ambil_env
        self.globals["ambil_env"] = ambil_env
        self.globals["push"] = tambah
        self.globals["tambah"] = tambah
        self.globals["pop"] = hapus_akhir
        self.globals["hapus_akhir"] = hapus_akhir
        self.globals["split"] = pisah
        self.globals["pisah"] = pisah
        self.globals["join"] = gabung
        self.globals["gabung"] = gabung
        self.globals["runCommand"] = jalankan_perintah
        self.globals["JalankanPerintah"] = jalankan_perintah
        self.globals["jalankanPerintah"] = jalankan_perintah
        self.globals["callable"] = callable
        self.globals["input"] = input
        self.globals["sys"] = sys

    func callBuiltin(self, fn, args):
        nA = len(args)
        if nA == 0:
            return fn()
        elif nA == 1:
            return fn(args[0])
        elif nA == 2:
            return fn(args[0], args[1])
        elif nA == 3:
            return fn(args[0], args[1], args[2])
        elif nA == 4:
            return fn(args[0], args[1], args[2], args[3])
        return fn(*args)

    func panggilBawaan(self, fn, args):
        return self.callBuiltin(fn, args)

    func push(self, val):
        self.stack.append(val)

    func pop(self):
        if len(self.stack) == 0:
            return None
        return self.stack.pop()

    func readByte(self):
        b = self.frame.fn.code[self.frame.ip]
        self.frame.ip += 1
        return b

    func readU16(self):
        b1 = self.frame.fn.code[self.frame.ip]
        b2 = self.frame.fn.code[self.frame.ip + 1]
        self.frame.ip += 2
        return b1 | (b2 << 8)

    func truthy(self, val):
        if val == None or val == False or val == 0 or val == "":
            return False
        return True

    func resolveMethodChainVm(self, clsObj, name):
        cur = clsObj
        while cur != None:
            mMap = cur.methods if hasattr(cur, "methods") else cur.metode
            if name in mMap:
                return mMap[name]
            parentName = cur.baseClass if hasattr(cur, "baseClass") else None
            if parentName == None:
                return None
            cur = self.globals[parentName] if parentName in self.globals else None
        return None

    func resolveInitVm(self, clsObj):
        for candidate in ["__init__", "constructor", "konstruktor"]:
            m = self.resolveMethodChainVm(clsObj, candidate)
            if m != None:
                return m
        return None

    func handleException(self, val):
        while len(self.frames) > 0:
            f = self.frames[-1]
            if len(f.handlers) > 0:
                entry = f.handlers.pop()
                self.stack = self.stack[:entry[1]]
                self.push(val)
                f.ip = entry[0]
                self.frame = f
                return True
            self.frames.pop()
            if len(self.frames) > 0:
                self.frame = self.frames[-1]
        return False

    func run(self, topFn):
        initFrame = CallFrame(topFn, [])
        self.frames = [initFrame]
        self.frame = initFrame
        self.stack = []

        opConst = Op.CONST
        opAdd = Op.ADD
        opSub = Op.SUB
        opEq = Op.EQ
        opLt = Op.LT
        opLte = Op.LTE
        opGt = Op.GT
        opGte = Op.GTE
        opPop = Op.POP
        opGetLocal = Op.GETLOCAL
        opSetLocal = Op.SETLOCAL
        opDefineLocal = Op.DEFINELOCAL
        opGetGlobal = Op.GETGLOBAL
        opSetGlobal = Op.SETGLOBAL
        opJump = Op.JUMP
        opJumpIfFalse = Op.JUMPIFFALSE
        opLoop = Op.LOOP
        opGetIndex = Op.GETINDEX
        opIncLocal = Op.INCLOCAL
        opGetUpvalue = Op.GETUPVALUE
        opSetUpvalue = Op.SETUPVALUE
        globalVars = self.globals

        while len(self.frames) > 0:
            try:
                frame = self.frame
                fnObj = frame.fn
                code = fnObj.code
                consts = fnObj.constants
                slots = frame.locals
                stack = self.stack
                ip = frame.ip
                codeLen = len(code)
                op = -1
                cold = False

                if frame.hasCells and ip < codeLen:
                    op = code[ip]
                    ip += 1
                    cold = True

                while not cold and ip < codeLen:
                    op = code[ip]
                    ip += 1
                    if op == opGetLocal:
                        stack.append(slots[code[ip] | (code[ip + 1] << 8)])
                        ip += 2
                    elif op == opGetUpvalue:
                        uIdx = code[ip] | (code[ip + 1] << 8)
                        stack.append(frame.closure.upvalues[uIdx].val)
                        ip += 2
                    elif op == opSetUpvalue:
                        uIdx = code[ip] | (code[ip + 1] << 8)
                        if len(stack) > 0:
                            frame.closure.upvalues[uIdx].val = stack[-1]
                        ip += 2
                    elif op == opConst:
                        stack.append(consts[code[ip] | (code[ip + 1] << 8)])
                        ip += 2
                    elif op == opSetLocal:
                        if len(stack) > 0:
                            slots[code[ip] | (code[ip + 1] << 8)] = stack[-1]
                        ip += 2
                    elif op == opAdd:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] + b
                    elif op == opSub:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] - b
                    elif op == opLt:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] < b
                    elif op == opLte:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] <= b
                    elif op == opGt:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] > b
                    elif op == opGte:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] >= b
                    elif op == opEq:
                        if len(stack) < 2:
                            cold = True
                            break
                        b = stack.pop()
                        stack[-1] = stack[-1] == b
                    elif op == opJumpIfFalse:
                        if len(stack) == 0:
                            cold = True
                            break
                        val = stack.pop()
                        if val == None or val == False or val == 0 or val == "":
                            ip += 2 + (code[ip] | (code[ip + 1] << 8))
                        else:
                            ip += 2
                    elif op == opLoop:
                        ip -= (code[ip] | (code[ip + 1] << 8)) - 2
                    elif op == opJump:
                        ip += 2 + (code[ip] | (code[ip + 1] << 8))
                    elif op == opIncLocal:
                        slot = code[ip] | (code[ip + 1] << 8)
                        slots[slot] = slots[slot] + 1
                        ip += 2
                    elif op == opPop:
                        if len(stack) > 0:
                            stack.pop()
                    elif op == opDefineLocal:
                        slots[code[ip] | (code[ip + 1] << 8)] = stack.pop() if len(stack) > 0 else None
                        ip += 2
                    elif op == opGetIndex:
                        if len(stack) < 2:
                            cold = True
                            break
                        idx = stack.pop()
                        target = stack[-1]
                        if (type(target) == "peta" or type(target) == "dict") and "isRange" in target:
                            stack[-1] = target["start"] + idx * target["step"]
                        else:
                            stack[-1] = target[idx]
                    elif op == opGetGlobal:
                        name = consts[code[ip] | (code[ip + 1] << 8)]
                        ip += 2
                        if name in globalVars:
                            stack.append(globalVars[name])
                        else:
                            print("RuntimeError: undefined variable '" + name + "'")
                            sys.exit(1)
                            stack.append(None)
                    elif op == opSetGlobal:
                        if len(stack) > 0:
                            globalVars[consts[code[ip] | (code[ip + 1] << 8)]] = stack[-1]
                        ip += 2
                    else:
                        cold = True
                        break

                frame.ip = ip
                if not cold:
                    op = -1

                if op == -1 and ip >= codeLen:
                    isInit = hasattr(self.frame, "isInit") and self.frame.isInit
                    retVal = self.frame.initInstance if isInit else None
                    self.frames.pop()
                    if len(self.frames) > 0:
                        self.frame = self.frames[-1]
                        self.push(retVal)
                    continue

                if op == Op.CONST:
                    idx = self.readU16()
                    self.push(self.frame.fn.constants[idx])
                elif op == Op.NULL:
                    self.push(None)
                elif op == Op.TRUE:
                    self.push(True)
                elif op == Op.FALSE:
                    self.push(False)
                elif op == Op.POP:
                    self.pop()
                elif op == Op.ADD:
                    b = self.pop()
                    a = self.pop()
                    if (type(a) == "larik" or type(a) == "list") and (type(b) == "larik" or type(b) == "list"):
                        res = []
                        for el in a:
                            res.append(el)
                        for el in b:
                            res.append(el)
                        self.push(res)
                    else:
                        self.push(a + b)
                elif op == Op.SUB:
                    b = self.pop()
                    a = self.pop()
                    self.push(a - b)
                elif op == Op.MUL:
                    b = self.pop()
                    a = self.pop()
                    if (type(a) == "string" or type(a) == "str" or type(a) == "teks") and (type(b) == "angka" or type(b) == "int"):
                        s = ""
                        cnt = int(b)
                        while cnt > 0:
                            s += a
                            cnt -= 1
                        self.push(s)
                    else:
                        self.push(a * b)
                elif op == Op.DIV:
                    b = self.pop()
                    a = self.pop()
                    if b == 0:
                        print("RuntimeError: Division by zero")
                        sys.exit(1)
                        self.push(0)
                    else:
                        self.push(a / b)
                elif op == Op.MOD:
                    b = self.pop()
                    a = self.pop()
                    self.push(a % b)
                elif op == Op.NEG:
                    a = self.pop()
                    self.push(-a)
                elif op == Op.NOT:
                    a = self.pop()
                    self.push(not self.truthy(a))
                elif op == Op.EQ:
                    b = self.pop()
                    a = self.pop()
                    self.push(a == b)
                elif op == Op.NEQ:
                    b = self.pop()
                    a = self.pop()
                    self.push(a != b)
                elif op == Op.LT:
                    b = self.pop()
                    a = self.pop()
                    self.push(a < b)
                elif op == Op.LTE:
                    b = self.pop()
                    a = self.pop()
                    self.push(a <= b)
                elif op == Op.GT:
                    b = self.pop()
                    a = self.pop()
                    self.push(a > b)
                elif op == Op.GTE:
                    b = self.pop()
                    a = self.pop()
                    self.push(a >= b)
                elif op == Op.IN:
                    b = self.pop()
                    a = self.pop()
                    self.push(a in b)
                elif op == Op.BITAND:
                    b = self.pop()
                    a = self.pop()
                    self.push(a & b)
                elif op == Op.BITOR:
                    b = self.pop()
                    a = self.pop()
                    self.push(a | b)
                elif op == Op.BITXOR:
                    b = self.pop()
                    a = self.pop()
                    self.push(a ^ b)
                elif op == Op.SHL:
                    b = self.pop()
                    a = self.pop()
                    self.push(a << b)
                elif op == Op.SHR:
                    b = self.pop()
                    a = self.pop()
                    self.push(a >> b)
                elif op == Op.BITNOT:
                    a = self.pop()
                    self.push(~a)
                elif op == Op.GETARGCOUNT:
                    self.push(self.frame.providedCount)
                elif op == Op.SUPER:
                    selfVal = self.frame.locals[0]
                    definingName = self.frame.fn.name.split(".")[0]
                    cls = self.globals[definingName] if definingName in self.globals else None
                    parentName = cls.baseClass if cls != None and hasattr(cls, "baseClass") else None
                    self.push({"isSuperProc": True, "self": selfVal, "parentName": parentName})
                elif op == Op.GETLOCAL:
                    slot = self.readU16()
                    if slot in self.frame.cells:
                        self.push(self.frame.cells[slot].val)
                    else:
                        self.push(self.frame.locals[slot])
                elif op == Op.SETLOCAL:
                    slot = self.readU16()
                    val = self.stack[-1]
                    self.frame.locals[slot] = val
                    if slot in self.frame.cells:
                        self.frame.cells[slot].val = val
                elif op == Op.DEFINELOCAL:
                    slot = self.readU16()
                    val = self.pop()
                    self.frame.locals[slot] = val
                    if slot in self.frame.cells:
                        self.frame.cells[slot].val = val
                elif op == Op.INCLOCAL:
                    slot = self.readU16()
                    val = (self.frame.cells[slot].val if slot in self.frame.cells else self.frame.locals[slot]) + 1
                    self.frame.locals[slot] = val
                    if slot in self.frame.cells:
                        self.frame.cells[slot].val = val
                elif op == Op.DECLOCAL:
                    slot = self.readU16()
                    val = (self.frame.cells[slot].val if slot in self.frame.cells else self.frame.locals[slot]) - 1
                    self.frame.locals[slot] = val
                    if slot in self.frame.cells:
                        self.frame.cells[slot].val = val
                elif op == Op.ADDLOCAL:
                    slot = self.readU16()
                    cIdx = self.readU16()
                    delta = self.frame.fn.constants[cIdx]
                    val = (self.frame.cells[slot].val if slot in self.frame.cells else self.frame.locals[slot]) + delta
                    self.frame.locals[slot] = val
                    if slot in self.frame.cells:
                        self.frame.cells[slot].val = val
                elif op == Op.GETUPVALUE:
                    idx = self.readU16()
                    self.push(self.frame.closure.upvalues[idx].val)
                elif op == Op.SETUPVALUE:
                    idx = self.readU16()
                    self.frame.closure.upvalues[idx].val = self.stack[-1]
                elif op == Op.MAKECLOSURE:
                    fnIdx = self.readU16()
                    targetFn = self.frame.fn.constants[fnIdx]
                    closure = VmClosure(targetFn)
                    uvCount = self.readU16()
                    k = 0
                    while k < uvCount:
                        isLocal = self.readByte()
                        index = self.readU16()
                        if isLocal == 1:
                            if index not in self.frame.cells:
                                self.frame.cells[index] = VmCell(self.frame.locals[index])
                                self.frame.hasCells = True
                            closure.upvalues.append(self.frame.cells[index])
                        else:
                            closure.upvalues.append(self.frame.closure.upvalues[index])
                        k += 1
                    self.push(closure)
                elif op == Op.TOITER:
                    val = self.pop()
                    if (type(val) == "peta" or type(val) == "dict") and "isRange" in val:
                        self.push(val)
                    elif type(val) == "peta" or type(val) == "dict":
                        self.push(list(val.keys()))
                    elif type(val) == "larik" or type(val) == "list":
                        self.push(val)
                    elif type(val) == "string" or type(val) == "str" or type(val) == "teks":
                        self.push(val)
                    else:
                        res = []
                        for x in val:
                            res.append(x)
                        self.push(res)
                elif op == Op.TOSTRING:
                    val = self.pop()
                    if (type(val) == "peta" or type(val) == "dict") and "isRange" in val:
                        if val["step"] == 1:
                            self.push("range(" + str(val["start"]) + ", " + str(val["stop"]) + ")")
                        else:
                            self.push("range(" + str(val["start"]) + ", " + str(val["stop"]) + ", " + str(val["step"]) + ")")
                    else:
                        self.push(str(val))
                elif op == Op.GETGLOBAL:
                    idx = self.readU16()
                    name = self.frame.fn.constants[idx]
                    if name in self.globals:
                        self.push(self.globals[name])
                    else:
                        print("RuntimeError: undefined variable '" + name + "'")
                        sys.exit(1)
                        self.push(None)
                elif op == Op.SETGLOBAL:
                    idx = self.readU16()
                    name = self.frame.fn.constants[idx]
                    self.globals[name] = self.stack[-1]
                elif op == Op.DEFINEGLOBAL:
                    idx = self.readU16()
                    name = self.frame.fn.constants[idx]
                    self.globals[name] = self.pop()
                elif op == Op.JUMP:
                    off = self.readU16()
                    self.frame.ip += off
                elif op == Op.JUMPIFFALSE:
                    off = self.readU16()
                    val = self.pop()
                    if not self.truthy(val):
                        self.frame.ip += off
                elif op == Op.JUMPIFFALSEKEEP:
                    off = self.readU16()
                    if not self.truthy(self.stack[-1]):
                        self.frame.ip += off
                elif op == Op.JUMPIFTRUEKEEP:
                    off = self.readU16()
                    if self.truthy(self.stack[-1]):
                        self.frame.ip += off
                elif op == Op.LOOP:
                    off = self.readU16()
                    self.frame.ip -= off
                elif op == Op.PRINT:
                    argCount = self.readByte()
                    args = []
                    k = 0
                    while k < argCount:
                        args.append(self.pop())
                        k += 1
                    args.reverse()
                    print(*args)
                    self.push(None)
                elif op == Op.LENGTH:
                    val = self.pop()
                    if (type(val) == "peta" or type(val) == "dict") and "isRange" in val:
                        start = val["start"]
                        stop = val["stop"]
                        step = val["step"]
                        if step > 0:
                            self.push(0 if start >= stop else (stop - start + step - 1) // step)
                        else:
                            self.push(0 if start <= stop else (start - stop - step - 1) // (-step))
                    else:
                        self.push(len(val))
                elif op == Op.PUSH:
                    val = self.pop()
                    target = self.pop()
                    target.append(val)
                    self.push(len(target))
                elif op == Op.NEWARRAY:
                    cnt = self.readU16()
                    if cnt == 0:
                        self.push([])
                    else:
                        elems = self.stack[-cnt:]
                        self.stack = self.stack[:-cnt]
                        self.push(elems)
                elif op == Op.NEWMAP:
                    cnt = self.readU16()
                    m = {}
                    k = 0
                    while k < cnt:
                        v = self.pop()
                        kKey = self.pop()
                        m[kKey] = v
                        k += 1
                    self.push(m)
                elif op == Op.GETINDEX:
                    idx = self.pop()
                    target = self.pop()
                    if (type(target) == "peta" or type(target) == "dict") and "isRange" in target:
                        self.push(target["start"] + idx * target["step"])
                    else:
                        self.push(target[idx])
                elif op == Op.SETINDEX:
                    val = self.pop()
                    idx = self.pop()
                    target = self.pop()
                    target[idx] = val
                    self.push(val)
                elif op == Op.SLICE:
                    stop = self.pop()
                    start = self.pop()
                    target = self.pop()
                    if start == None:
                        start = 0
                    if stop == None:
                        stop = len(target)
                    self.push(target[start:stop])
                elif op == Op.GETFIELD:
                    nameIdx = self.readU16()
                    name = self.frame.fn.constants[nameIdx]
                    target = self.pop()
                    if isinstance(target, dict) and "isSuperProc" in target:
                        parentName = target["parentName"]
                        parentCls = self.globals[parentName] if parentName != None and parentName in self.globals else None
                        m = self.resolveMethodChainVm(parentCls, name) if parentCls != None else None
                        if m != None:
                            self.push({"isMethod": True, "instance": target["self"], "method": m})
                        else:
                            print("RuntimeError: super has no method '" + name + "'")
                            sys.exit(1)
                            self.push(None)
                    elif hasattr(target, "fields"):
                        f = target.fields
                        if name in f:
                            self.push(f[name])
                        else:
                            m = None
                            if hasattr(target, "cls"):
                                m = self.resolveMethodChainVm(target.cls, name)
                            elif hasattr(target, "kelas"):
                                m = self.resolveMethodChainVm(target.kelas, name)
                            if m != None:
                                self.push({"isMethod": True, "instance": target, "method": m})
                            else:
                                print("RuntimeError: Field '" + name + "' not found")
                                sys.exit(1)
                                self.push(None)
                    elif type(target) == "peta" or type(target) == "dict":
                        if name in target and callable(target[name]):
                            self.push(target[name])
                        elif name == "get" or name == "ambil":
                            self.push(lambda k, d = None: target[k] if k in target else d)
                        elif name == "keys" or name == "kunci":
                            self.push(lambda: list(target.keys()))
                        elif name == "values" or name == "nilai":
                            self.push(lambda: list(target.values()))
                        elif name in target:
                            self.push(target[name])
                        else:
                            print("RuntimeError: Field '" + name + "' not found")
                            sys.exit(1)
                            self.push(None)
                    elif hasattr(target, name):
                        self.push(getattr(target, name))
                    else:
                        print("RuntimeError: Field '" + name + "' not found")
                        sys.exit(1)
                        self.push(None)
                elif op == Op.SETFIELD:
                    nameIdx = self.readU16()
                    name = self.frame.fn.constants[nameIdx]
                    val = self.pop()
                    target = self.pop()
                    if hasattr(target, "fields"):
                        target.fields[name] = val
                    elif type(target) == "peta" or type(target) == "dict":
                        target[name] = val
                    elif hasattr(target, "bidang"):
                        target.bidang[name] = val
                    elif hasattr(target, name):
                        setattr(target, name, val)
                    self.push(val)
                elif op == Op.CALLMETHOD:
                    nameIdx = self.readU16()
                    name = self.frame.fn.constants[nameIdx]
                    argCount = self.readByte()
                    if argCount == 0:
                        callArgs = []
                    else:
                        callArgs = self.stack[-argCount:]
                        self.stack = self.stack[:-argCount]
                    target = self.pop()

                    if isinstance(target, dict) and "isSuperProc" in target:
                        parentName = target["parentName"]
                        parentCls = self.globals[parentName] if parentName != None and parentName in self.globals else None
                        m = self.resolveMethodChainVm(parentCls, name) if parentCls != None else None
                        if m != None:
                            newFrame = CallFrame(m, [target["self"]] + callArgs)
                            self.frames.append(newFrame)
                            self.frame = newFrame
                            continue
                        print("RuntimeError: super has no method '" + name + "'")
                        sys.exit(1)
                        self.push(None)
                        continue
                    if hasattr(target, "cls"):
                        m = self.resolveMethodChainVm(target.cls, name)
                        if m != None:
                            if hasattr(m, "isClosure"):
                                newFrame = CallFrame(m.fn, [target] + callArgs, m)
                            else:
                                newFrame = CallFrame(m, [target] + callArgs)
                            self.frames.append(newFrame)
                            self.frame = newFrame
                            continue
                    if hasattr(target, "kelas"):
                        m = self.resolveMethodChainVm(target.kelas, name)
                        if m != None:
                            if hasattr(m, "isClosure"):
                                newFrame = CallFrame(m.fn, [target] + callArgs, m)
                            else:
                                newFrame = CallFrame(m, [target] + callArgs)
                            self.frames.append(newFrame)
                            self.frame = newFrame
                            continue
                    if tipe(target) == "teks" or tipe(target) == "string" or type(target) == "str":
                        if name == "strip":
                            self.push(target.strip())
                            continue
                        elif name == "lower":
                            self.push(target.lower())
                            continue
                        elif name == "upper":
                            self.push(target.upper())
                            continue
                        elif name == "split":
                            sep = callArgs[0] if len(callArgs) > 0 else " "
                            self.push(target.split(sep))
                            continue
                        elif name == "startswith":
                            self.push(target.startswith(callArgs[0]))
                            continue
                        elif name == "endswith":
                            self.push(target.endswith(callArgs[0]))
                            continue
                        elif name == "find":
                            self.push(target.find(callArgs[0]))
                            continue
                    if tipe(target) == "peta" or type(target) == "dict":
                        if name in target and callable(target[name]):
                            fnTarget = target[name]
                            res = self.callBuiltin(fnTarget, callArgs)
                            self.push(res)
                            continue
                        elif name == "get" or name == "ambil":
                            k = callArgs[0] if len(callArgs) > 0 else None
                            d = callArgs[1] if len(callArgs) > 1 else None
                            self.push(target[k] if k in target else d)
                            continue
                        elif name == "keys" or name == "kunci":
                            self.push(list(target.keys()))
                            continue
                        elif name == "values" or name == "nilai":
                            self.push(list(target.values()))
                            continue
                        elif name == "items":
                            res = []
                            for k in target:
                                res.append([k, target[k]])
                            self.push(res)
                            continue
                    if hasattr(target, name):
                        fnTarget = getattr(target, name)
                        res = self.callBuiltin(fnTarget, callArgs)
                        self.push(res)
                    else:
                        print("RuntimeError: Method '" + name + "' not found")
                        sys.exit(1)
                        self.push(None)
                elif op == Op.CALL:
                    argCount = self.readByte()
                    if argCount == 0:
                        callArgs = []
                    else:
                        callArgs = self.stack[-argCount:]
                        self.stack = self.stack[:-argCount]
                    callee = self.pop()

                    if hasattr(callee, "isClosure"):
                        newFrame = CallFrame(callee.fn, callArgs, callee)
                        self.frames.append(newFrame)
                        self.frame = newFrame
                    elif hasattr(callee, "code"):
                        newFrame = CallFrame(callee, callArgs)
                        self.frames.append(newFrame)
                        self.frame = newFrame
                    elif isinstance(callee, dict) and "isMethod" in callee:
                        inst = callee["instance"]
                        mFn = callee["method"]
                        callArgs.insert(0, inst)
                        if hasattr(mFn, "isClosure"):
                            newFrame = CallFrame(mFn.fn, callArgs, mFn)
                        else:
                            newFrame = CallFrame(mFn, callArgs)
                        self.frames.append(newFrame)
                        self.frame = newFrame
                    elif hasattr(callee, "isClass") or hasattr(callee, "isKelas"):
                        inst = VmInstance(callee)
                        initFn = self.resolveInitVm(callee)
                        if initFn != None:
                            initArgs = [inst]
                            for a in callArgs:
                                initArgs.append(a)
                            if hasattr(initFn, "isClosure"):
                                newFrame = CallFrame(initFn.fn, initArgs, initFn)
                            else:
                                newFrame = CallFrame(initFn, initArgs)
                            newFrame.isInit = True
                            newFrame.initInstance = inst
                            self.frames.append(newFrame)
                            self.frame = newFrame
                        else:
                            self.push(inst)
                    elif callable(callee):
                        res = self.callBuiltin(callee, callArgs)
                        self.push(res)
                    else:
                        print("RuntimeError: Object is not callable:", callee)
                        sys.exit(1)
                        self.push(None)
                elif op == Op.RETURN:
                    val = self.pop()
                    isInit = hasattr(self.frame, "isInit") and self.frame.isInit
                    retVal = self.frame.initInstance if isInit else val
                    self.frames.pop()
                    if len(self.frames) == 0:
                        return retVal
                    self.frame = self.frames[-1]
                    self.push(retVal)
                elif op == Op.RETURNNULL:
                    isInit = hasattr(self.frame, "isInit") and self.frame.isInit
                    retVal = self.frame.initInstance if isInit else None
                    self.frames.pop()
                    if len(self.frames) == 0:
                        return retVal
                    self.frame = self.frames[-1]
                    self.push(retVal)
                elif op == Op.THROW:
                    val = self.pop()
                    if not self.handleException(val):
                        raise val
                elif op == Op.TRYSTART:
                    off = self.readU16()
                    target = self.frame.ip + off
                    self.frame.handlers.append([target, len(self.stack)])
                elif op == Op.TRYEND:
                    if len(self.frame.handlers) > 0:
                        self.frame.handlers.pop()
            except e:
                if not self.handleException(e):
                    raise e
        if len(self.stack) > 0:
            return self.pop()
        return None

    func jalankan(self, topFn):
        return self.run(topFn)
