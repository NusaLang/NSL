import sys

func loadMod(name):
    try:
        return impor(name)
    except e:
        return impor("core/" + name)

Lexer = loadMod("lexer").Lexer
Parser = loadMod("parser").Parser
Interpreter = loadMod("interpreter").Interpreter
VmCompiler = loadMod("vm").VmCompiler
VmRunner = loadMod("vm").VmRunner
JalankanPerintah = jalankan_perintah

USAGE = """usage: nusa [options] [-c code | -m module | file | -] [args]
  -c code      run code from the command line
  -m module    run a module by name
  -            read the program from stdin
  -i           open a REPL after running
  -q           no REPL banner
  -x           skip the first line of the source
  -k, --check  parse only
  --vm         run on the bytecode VM
  --tokens     dump tokens before running
  --ast        dump the AST before running
  -V, --version
  -h, --help
  build [dir|file] [-o out] [--native]   bundle a program into script or native binary
  run file                    same as passing the file directly
  repl"""

func fail(msg):
    print("nusa: " + msg)
    sys.exit(1)

func parse(src, tokens = False, ast = False):
    toks = Lexer(src).tokenize()
    if tokens:
        for t in toks:
            print(t)
    tree = Parser(toks).parse()
    if ast:
        print(tree)
    return tree

func exec(src, vm, tokens, ast, runtime = None):
    tree = parse(src, tokens, ast)
    if vm:
        VmRunner().run(VmCompiler().compile(tree))
        return None
    if runtime == None:
        runtime = Interpreter()
    runtime.run(tree)
    return runtime

func readSource(path, skipFirst):
    if not file_ada(path):
        fail("cannot open " + path)
    src = baca_file(path)
    if skipFirst or src.startswith("#!"):
        nl = src.find("\n")
        if nl != -1:
            src = src[nl + 1:]
    return src

func guarded(fn):
    try:
        return fn()
    except e:
        fail(str(e))

func findModule(name):
    for c in [name, name + ".ns", name + "/main.ns", "std/" + name + ".ns", "core/" + name + ".ns", "lib/" + name + ".ns"]:
        if file_ada(c):
            return c
    fail("no module named " + name)

func readStdin():
    if file_ada("/dev/stdin"):
        return baca_file("/dev/stdin")
    lines = []
    while True:
        try:
            lines.append(input())
        except e:
            break
    return "\n".join(lines)

func repl(runtime, banner):
    if banner:
        print("nusa 0.0.2-rc1 - type exit to quit")
    if runtime == None:
        runtime = Interpreter()
    buf = ""
    while True:
        try:
            line = input("... " if len(buf) > 0 else ">>> ")
        except e:
            print("")
            break
        if line == "exit" or line == "exit()" or line == "quit()":
            break
        if line.endswith(":") or (len(buf) > 0 and line != ""):
            buf = buf + line + "\n"
            continue
        code = buf if len(buf) > 0 else line
        buf = ""
        if code == "":
            continue
        try:
            runtime.run(parse(code))
        except e:
            print("error: " + str(e))

func build(args):
    target = "."
    out = ""
    isNative = False
    i = 2
    while i < len(args):
        if (args[i] == "-o" or args[i] == "--output") and i + 1 < len(args):
            out = args[i + 1]
            i += 2
        elif args[i] == "-n" or args[i] == "--native":
            isNative = True
            i += 1
        else:
            if target == ".":
                target = args[i]
            i += 1

    entry = target
    if not target.endswith(".ns"):
        entry = ""
        for c in [target + "/main.ns", target + "/core/main.ns"]:
            if file_ada(c):
                entry = c
                break
        if entry == "":
            fail("no main.ns in " + target)
        if out == "":
            out = "a.out" if target == "." else target
    elif not file_ada(entry):
        fail("cannot open " + entry)
    elif out == "":
        out = entry[:len(entry) - 3]

    src = baca_file(entry)
    tree = guarded(lambda: parse(src))
    if isNative:
        nativeMod = None
        try:
            nativeMod = impor("../compiler/native.ns")
        except e:
            try:
                nativeMod = impor("compiler/native.ns")
            except e2:
                nativeMod = impor("native")
        NativeCompiler = nativeMod.NativeCompiler
        asm = NativeCompiler().compile(tree)
        asmPath = out + ".s"
        objPath = out + ".o"
        tulis_file(asmPath, asm)
        JalankanPerintah("as", ["-o", objPath, asmPath])
        JalankanPerintah("ld", ["-o", out, objPath])
        JalankanPerintah("rm", ["-f", objPath, asmPath])
    else:
        tulis_file(out, "#!/usr/bin/env nusa\n" + src)
        JalankanPerintah("chmod", ["+x", out])

func main():
    args = sys.argv
    n = len(args)
    inspect = False
    quiet = False
    skipFirst = False
    vm = False
    tokens = False
    ast = False
    mode = ""
    arg = ""
    rest = []

    i = 1
    while i < n and mode == "":
        a = args[i]
        if a == "-h" or a == "--help" or a == "help":
            print(USAGE)
            sys.exit(0)
        elif a == "-V" or a == "--version" or a == "version":
            print("nusa 0.0.2-rc1")
            sys.exit(0)
        elif a == "build":
            build(args)
            sys.exit(0)
        elif a == "repl":
            mode = "repl"
        elif a == "run" or a == "-m" or a == "-c" or a == "-e" or a == "--eval" or a == "-k" or a == "--check":
            if i + 1 >= n:
                fail(a + " needs an argument")
            arg = args[i + 1]
            rest = args[i + 1:]
            mode = {"run": "file", "-m": "module", "-c": "eval", "-e": "eval", "--eval": "eval", "-k": "check", "--check": "check"}[a]
            if mode == "eval" or mode == "module":
                rest = [a] + args[i + 2:]
        elif a == "-":
            mode = "stdin"
            rest = args[i:]
        elif a == "--vm":
            vm = True
        elif a == "--tokens":
            tokens = True
        elif a == "--ast":
            ast = True
        elif a == "-i":
            inspect = True
        elif a == "-q":
            quiet = True
        elif a == "-x":
            skipFirst = True
        elif a.startswith("-") and len(a) > 1:
            fail("unknown option " + a)
        else:
            mode = "file"
            arg = a
            rest = args[i:]
        i += 1

    if len(rest) > 0:
        sys.argv = rest

    runtime = None
    if mode == "file":
        runtime = guarded(lambda: exec(readSource(arg, skipFirst), vm, tokens, ast))
    elif mode == "eval":
        runtime = guarded(lambda: exec(arg, vm, tokens, ast))
    elif mode == "module":
        runtime = guarded(lambda: exec(readSource(findModule(arg), skipFirst), vm, tokens, ast))
    elif mode == "stdin":
        runtime = guarded(lambda: exec(readStdin(), vm, tokens, ast))
    elif mode == "check":
        guarded(lambda: parse(readSource(arg, False)))
        sys.exit(0)
    else:
        repl(None, not quiet)
        sys.exit(0)

    if inspect:
        repl(runtime, not quiet)

main()
