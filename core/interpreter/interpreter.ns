func loadModule(name):
    base = name if name.endswith(".ns") else name + ".ns"
    candidates = [
        name,
        base,
        "../" + name,
        "../" + base,
        "core/" + name,
        "core/" + base,
        "core/interpreter/" + name,
        "core/interpreter/" + base
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor(name)

Scope = loadModule("env").Scope
Lexer = loadModule("parser/lexer").Lexer
Parser = loadModule("parser/parser").Parser
resolverModule = loadModule("resolver")
resolveModuleFile = resolverModule.resolveModuleFile
isStdlibFile = resolverModule.isStdlibFile
directoryOf = resolverModule.directoryOf
scriptDirectory = resolverModule.scriptDirectory

# The statement being run, so errors can say where they happened.
lineState = {"line": 0, "file": ""}

func rtError(msg):
    err = {"pesan": msg, "line": lineState["line"], "file": lineState["file"]}
    lempar err

# Statements hand back None, or one of these when control leaves them.
class ReturnSignal:
    func __init__(self, val):
        self.kind = 3
        self.val = val

class LoopSignal:
    func __init__(self, kind):
        self.kind = kind

BREAKSIGNAL = LoopSignal(1)
CONTINUESIGNAL = LoopSignal(2)

class UserFunction:
    func __init__(self, name, params, body, closure, defaults = None, restName = None, kwName = None):
        self.isFunction = True
        self.file = lineState["file"]
        self.restName = restName
        self.kwName = kwName
        self.name = name
        self.params = params
        self.body = body
        self.closure = closure
        self.defaults = defaults if defaults != None else {}

func makeMethodCaller(target, name):
    func caller(*items):
        return hostCallMethod(target, name, items)
    return caller

# Errors raised inside the host engine arrive as a map whose `pesan` carries a
# call trace. Cut the trace so they look like the runtime's own errors.
func cleanErrorText(text):
    cut = text.find("\n  di dalam")
    fromHost = cut >= 0 or text.startswith("nusantara: error: ")
    if cut >= 0:
        text = text[:cut]
    if not fromHost:
        return text
    pos = text.rfind(" (line ")
    if pos >= 0 and text.endswith(")"):
        text = text[:pos]
    if text.startswith("nusantara: error: "):
        text = text[18:]
    return text

func normalizeError(e):
    if tipe(e) == "peta" and "pesan" in e and tipe(e["pesan"]) == "teks":
        cleaned = cleanErrorText(e["pesan"])
        if cleaned != e["pesan"]:
            return {"pesan": cleaned}
    elif tipe(e) == "teks":
        cleaned = cleanErrorText(e)
        if cleaned != e:
            return {"pesan": cleaned}
    return e

# Errors raised by the runtime are plain maps; this says which builtin
# exception class names they count as for `catch Name`.
func runtimeErrorMatches(text, name):
    if name == "Exception" or name == "BaseException" or name == "RuntimeError":
        return True
    if name == "ValueError":
        return text == "invalid number"
    if name == "ZeroDivisionError" or name == "ArithmeticError":
        return text == "division by zero"
    if name == "IndexError" or name == "LookupError":
        return text == "index out of range"
    if name == "NameError":
        return text.startswith("undefined variable")
    if name == "TypeError":
        return text.startswith("value is not callable") or text.startswith("Tipe ")
    return False

EXCEPTIONSOURCE = """class BaseException:
    func __init__(self, pesan = "", detail = None):
        self.pesan = pesan
        self.detail = detail
    func __str__(self):
        return str(self.pesan)
class Exception(BaseException):
    pass
class RuntimeError(Exception):
    pass
class ValueError(Exception):
    pass
class TypeError(Exception):
    pass
class NameError(Exception):
    pass
class AttributeError(Exception):
    pass
class LookupError(Exception):
    pass
class IndexError(LookupError):
    pass
class KeyError(LookupError):
    pass
class ArithmeticError(Exception):
    pass
class ZeroDivisionError(ArithmeticError):
    pass
class NotImplementedError(RuntimeError):
    pass
class AssertionError(Exception):
    pass
class OSError(Exception):
    pass
class IOError(OSError):
    pass
class StopIteration(Exception):
    pass
"""

func newClass(name, parent):
    return {"isClass": True, "name": name, "parent": parent, "parentClass": None, "methods": {}, "attrs": {}, "statics": {}, "classMethods": {}, "props": {}, "setters": {}}

BINARYDUNDERS = {"+": "__add__", "-": "__sub__", "*": "__mul__", "/": "__truediv__", "//": "__floordiv__", "%": "__mod__", "**": "__pow__", "<": "__lt__", "<=": "__le__", ">": "__gt__", ">=": "__ge__", "&": "__and__", "|": "__or__", "^": "__xor__", "<<": "__lshift__", ">>": "__rshift__"}
REFLECTEDDUNDERS = {"+": "__radd__", "-": "__rsub__", "*": "__rmul__", "/": "__rtruediv__", "//": "__rfloordiv__", "%": "__rmod__"}

func isSignal(e):
    return hasattr(e, "isReturn") or hasattr(e, "isBreak") or hasattr(e, "isContinue")

func isRange(x):
    return tipe(x) == "peta" and "isRange" in x

func isInstance(x):
    return tipe(x) == "peta" and "isInstance" in x

func isClass(x):
    return tipe(x) == "peta" and "isClass" in x

func makeLazyRange(a, b = None, c = None):
    start = 0
    stop = 0
    step = 1
    if b == None:
        stop = a
    elif c == None:
        start = a
        stop = b
    else:
        start = a
        stop = b
        step = c
    if step == 0:
        rtError("range() arg 3 must not be zero")
    return {"isRange": True, "start": start, "stop": stop, "step": step}

func rangeCount(x):
    start = x["start"]
    stop = x["stop"]
    step = x["step"]
    if step > 0:
        if start >= stop:
            return 0
        return (stop - start + step - 1) // step
    if start <= stop:
        return 0
    return (start - stop - step - 1) // (-step)

func nusaLen(x):
    if isRange(x):
        return rangeCount(x)
    return panjang(x)

func nusaList(arg = None):
    if arg == None:
        return []
    if isRange(arg):
        if rangeCount(arg) > 10000000:
            rtError("rentang(): terlalu besar untuk dialokasikan sebagai list")
        res = []
        cur = arg["start"]
        step = arg["step"]
        stop = arg["stop"]
        if step > 0:
            while cur < stop:
                res.append(cur)
                cur += step
        else:
            while cur > stop:
                res.append(cur)
                cur += step
        return res
    res = []
    for item in arg:
        res.append(item)
    return res

func nusaInt(x):
    try:
        return int(x)
    except e:
        rtError("invalid number")

func nusaFloat(x):
    try:
        return float(x)
    except e:
        rtError("invalid number")

func nusaEnumerate(items, start = 0):
    res = []
    n = start
    for item in nusaList(items):
        res.append([n, item])
        n += 1
    return res

func nusaSum(items, start = 0):
    total = start
    for item in nusaList(items):
        total = total + item
    return total

func nusaSleep(seconds):
    hostJalankanPerintah("sleep", [str(seconds)])
    return None

func nusaGetenv(name, fallback = None):
    val = hostAmbilEnv(name)
    if val == None:
        return fallback
    return val

func nusaPeta():
    return {}

func groupDigits(digits):
    out = ""
    n = len(digits)
    i = 0
    while i < n:
        if i > 0 and (n - i) % 3 == 0:
            out += ","
        out += digits[i]
        i += 1
    return out

func fixedText(v, prec):
    neg = v < 0
    scaled = int(round(abs(v) * (10 ** prec)))
    text = str(scaled)
    while len(text) <= prec:
        text = "0" + text
    whole = text[:len(text) - prec]
    frac = text[len(text) - prec:]
    out = whole
    if prec > 0:
        out = whole + "." + frac
    if neg and scaled != 0:
        out = "-" + out
    return out

# Format spec: [[fill]align][0][width][,][.precision][type]
func fmtValue(v, spec):
    fill = " "
    align = ""
    i = 0
    n = len(spec)
    if n >= 2 and (spec[1] == "<" or spec[1] == ">" or spec[1] == "^"):
        fill = spec[0]
        align = spec[1]
        i = 2
    elif n >= 1 and (spec[0] == "<" or spec[0] == ">" or spec[0] == "^"):
        align = spec[0]
        i = 1
    if i < n and spec[i] == "0" and align == "":
        fill = "0"
        align = ">"
        i += 1
    width = 0
    while i < n and spec[i] >= "0" and spec[i] <= "9":
        width = width * 10 + int(spec[i])
        i += 1
    comma = False
    if i < n and spec[i] == ",":
        comma = True
        i += 1
    prec = -1
    if i < n and spec[i] == ".":
        i += 1
        prec = 0
        while i < n and spec[i] >= "0" and spec[i] <= "9":
            prec = prec * 10 + int(spec[i])
            i += 1
    kind = spec[i:] if i < n else ""
    text = ""
    isNum = tipe(v) == "angka"
    if kind == "f" or (kind == "" and prec >= 0 and isNum):
        text = fixedText(v, 6 if prec < 0 else prec)
    elif kind == "d":
        text = str(int(v))
    elif kind == "%":
        text = fixedText(v * 100, 6 if prec < 0 else prec) + "%"
    else:
        text = str(v)
        if prec >= 0 and not isNum:
            text = text[:prec]
    if comma and isNum:
        sign = ""
        body = text
        if body.startswith("-"):
            sign = "-"
            body = body[1:]
        dot = body.find(".")
        if dot >= 0:
            body = groupDigits(body[:dot]) + body[dot:]
        else:
            body = groupDigits(body)
        text = sign + body
    if len(text) < width:
        pad = width - len(text)
        if align == "":
            align = ">" if isNum else "<"
        if align == "<":
            text = text + fill * pad
        elif align == ">":
            if fill == "0" and text.startswith("-"):
                text = "-" + fill * pad + text[1:]
            else:
                text = fill * pad + text
        else:
            left = pad // 2
            text = fill * left + text + fill * (pad - left)
    return text

func replaceText(text, old, new):
    if old == "":
        return text
    return gabung(pisah(text, old), new)

func countText(text, sub):
    if sub == "":
        return len(text) + 1
    return len(pisah(text, sub)) - 1

func padLeft(text):
    i = 0
    while i < len(text) and (text[i] == " " or text[i] == "\t" or text[i] == "\n" or text[i] == "\r"):
        i += 1
    return text[i:]

func padRight(text):
    j = len(text)
    while j > 0 and (text[j - 1] == " " or text[j - 1] == "\t" or text[j - 1] == "\n" or text[j - 1] == "\r"):
        j -= 1
    return text[:j]

func sortList(items, rev):
    res = sorted(items)
    if rev:
        res = sorted(items, reverse=True)
    n = len(items)
    i = 0
    while i < n:
        items[i] = res[i]
        i += 1
    return None

func listIndex(items, val):
    i = 0
    n = len(items)
    while i < n:
        if items[i] == val:
            return i
        i += 1
    rtError("ValueError: nilai tidak ada di larik")

func listRemove(items, val):
    idx = listIndex(items, val)
    k = idx
    n = len(items)
    while k < n - 1:
        items[k] = items[k + 1]
        k += 1
    items.pop()
    return None

func listRemoveAt(items, idx):
    n = len(items)
    if idx < 0:
        idx = idx + n
    if idx < 0 or idx >= n:
        rtError("index out of range")
    k = idx
    while k < n - 1:
        items[k] = items[k + 1]
        k += 1
    items.pop()
    return None

func listInsert(items, idx, val):
    n = len(items)
    if idx < 0:
        idx = idx + n
        if idx < 0:
            idx = 0
    if idx > n:
        idx = n
    items.append(None)
    k = n
    while k > idx:
        items[k] = items[k - 1]
        k -= 1
    items[idx] = val
    return None

func listReverse(items):
    n = len(items)
    i = 0
    while i < n // 2:
        tmp = items[i]
        items[i] = items[n - 1 - i]
        items[n - 1 - i] = tmp
        i += 1
    return None

func listExtend(items, more):
    for m in nusaList(more):
        items.append(m)
    return None

func mapPop(m, key, fallback = None):
    if key in m:
        val = m[key]
        remaining = {}
        for k in m:
            if k != key:
                remaining[k] = m[k]
        for k in nusaList(m.keys()):
            del m[k]
        for k in remaining:
            m[k] = remaining[k]
        return val
    return fallback

HOSTNOARG = {"noArg": True}

func makeHostCallback(interp, fn):
    func callback(a = HOSTNOARG, b = HOSTNOARG, c = HOSTNOARG, d = HOSTNOARG):
        items = []
        if a != HOSTNOARG:
            items.append(a)
        if b != HOSTNOARG:
            items.append(b)
        if c != HOSTNOARG:
            items.append(c)
        if d != HOSTNOARG:
            items.append(d)
        return interp.callUserFunction(fn, items, {})
    return callback

func makeStrFind(text):
    func finder(sub, start = 0):
        if start <= 0:
            return text.find(sub)
        rest = text[start:]
        found = rest.find(sub)
        if found < 0:
            return -1
        return found + start
    return finder

class Interpreter:
    func __init__(self):
        self.builtinScope = Scope(None)
        self.globalScope = Scope(self.builtinScope)
        self.moduleCache = {}
        self.loading = []
        self.dirStack = [scriptDirectory()]
        self.registerBuiltins()
        for stmt in Parser(Lexer(EXCEPTIONSOURCE).tokenize()).parse():
            self.execute(stmt, self.builtinScope)

    func setMainFile(self, path):
        lineState["file"] = path
        self.globalScope.define("__name__", "__main__")
        self.globalScope.define("__file__", path)

    # `impor(name)` with any expression for the name. See core/resolver.ns for
    # where names are searched. Each file runs once and later imports share the
    # same module map; the map is the module's own scope, so a cycle sees what
    # is defined so far.
    func importModule(self, name):
        if tipe(name) != "teks":
            rtError("impor() needs a text name")
        importerDir = self.dirStack[len(self.dirStack) - 1]
        path = resolveModuleFile(name, importerDir)
        if path == None:
            rtError("cannot find module '" + name + "'")
        if path in self.moduleCache:
            return self.moduleCache[path]
        if isStdlibFile(path):
            module = impor(path)
            self.moduleCache[path] = module
            return module
        scope = Scope(self.builtinScope)
        module = scope.vars
        self.moduleCache[path] = module
        scope.define("__name__", name)
        scope.define("__file__", path)
        source = hostBacaFile(path)
        if source.startswith("#!"):
            nl = source.find("\n")
            source = source[nl + 1:] if nl >= 0 else ""
        try:
            tree = Parser(Lexer(source).tokenize()).parse()
        except e:
            err = normalizeError(e)
            detail = str(err["pesan"]) if tipe(err) == "peta" and "pesan" in err else str(err)
            self.moduleCache.pop(path)
            rtError(path + ": " + detail)
        self.dirStack.append(directoryOf(path))
        savedFile = lineState["file"]
        savedLine = lineState["line"]
        lineState["file"] = path
        try:
            for stmt in tree:
                self.execute(stmt, scope)
        except failure:
            self.dirStack.pop()
            lineState["file"] = savedFile
            self.moduleCache.pop(path)
            raise failure
        self.dirStack.pop()
        lineState["file"] = savedFile
        lineState["line"] = savedLine
        return module

    func registerBuiltins(self):
        g = self.builtinScope
        interp = self

        func printer(*items, **options):
            parts = []
            for item in items:
                parts.append(interp.show(item, True))
            sep = options["sep"] if "sep" in options else " "
            end = options["end"] if "end" in options else "\n"
            line = gabung(parts, sep)
            if end == "\n":
                print(line)
            else:
                sys.stdout.write(line + end)
            return None

        func toText(x):
            return interp.show(x, True)

        func isInstanceOf(obj, cls):
            return interp.instanceOf(obj, cls)

        func delItem(obj, idx):
            if tipe(obj) == "larik":
                listRemoveAt(obj, idx)
            elif tipe(obj) == "peta":
                mapPop(obj, idx, None)
            else:
                rtError("Tipe '" + tipe(obj) + "' nggak bisa dihapus itemnya")
            return None

        func assertTrue(cond, message = "AssertionError"):
            if not interp.isTruthy(cond):
                rtError(message)
            return None

        func fmtBuiltin(v, spec):
            if tipe(v) == "teks":
                return fmtValue(v, spec)
            return fmtValue(v, spec)

        g.define("_fmt", fmtBuiltin)
        g.define("_delitem", delItem)
        g.define("_assert", assertTrue)
        g.define("print", printer)
        g.define("cetak", printer)
        func lengthOf(x):
            if isInstance(x):
                r = interp.callDunder(x, "__len__", [])
                if r[0]:
                    return r[1]
                rtError("object has no length")
            return nusaLen(x)

        g.define("len", lengthOf)
        g.define("panjang", lengthOf)
        g.define("str", toText)
        g.define("ke_teks", toText)
        g.define("int", nusaInt)
        g.define("float", nusaFloat)
        g.define("ke_angka", nusaFloat)
        g.define("ord", ord)
        g.define("chr", chr)
        g.define("type", type)
        g.define("tipe", tipe)
        g.define("range", makeLazyRange)
        g.define("rentang", makeLazyRange)
        g.define("list", nusaList)
        g.define("larik", nusaList)
        g.define("enumerate", nusaEnumerate)
        g.define("sum", nusaSum)
        g.define("abs", abs)
        g.define("min", min)
        g.define("max", max)
        g.define("round", round)
        g.define("pow", pow)
        g.define("divmod", divmod)
        g.define("sorted", sorted)
        g.define("zip", zip)
        g.define("map", map)
        g.define("filter", filter)
        g.define("any", any)
        g.define("all", all)
        func truthy(x):
            return interp.isTruthy(x)

        g.define("bool", truthy)
        g.define("reversed", reversed)
        g.define("isinstance", isInstanceOf)
        g.define("sleep", nusaSleep)
        g.define("tidur", nusaSleep)
        g.define("getenv", nusaGetenv)
        g.define("peta", nusaPeta)
        g.define("PetaBaru", hostPetaBaru)
        g.define("petaBaru", hostPetaBaru)
        g.define("peta_baru", hostPetaBaru)
        g.define("newMap", hostPetaBaru)
        g.define("readFile", hostBacaFile)
        g.define("baca_file", hostBacaFile)
        g.define("writeFile", hostTulisFile)
        g.define("tulis_file", hostTulisFile)
        g.define("fileExists", hostFileAda)
        g.define("file_ada", hostFileAda)
        func importFn(name):
            return interp.importModule(name)

        g.define("import", importFn)
        g.define("impor", importFn)
        g.define("time", waktu)
        g.define("waktu", waktu)
        g.define("gcInfo", hostGcInfo)
        g.define("gc_info", hostGcInfo)
        g.define("gcForce", hostGcPaksa)
        g.define("gc_paksa", hostGcPaksa)
        g.define("env", hostAmbilEnv)
        g.define("ambil_env", hostAmbilEnv)
        g.define("push", tambah)
        g.define("tambah", tambah)
        g.define("pop", hostHapusAkhir)
        g.define("hapus_akhir", hostHapusAkhir)
        g.define("split", pisah)
        g.define("pisah", pisah)
        g.define("join", gabung)
        g.define("gabung", gabung)
        g.define("intDiv", lambda a, b: a // b)
        g.define("runCommand", hostJalankanPerintah)
        g.define("JalankanPerintah", hostJalankanPerintah)
        g.define("jalankanPerintah", hostJalankanPerintah)
        g.define("jalankan_perintah", hostJalankanPerintah)
        g.define("callable", callable)
        g.define("input", input)
        g.define("sys", sys)
        g.define("json_encode", hostJsonEncode)
        g.define("json_decode", hostJsonDecode)
        g.define("json_decode_aman", hostJsonDecodeAman)
        g.define("base64_encode", hostBase64Encode)
        g.define("base64_decode", hostBase64Decode)
        g.define("sha256_hex", hostSha256Hex)
        g.define("hmac_sha256_hex", hostHmacSha256Hex)
        g.define("jwt_buat", hostJwtBuat)
        g.define("jwt_verifikasi", hostJwtVerifikasi)
        g.define("tcp_konek", hostTcpKonek)
        g.define("tcp_kirim", hostTcpKirim)
        g.define("tcp_terima", hostTcpTerima)
        g.define("tcp_tutup", hostTcpTutup)
        g.define("http_get", hostHttpGet)
        g.define("http_post", hostHttpPost)
        g.define("http_dengar", hostHttpDengar)
        g.define("email_kirim", hostEmailKirim)
        g.define("jalan", jalan)
