func loadModule(name):
    base = name if name.endswith(".ns") else name + ".ns"
    candidates = [
        name,
        base,
        "../" + name,
        "../" + base,
        "core/" + name,
        "core/" + base,
        "core/interpreter/" + name,
        "core/interpreter/" + base
    ]
    for c in candidates:
        try:
            return impor(c)
        except e:
            pass
    return impor(name)


Scope = loadModule("env").Scope

Lexer = loadModule("parser/lexer").Lexer

Parser = loadModule("parser/parser").Parser

resolverModule = loadModule("resolver")

resolveModuleFile = resolverModule.resolveModuleFile

isStdlibFile = resolverModule.isStdlibFile

directoryOf = resolverModule.directoryOf

scriptDirectory = resolverModule.scriptDirectory


class Interpreter:
    func __init__(self):
        self.builtinScope = Scope(None)
        self.globalScope = Scope(self.builtinScope)
        self.moduleCache = {}
        self.loading = []
        self.dirStack = [scriptDirectory()]
        self.registerBuiltins()
        for stmt in Parser(Lexer(EXCEPTIONSOURCE).tokenize()).parse():
            self.execute(stmt, self.builtinScope)

    func setMainFile(self, path):
        lineState["file"] = path
        self.globalScope.define("__name__", "__main__")
        self.globalScope.define("__file__", path)

    # `impor(name)` with any expression for the name. See core/resolver.ns for
    # where names are searched. Each file runs once and later imports share the
    # same module map; the map is the module's own scope, so a cycle sees what
    # is defined so far.
    func importModule(self, name):
        if tipe(name) != "teks":
            rtError("impor() needs a text name")
        importerDir = self.dirStack[len(self.dirStack) - 1]
        path = resolveModuleFile(name, importerDir)
        if path == None:
            rtError("cannot find module '" + name + "'")
        if path in self.moduleCache:
            return self.moduleCache[path]
        if isStdlibFile(path):
            module = impor(path)
            self.moduleCache[path] = module
            return module
        scope = Scope(self.builtinScope)
        module = scope.vars
        self.moduleCache[path] = module
        scope.define("__name__", name)
        scope.define("__file__", path)
        source = hostBacaFile(path)
        if source.startswith("#!"):
            nl = source.find("\n")
            source = source[nl + 1:] if nl >= 0 else ""
        try:
            tree = Parser(Lexer(source).tokenize()).parse()
        except e:
            err = normalizeError(e)
            detail = str(err["pesan"]) if tipe(err) == "peta" and "pesan" in err else str(err)
            self.moduleCache.pop(path)
            rtError(path + ": " + detail)
        self.dirStack.append(directoryOf(path))
        savedFile = lineState["file"]
        savedLine = lineState["line"]
        lineState["file"] = path
        try:
            for stmt in tree:
                self.execute(stmt, scope)
        except failure:
            self.dirStack.pop()
            lineState["file"] = savedFile
            self.moduleCache.pop(path)
            raise failure
        self.dirStack.pop()
        lineState["file"] = savedFile
        lineState["line"] = savedLine
        return module

    func registerBuiltins(self):
        g = self.builtinScope
        interp = self

        func printer(*items, **options):
            parts = []
            for item in items:
                parts.append(interp.show(item, True))
            sep = options["sep"] if "sep" in options else " "
            end = options["end"] if "end" in options else "\n"
            line = gabung(parts, sep)
            if end == "\n":
                print(line)
            else:
                sys.stdout.write(line + end)
            return None

        func toText(x):
            return interp.show(x, True)

        func isInstanceOf(obj, cls):
            return interp.instanceOf(obj, cls)

        func delItem(obj, idx):
            if tipe(obj) == "larik":
                listRemoveAt(obj, idx)
            elif tipe(obj) == "peta":
                mapPop(obj, idx, None)
            else:
                rtError("Tipe '" + tipe(obj) + "' nggak bisa dihapus itemnya")
            return None

        func assertTrue(cond, message = "AssertionError"):
            if not interp.isTruthy(cond):
                rtError(message)
            return None

        func fmtBuiltin(v, spec):
            if tipe(v) == "teks":
                return fmtValue(v, spec)
            return fmtValue(v, spec)

        g.define("_fmt", fmtBuiltin)
        g.define("_delitem", delItem)
        g.define("_assert", assertTrue)
        g.define("print", printer)
        g.define("cetak", printer)
        func lengthOf(x):
            if isInstance(x):
                r = interp.callDunder(x, "__len__", [])
                if r[0]:
                    return r[1]
                rtError("object has no length")
            return nusaLen(x)

        g.define("len", lengthOf)
        g.define("panjang", lengthOf)
        g.define("str", toText)
        g.define("ke_teks", toText)
        g.define("int", nusaInt)
        g.define("float", nusaFloat)
        g.define("ke_angka", nusaFloat)
        g.define("ord", ord)
        g.define("chr", chr)
        g.define("type", type)
        g.define("tipe", tipe)
        g.define("range", makeLazyRange)
        g.define("rentang", makeLazyRange)
        g.define("list", nusaList)
        g.define("larik", nusaList)
        g.define("enumerate", nusaEnumerate)
        g.define("sum", nusaSum)
        g.define("abs", nusaAbs)
        g.define("min", nusaMin)
        g.define("max", nusaMax)
        g.define("round", nusaRound)
        g.define("pow", nusaPow)
        g.define("divmod", nusaDivmod)
        g.define("sorted", nusaSorted)
        g.define("zip", zip)
        g.define("map", map)
        g.define("filter", filter)
        g.define("any", any)
        g.define("all", all)
        func truthy(x):
            return interp.isTruthy(x)

        g.define("bool", truthy)
