    func run(self, program):
        lastResult = None
        for stmt in program:
            lastResult = self.execute(stmt, self.globalScope)
        return lastResult

    func nodeType(self, node):
        if node == None:
            return ""
        if hasattr(node, "type"):
            return node.type
        return ""

    func instanceOf(self, obj, cls):
        if not isInstance(obj) or not isClass(cls):
            return False
        cur = obj["class"]
        while cur != None:
            if cur["name"] == cls["name"]:
                return True
            cur = cur["parentClass"]
        return False

    func show(self, v, top):
        t = tipe(v)
        if t == "teks":
            if top:
                return v
            return "\"" + v + "\""
        if t == "larik":
            parts = []
            for item in v:
                parts.append(self.show(item, False))
            return "[" + gabung(parts, ", ") + "]"
        if t == "peta":
            if "isInstance" in v:
                found = self.findMethod(v["class"], "__str__" if top else "__repr__")
                if found[0] == None:
                    found = self.findMethod(v["class"], "__repr__" if top else "__str__")
                if found[0] != None:
                    return str(self.callMethod(v, found, [], {}))
                return "<objek " + v["class"]["name"] + ">"
            if "isClass" in v:
                return v["name"]
            if "isRange" in v:
                if v["step"] == 1:
                    return "range(" + str(v["start"]) + ", " + str(v["stop"]) + ")"
                return "range(" + str(v["start"]) + ", " + str(v["stop"]) + ", " + str(v["step"]) + ")"
            if "isBoundMethod" in v:
                return "<fn " + v["method"].name + ">"
            parts = []
            for k in v:
                parts.append(str(k) + ": " + self.show(v[k], False))
            return "{" + gabung(parts, ", ") + "}"
        if hasattr(v, "isFunction"):
            return "<fn " + v.name + ">"
        return str(v)

    func findMethod(self, clsObj, methodName):
        cur = clsObj
        while cur != None:
            if methodName in cur["methods"]:
                return [cur["methods"][methodName], cur]
            cur = cur["parentClass"]
        return [None, None]

    func findAttr(self, clsObj, name):
        found = self.findIn(clsObj, "attrs", name)
        return [found[0], found[1]]

    func findIn(self, clsObj, table, name):
        cur = clsObj
        while cur != None:
            if name in cur[table]:
                return [True, cur[table][name], cur]
            cur = cur["parentClass"]
        return [False, None, None]

    func bindParams(self, fnObj, scope, args, kw):
        params = fnObj.params
        if len(kw) == 0 and fnObj.restName == None and fnObj.kwName == None and len(args) == len(params):
            k = 0
            for pName in params:
                scope.define(pName, args[k])
                k += 1
            return None
        nParams = len(params)
        nArgs = len(args)
        label = fnObj.name
        if fnObj.restName != None:
            if nArgs > nParams:
                scope.define(fnObj.restName, args[nParams:])
                args = args[:nParams]
                nArgs = nParams
            else:
                scope.define(fnObj.restName, [])
        if fnObj.kwName != None:
            extra = {}
            known = {}
            for name in kw:
                if name in params:
                    known[name] = kw[name]
                else:
                    extra[name] = kw[name]
            scope.define(fnObj.kwName, extra)
            kw = known
        if nArgs > nParams:
            if len(fnObj.defaults) > 0:
                rtError("fungsi '" + label + "' butuh " + str(nParams - len(fnObj.defaults)) + ".." + str(nParams) + " argumen, dapat " + str(nArgs))
            rtError("fungsi '" + label + "' butuh " + str(nParams) + " argumen, dapat " + str(nArgs))
        i = 0
        while i < nParams:
            pName = params[i]
            if i < nArgs:
                if pName in kw:
                    rtError("fungsi '" + label + "' menerima argumen '" + pName + "' dua kali")
                scope.define(pName, args[i])
            elif pName in kw:
                scope.define(pName, kw[pName])
            elif pName in fnObj.defaults:
                scope.define(pName, fnObj.defaults[pName])
            else:
                if len(fnObj.defaults) > 0:
                    rtError("fungsi '" + label + "' butuh " + str(nParams - len(fnObj.defaults)) + ".." + str(nParams) + " argumen, dapat " + str(nArgs))
                rtError("fungsi '" + label + "' butuh " + str(nParams) + " argumen, dapat " + str(nArgs))
            i += 1
        for name in kw:
            if not (name in params):
                rtError("fungsi '" + label + "' tidak punya parameter '" + name + "'")

    func runBody(self, fnObj, scope):
        body = fnObj.body
        if body.type == "BLOCK":
            for st in body.stmts:
                r = self.execute(st, scope)
                if r != None:
                    if r.kind == 3:
                        return r.val
                    return None
            return None
        r = self.execute(body, scope)
        if r != None and r.kind == 3:
            return r.val
        return None

    func callUserFunction(self, fnTarget, args, kw):
        savedLine = lineState["line"]
        savedFile = lineState["file"]
        lineState["file"] = fnTarget.file
        fnScope = Scope(fnTarget.closure)
        self.bindParams(fnTarget, fnScope, args, kw)
        result = self.runBody(fnTarget, fnScope)
        lineState["line"] = savedLine
        lineState["file"] = savedFile
        return result

    func callMethod(self, inst, found, args, kw):
        m = found[0]
        lk = Scope(m.closure)
        lk.define("self", inst)
        lk.define("ini", inst)
        lk.define("__kelasAktif__", found[1])
        savedLine = lineState["line"]
        savedFile = lineState["file"]
        lineState["file"] = m.file
        self.bindParams(m, lk, args, kw)
        result = self.runBody(m, lk)
        lineState["line"] = savedLine
        lineState["file"] = savedFile
        return result

    func makeFunction(self, name, params, body, defaults, env, restName = None, kwName = None):
        evaluated = {}
        for k in defaults:
            evaluated[k] = self.evaluate(defaults[k], env)
        return UserFunction(name, params, body, env, evaluated, restName, kwName)

    func scopeFor(self, node, env):
        if node == None:
            return env
        if not hasattr(node, "needsScope"):
            need = False
            if node.type == "BLOCK":
                for st in node.stmts:
                    if st.type == "VAR" or st.type == "FUNC" or st.type == "CLASS" or st.type == "STRUCT" or st.type == "ENUM":
                        need = True
                        break
            else:
                need = node.type == "VAR" or node.type == "FUNC" or node.type == "CLASS"
            node.needsScope = need
        if node.needsScope:
            return Scope(env)
        return env

    func execInline(self, node, env):
        if node == None:
            return None
        if node.type == "BLOCK":
            for s in node.stmts:
                r = self.execute(s, env)
                if r != None:
                    return r
            return None
        return self.execute(node, env)

    func assignTo(self, target, val, env):
        tt = target.type
        if tt == "IDENT":
            env.set(target.name, val)
        elif tt == "INDEX":
            obj = self.evaluate(target.target, env)
            idx = self.evaluate(target.index, env)
            self.storeIndex(obj, idx, val)
        elif tt == "MEMBER":
            self.setMember(self.evaluate(target.target, env), target.name, val)
        else:
            rtError("Target assignment nggak valid")

    func storeIndex(self, obj, idx, val):
        if isInstance(obj):
            r = self.callDunder(obj, "__setitem__", [idx, val])
            if r[0]:
                return None
        if tipe(obj) == "larik":
            n = len(obj)
            if idx < -n or idx >= n:
                rtError("index out of range")
        elif tipe(obj) != "peta":
            rtError("Tipe '" + tipe(obj) + "' nggak bisa diisi pakai []")
        obj[idx] = val

    func setMember(self, obj, name, val):
        if isInstance(obj):
            setter = self.findIn(obj["class"], "setters", name)
            if setter[0]:
                self.callMethod(obj, [setter[1], setter[2]], [val], {})
                return None
            if self.findIn(obj["class"], "props", name)[0]:
                rtError("property '" + name + "' has no setter")
            obj["fields"][name] = val
        elif isClass(obj):
            obj["attrs"][name] = val
        elif tipe(obj) == "peta":
            obj[name] = val
        else:
            rtError("field tidak bisa diisi pada nilai bertipe " + tipe(obj))


    func execute(self, stmt, env):
        if stmt == None:
            return None

        t = stmt.type
        if stmt.line != 0:
            lineState["line"] = stmt.line

        if t == "EXPR":
            self.evaluate(stmt.expr, env)
            return None
        elif t == "RETURN":
            if stmt.value == None:
                return ReturnSignal(None)
            return ReturnSignal(self.evaluate(stmt.value, env))
        elif t == "IF":
            if self.isTruthy(self.evaluate(stmt.condition, env)):
                return self.execInline(stmt.thenBranch, self.scopeFor(stmt.thenBranch, env))
            elif stmt.elseBranch != None:
                return self.execInline(stmt.elseBranch, self.scopeFor(stmt.elseBranch, env))
            return None
        elif t == "VAR":
            env.define(stmt.name, self.evaluate(stmt.value, env))
            return None
        elif t == "BLOCK":
            childScope = Scope(env)
            for s in stmt.stmts:
                r = self.execute(s, childScope)
                if r != None:
                    return r
            return None
        elif t == "FUNC":
            env.define(stmt.name, self.makeFunction(stmt.name, stmt.params, stmt.body, stmt.defaults, env, stmt.restName, stmt.kwName))
            return None
        elif t == "WHILE":
            while self.isTruthy(self.evaluate(stmt.condition, env)):
                r = self.execInline(stmt.body, self.scopeFor(stmt.body, env))
                if r != None:
                    if r.kind == 1:
                        break
                    if r.kind == 3:
                        return r
            return None
        elif t == "FOR":
            loopScope = Scope(env)
            if stmt.init != None:
                self.execute(stmt.init, loopScope)
            while self.isTruthy(self.evaluate(stmt.condition, loopScope)):
                r = self.execInline(stmt.body, self.scopeFor(stmt.body, loopScope))
                if r != None:
                    if r.kind == 1:
                        break
                    if r.kind == 3:
                        return r
                if stmt.post != None:
                    self.evaluate(stmt.post, loopScope)
            return None
        elif t == "FOR_IN":
            collection = self.evaluate(stmt.iterable, env)
            if isInstance(collection):
                collection = self.instanceToList(collection)
            if isRange(collection):
                start = collection["start"]
                stop = collection["stop"]
                step = collection["step"]
                cur = start
                while (step > 0 and cur < stop) or (step < 0 and cur > stop):
                    iterScope = Scope(env)
                    self.bindTargets(stmt, cur, iterScope, env)
                    r = self.execInline(stmt.body, iterScope)
                    if r != None:
                        if r.kind == 1:
                            break
                        if r.kind == 3:
                            return r
                    cur += step
                return None
            for item in collection:
                iterScope = Scope(env)
                self.bindTargets(stmt, item, iterScope, env)
                r = self.execInline(stmt.body, iterScope)
                if r != None:
                    if r.kind == 1:
                        break
                    if r.kind == 3:
                        return r
            return None
        elif t == "BREAK":
            return BREAKSIGNAL
        elif t == "CONTINUE":
            return CONTINUESIGNAL
        elif t == "TRY":
            return self.executeTry(stmt, env)
        elif t == "THROW":
            val = self.evaluate(stmt.value, env)
            raise val
        elif t == "CLASS":
            self.defineClass(stmt, env)
            return None
        elif t == "STRUCT":
            structCls = newClass(stmt.name, None)
            structCls["isStruct"] = True
            structCls["fields"] = stmt.fields
            env.define(stmt.name, structCls)
            return None
        elif t == "ENUM":
            members = {}
            enumCls = newClass(stmt.name, None)
            idx = 0
            for variant in stmt.variants:
                members[variant] = {"isInstance": True, "class": enumCls, "fields": {"name": variant, "value": idx}}
                idx += 1
            env.define(stmt.name, members)
            return None
        elif t == "TUPLE_ASSIGN":
            val = self.evaluate(stmt.value, env)
            if not stmt.isLiteral:
                val = self.toList(val)
            if stmt.starIndex >= 0:
                before = stmt.starIndex
                after = len(stmt.targets) - 1 - before
                if len(val) < before + after:
                    rtError("tidak cukup nilai untuk dibongkar")
                k = 0
                for target in stmt.targets:
                    if k < before:
                        self.assignTo(target, val[k], env)
                    elif k == before:
                        self.assignTo(target, val[before:len(val) - after], env)
                    else:
                        self.assignTo(target, val[len(val) - (len(stmt.targets) - k)], env)
                    k += 1
                return None
            if len(val) != len(stmt.targets):
                rtError("tidak bisa membongkar " + str(len(val)) + " nilai ke " + str(len(stmt.targets)) + " variabel")
            k = 0
            for target in stmt.targets:
                self.assignTo(target, val[k], env)
                k += 1
            return None
        elif t == "WITH":
            return self.executeWith(stmt, env, 0)
        return None

    func executeWith(self, stmt, env, level):
        if level >= len(stmt.items):
            return self.execInline(stmt.body, Scope(env))
        item = stmt.items[level]
        manager = self.evaluate(item[0], env)
        entered = manager
        if isInstance(manager):
            r = self.callDunder(manager, "__enter__", [])
            if r[0]:
                entered = r[1]
        scope = Scope(env)
        if item[1] != None:
            scope.define(item[1], entered)
        try:
            result = self.executeWith(stmt, scope, level + 1)
        except e:
            suppressed = self.leaveWith(manager, normalizeError(e))
            if not suppressed:
                raise e
            return None
        self.leaveWith(manager, None)
        return result

    func leaveWith(self, manager, err):
        if not isInstance(manager):
            return False
        r = self.callDunder(manager, "__exit__", [None, err, None])
        if r[0]:
            return self.isTruthy(r[1])
        return False

    func bindTargets(self, stmt, item, iterScope, env):
        targets = stmt.targets
        if len(targets) == 1:
            if stmt.declared:
                env.set(targets[0], item)
            else:
                iterScope.define(targets[0], item)
            return None
        values = nusaList(item)
        if len(values) != len(targets):
            rtError("tidak bisa membongkar " + str(len(values)) + " nilai ke " + str(len(targets)) + " variabel")
        k = 0
        for name in targets:
            if stmt.declared:
                env.set(name, values[k])
            else:
                iterScope.define(name, values[k])
            k += 1
        return None

    func executeTry(self, stmt, env):
        finallyBlock = stmt.finallyBlock
        result = None
        try:
            caught = False
            try:
                result = self.execInline(stmt.tryBlock, Scope(env))
            except e:
                err = normalizeError(e)
                handled = self.runHandlers(stmt, err, env)
                if not handled[0]:
                    raise e
                result = handled[1]
                caught = True
            if not caught and stmt.elseBlock != None:
                result = self.execInline(stmt.elseBlock, Scope(env))
        except outer:
            if finallyBlock != None:
                self.execInline(finallyBlock, Scope(env))
            raise outer
        if finallyBlock != None:
            fin = self.execInline(finallyBlock, Scope(env))
            if fin != None:
                return fin
        return result

    func runHandlers(self, stmt, err, env):
        if stmt.clauses == None:
            if stmt.catchBlock == None:
                return [False, None]
            catchScope = Scope(env)
            catchScope.define(stmt.catchVar, err)
            return [True, self.execInline(stmt.catchBlock, catchScope)]
        for clause in stmt.clauses:
            if clause["filter"] == None or self.errorMatches(err, self.evaluate(clause["filter"], env)):
                catchScope = Scope(env)
                if clause["var"] != "":
                    catchScope.define(clause["var"], err)
                return [True, self.execInline(clause["body"], catchScope)]
        return [False, None]

    func errorMatches(self, err, kinds):
        if tipe(kinds) != "larik":
            kinds = [kinds]
        for kind in kinds:
            if not isClass(kind):
                continue
            if isInstance(err):
                if self.instanceOf(err, kind):
                    return True
            elif tipe(err) == "peta" and "pesan" in err:
                if runtimeErrorMatches(err["pesan"], kind["name"]):
                    return True
        return False

    func defineClass(self, stmt, env):
        clsObj = newClass(stmt.name, stmt.baseClass)
        if stmt.baseClass != None:
            base = env.get(stmt.baseClass)
            if not isClass(base):
                rtError("'" + stmt.baseClass + "' is not a class")
            clsObj["parentClass"] = base
        for m in stmt.methods:
            fnObj = self.makeFunction(m.name, m.params, m.body, m.defaults, env, m.restName, m.kwName)
            kind = m.kind if hasattr(m, "kind") else ""
            if kind == "":
                clsObj["methods"][m.name] = fnObj
                if m.name == "__init__" or m.name == "konstruktor" or m.name == "init" or m.name == "constructor":
                    clsObj["methods"]["constructor"] = fnObj
            elif kind == "static":
                clsObj["statics"][m.name] = fnObj
            elif kind == "class":
                clsObj["classMethods"][m.name] = fnObj
            elif kind == "property":
                clsObj["props"][m.name] = fnObj
            else:
                clsObj["setters"][kind[7:]] = fnObj
        env.define(stmt.name, clsObj)
        for attr in stmt.attrs:
            clsObj["attrs"][attr[0]] = self.evaluate(attr[1], env)

    func instantiate(self, cls, args, kw):
        if "isStruct" in cls:
            fields = cls["fields"]
            if len(args) != len(fields) or len(kw) > 0:
                rtError("Bentuk '" + cls["name"] + "' butuh " + str(len(fields)) + " argumen, dapat " + str(len(args)))
            vals = {}
            k = 0
            for f in fields:
                vals[f] = args[k]
                k += 1
            return {"isInstance": True, "class": cls, "fields": vals}
        instance = {"isInstance": True, "class": cls, "fields": {}}
        found = self.findMethod(cls, "constructor")
        if found[0] != None:
            self.callMethod(instance, found, args, kw)
        elif len(args) > 0 or len(kw) > 0:
            rtError("kelas '" + cls["name"] + "' tidak punya konstruktor tapi dipanggil dengan argumen")
        return instance

    func isTruthy(self, val):
        if val == None or val == False or val == 0 or val == "":
            return False
        t = tipe(val)
        if t == "larik":
            return len(val) > 0
        if t == "peta":
            if "isInstance" in val:
                r = self.callDunder(val, "__bool__", [])
                if r[0]:
                    return self.isTruthy(r[1])
                r = self.callDunder(val, "__len__", [])
                if r[0]:
                    return r[1] > 0
                return True
            return len(val) > 0
        return True

    func evalComp(self, expr, env):
        res = {} if expr.isDict else []
        self.compLoop(expr, 0, env, res)
        return res

    func compLoop(self, expr, level, env, res):
        if level >= len(expr.clauses):
            if expr.isDict:
                res[self.evaluate(expr.element, env)] = self.evaluate(expr.value, env)
            else:
                res.append(self.evaluate(expr.element, env))
            return None
        clause = expr.clauses[level]
        names = clause[0]
        for item in self.toList(self.evaluate(clause[1], env)):
            scope = Scope(env)
            if len(names) == 1:
                scope.define(names[0], item)
            else:
                values = nusaList(item)
                k = 0
                for name in names:
                    scope.define(name, values[k])
                    k += 1
            ok = True
            for cond in clause[2]:
                if not self.isTruthy(self.evaluate(cond, scope)):
                    ok = False
                    break
            if ok:
                self.compLoop(expr, level + 1, scope, res)

    func evaluate(self, expr, env):
        if expr == None:
            return None

        t = expr.type

        if t == "IDENT":
            name = expr.name
            if name == "super":
                return {"isSuperProxy": True, "self": env.get("self"), "fromClass": env.get("__kelasAktif__")}
            return env.get(name)
        elif t == "NUMBER" or t == "STRING" or t == "BOOL":
            return expr.value
        elif t == "BINARY":
            op = expr.op
            if op == "or":
                k = self.evaluate(expr.left, env)
                if self.isTruthy(k):
                    return k
                return self.evaluate(expr.right, env)
            if op == "and":
                k = self.evaluate(expr.left, env)
                if not self.isTruthy(k):
                    return k
                return self.evaluate(expr.right, env)
            leftVal = self.evaluate(expr.left, env)
            rightVal = self.evaluate(expr.right, env)
            if tipe(leftVal) == "peta" or tipe(rightVal) == "peta":
                handled = self.instanceBinary(op, leftVal, rightVal)
                if handled[0]:
                    return handled[1]
            return self.binaryValue(op, leftVal, rightVal)
        elif t == "CALL":
            return self.evalCall(expr, env)
        elif t == "NULL":
            return None
        elif t == "LIST":
            res = []
            for el in expr.elements:
                res.append(self.evaluate(el, env))
            return res
        elif t == "MAP":
            res = {}
            idx = 0
            for k in expr.keys:
                key = k
                if tipe(k) == "objek" or hasattr(k, "type"):
                    key = self.evaluate(k, env)
                res[key] = self.evaluate(expr.values[idx], env)
                idx += 1
            return res
        elif t == "COMP":
            return self.evalComp(expr, env)
        elif t == "TERNARY":
            if self.isTruthy(self.evaluate(expr.condition, env)):
                return self.evaluate(expr.thenVal, env)
            return self.evaluate(expr.elseVal, env)
        elif t == "LAMBDA":
            return self.makeFunction("lambda", expr.params, expr.body, expr.defaults, env, expr.restName, expr.kwName)
        elif t == "UNARY":
            val = self.evaluate(expr.operand, env)
            if expr.op == "-":
                return -val
            elif expr.op == "not":
                return not self.isTruthy(val)
            elif expr.op == "~":
                return ~val
            return val
        elif t == "MEMBER":
            return self.getMember(self.evaluate(expr.target, env), expr.name, env)
        elif t == "INDEX":
            target = self.evaluate(expr.target, env)
            idx = self.evaluate(expr.index, env)
            return self.indexValue(target, idx)
        elif t == "SLICE":
            target = self.evaluate(expr.target, env)
            s = None
            e = None
            step = None
            if expr.start != None:
                s = self.evaluate(expr.start, env)
            if expr.stop != None:
                e = self.evaluate(expr.stop, env)
            if expr.step != None:
                step = self.evaluate(expr.step, env)
            if isRange(target):
                target = nusaList(target)
            return self.sliceValue(target, s, e, step)
        elif t == "ASSIGN":
            return self.evalAssign(expr, env)
        return None

    func sliceValue(self, target, s, e, step):
        if step == None:
            if s == None and e == None:
                return target[0:len(target)]
            if s == None:
                return target[:e]
            if e == None:
                return target[s:]
            return target[s:e]
        if step == 0:
            rtError("slice step nggak boleh nol")
        n = len(target)
        if step > 0:
            lo = 0 if s == None else s
            hi = n if e == None else e
            if lo < 0:
                lo = max(lo + n, 0)
            if hi < 0:
                hi = max(hi + n, 0)
            hi = min(hi, n)
            idxs = range(lo, hi, step)
        else:
            lo = n - 1 if s == None else s
            hi = -1 if e == None else e
            if s != None and lo < 0:
                lo = lo + n
            if e != None and hi < 0:
                hi = hi + n
            lo = min(lo, n - 1)
            idxs = range(lo, hi, step)
        parts = []
        for i in idxs:
            parts.append(target[i])
        if tipe(target) == "teks":
            return gabung(parts, "")
        return parts

    func indexValue(self, target, idx):
        if isRange(target):
            val = target["start"] + idx * target["step"]
            if idx < 0 or idx >= rangeCount(target):
                rtError("index out of range")
            return val
        tt = tipe(target)
        if tt == "peta":
            if isInstance(target):
                r = self.callDunder(target, "__getitem__", [idx])
                if r[0]:
                    return r[1]
            if isInstance(target) or isClass(target):
                return self.getMember(target, idx, self.globalScope)
            if idx in target:
                return target[idx]
            return None
        if tt == "larik" or tt == "teks":
            n = len(target)
            if tipe(idx) != "angka":
                rtError("index harus angka")
            if idx < -n or idx >= n:
                rtError("index out of range")
            return target[idx]
        rtError("Tipe '" + tt + "' nggak bisa di-index pakai []")

    func evalAssign(self, expr, env):
        val = self.evaluate(expr.value, env)
        target = expr.target
        compound = expr.op != "="
        baseOp = expr.op[:len(expr.op) - 1]
        tt = target.type
        if tt == "IDENT":
            if compound:
                val = self.binaryValue(baseOp, env.get(target.name), val)
            env.set(target.name, val)
            return val
        elif tt == "INDEX":
            obj = self.evaluate(target.target, env)
            idx = self.evaluate(target.index, env)
            if compound:
                val = self.binaryValue(baseOp, self.indexValue(obj, idx), val)
            self.storeIndex(obj, idx, val)
            return val
        elif tt == "MEMBER":
            obj = self.evaluate(target.target, env)
            if compound:
                val = self.binaryValue(baseOp, self.getMember(obj, target.name, env), val)
            self.setMember(obj, target.name, val)
            return val
        rtError("Invalid assignment target")

    func evalCall(self, expr, env):
        fnTarget = self.evaluate(expr.callee, env)
        args = []
        kw = {}
        for a in expr.args:
            if a.type == "SPREAD":
                spread = self.evaluate(a.value, env)
                if a.isKw:
                    for key in spread:
                        kw[key] = spread[key]
                else:
                    for item in self.toList(spread):
                        args.append(item)
            else:
                args.append(self.evaluate(a, env))
        k = 0
        for name in expr.kwNames:
            kw[name] = self.evaluate(expr.kwValues[k], env)
            k += 1
        return self.callValue(fnTarget, args, kw)

    func callValue(self, fnTarget, args, kw):
        if hasattr(fnTarget, "isFunction"):
            return self.callUserFunction(fnTarget, args, kw)

        if isClass(fnTarget):
            return self.instantiate(fnTarget, args, kw)

        if isInstance(fnTarget):
            r = self.callDunder(fnTarget, "__call__", args)
            if r[0]:
                return r[1]
            rtError("object is not callable")

        if tipe(fnTarget) == "peta" and "isBoundMethod" in fnTarget:
            return self.callMethod(fnTarget["instance"], [fnTarget["method"], fnTarget["definingClass"]], args, kw)

        ft = str(tipe(fnTarget))
        if len(kw) > 0:
            return fnTarget(*self.wrapHostArgs(args), **kw)
        isCallableObj = callable(fnTarget) or ft == "kelas" or ft == "BoundMethod"
        if isCallableObj:
            args = self.wrapHostArgs(args)
            nA = len(args)
            if nA == 0:
                return fnTarget()
            elif nA == 1:
                return fnTarget(args[0])
            elif nA == 2:
                return fnTarget(args[0], args[1])
            elif nA == 3:
                return fnTarget(args[0], args[1], args[2])
            elif nA == 4:
                return fnTarget(args[0], args[1], args[2], args[3])
            elif nA == 5:
                return fnTarget(args[0], args[1], args[2], args[3], args[4])
            return fnTarget(*args)

        rtError("value is not callable: " + self.show(fnTarget, False))

    func getMember(self, target, name, env):
        tt = tipe(target)
        if tt == "peta":
            if "isSuperProxy" in target:
                ownerClass = target["fromClass"]
                parentClass = ownerClass["parentClass"] if ownerClass != None else None
                if parentClass != None:
                    found = self.findMethod(parentClass, name)
                    if found[0] != None:
                        return {"isBoundMethod": True, "instance": target["self"], "method": found[0], "definingClass": found[1]}
                rtError("super has no method '" + str(name) + "'")
            if "isInstance" in target:
                fields = target["fields"]
                if name in fields:
                    return fields[name]
                cls = target["class"]
                prop = self.findIn(cls, "props", name)
                if prop[0]:
                    return self.callMethod(target, [prop[1], prop[2]], [], {})
                found = self.findMethod(cls, name)
                if found[0] != None:
                    return {"isBoundMethod": True, "instance": target, "method": found[0], "definingClass": found[1]}
                return self.classLevelMember(cls, name)
            if "isClass" in target:
                attr = self.findAttr(target, name)
                if attr[0]:
                    return attr[1]
                found = self.findMethod(target, name)
                if found[0] != None:
                    return found[0]
                return self.classLevelMember(target, name)
            return self.mapMember(target, name)
        if tt == "teks":
            return self.textMember(target, name)
        if tt == "larik":
            return self.listMember(target, name)
        if hasattr(target, name):
            val = getattr(target, name)
            if str(tipe(val)) == "BoundMethod":
                return makeMethodCaller(target, name)
            return val
        return None

    func classLevelMember(self, cls, name):
        attr = self.findAttr(cls, name)
        if attr[0]:
            return attr[1]
        static = self.findIn(cls, "statics", name)
        if static[0]:
            return static[1]
        classMethod = self.findIn(cls, "classMethods", name)
        if classMethod[0]:
            return self.classMethodCaller(classMethod[1], cls)
        return None

    func classMethodCaller(self, fn, cls):
        interp = self
        func caller(*items):
            return interp.callUserFunction(fn, [cls] + list(items), {})
        return caller

    func mapMember(self, target, name):
        if name == "get" or name == "ambil":
            return lambda k, d = None: target[k] if k in target else d
        elif name == "keys" or name == "kunci":
            return lambda: list(target.keys())
        elif name == "values" or name == "nilai":
            return lambda: list(target.values())
        elif name == "items":
            return lambda: list(target.items())
        elif name == "pop":
            return lambda k, d = None: mapPop(target, k, d)
        elif name == "update":
            return lambda other: self.mapUpdate(target, other)
        elif name == "setdefault":
            return lambda k, d = None: self.mapSetDefault(target, k, d)
        elif name == "copy":
            return lambda: self.mapCopy(target)
        elif name in target:
            return target[name]
        return None

    func mapUpdate(self, target, other):
        for k in other:
            target[k] = other[k]
        return None

    func mapSetDefault(self, target, k, d):
        if not (k in target):
            target[k] = d
        return target[k]

    func mapCopy(self, target):
        res = {}
        for k in target:
            res[k] = target[k]
        return res

    func textMember(self, target, name):
        if name == "isdigit":
            return lambda: target.isdigit()
        elif name == "isalpha":
            return lambda: target.isalpha()
        elif name == "isalnum":
            return lambda: target.isalnum()
        elif name == "startswith":
            return lambda p: target.startswith(p)
        elif name == "endswith":
            return lambda p: target.endswith(p)
        elif name == "find":
            return makeStrFind(target)
        elif name == "join":
            return lambda items: gabung(items, target)
        elif name == "strip":
            return lambda: target.strip()
        elif name == "lstrip":
            return lambda: padLeft(target)
        elif name == "rstrip":
            return lambda: padRight(target)
        elif name == "lower":
            return lambda: target.lower()
        elif name == "upper":
            return lambda: target.upper()
        elif name == "split":
            return lambda sep: target.split(sep)
        elif name == "replace":
            return lambda old, new: replaceText(target, old, new)
        elif name == "count":
            return lambda sub: countText(target, sub)
        return None

    func listMember(self, target, name):
        if name == "append" or name == "push":
            return lambda x: target.append(x)
        elif name == "pop":
            return lambda: target.pop()
        elif name == "sort":
            return lambda reverse = False: sortList(target, reverse)
        elif name == "insert":
            return lambda i, x: listInsert(target, i, x)
        elif name == "index":
            return lambda x: listIndex(target, x)
        elif name == "remove":
            return lambda x: listRemove(target, x)
        elif name == "reverse":
            return lambda: listReverse(target)
        elif name == "extend":
            return lambda more: listExtend(target, more)
        elif name == "count":
            return lambda x: len([v for v in target if v == x])
        elif name == "copy":
            return lambda: target[0:len(target)]
        return None

    func callDunder(self, inst, name, args):
        found = self.findMethod(inst["class"], name)
        if found[0] == None:
            return [False, None]
        return [True, self.callMethod(inst, found, args, {})]

    # Operators on instances go through their special methods. A result of
    # [False, ...] means the plain operator applies.
    func instanceBinary(self, op, leftVal, rightVal):
        if isInstance(leftVal) and (op in BINARYDUNDERS):
            r = self.callDunder(leftVal, BINARYDUNDERS[op], [rightVal])
            if r[0]:
                return r
        if isInstance(rightVal) and (op in REFLECTEDDUNDERS):
            r = self.callDunder(rightVal, REFLECTEDDUNDERS[op], [leftVal])
            if r[0]:
                return r
        if op == "==" or op == "!=":
            if not isInstance(leftVal) and not isInstance(rightVal):
                return [False, None]
            eq = None
            if isInstance(leftVal):
                r = self.callDunder(leftVal, "__eq__", [rightVal])
                if r[0]:
                    eq = self.isTruthy(r[1])
                if op == "!=":
                    ne = self.callDunder(leftVal, "__ne__", [rightVal])
                    if ne[0]:
                        return ne
            if eq == None:
                eq = isInstance(leftVal) and isInstance(rightVal) and id(leftVal) == id(rightVal)
            if op == "==":
                return [True, eq]
            return [True, not eq]
        if op == "in" and isInstance(rightVal):
            r = self.callDunder(rightVal, "__contains__", [leftVal])
            if r[0]:
                return [True, self.isTruthy(r[1])]
            return [True, leftVal in self.instanceToList(rightVal)]
        if (isInstance(leftVal) or isInstance(rightVal)) and (op in BINARYDUNDERS):
            rtError("operator " + op + " is not supported for this object")
        return [False, None]

    func instanceToList(self, inst):
        made = self.callDunder(inst, "__iter__", [])
        if not made[0]:
            rtError("object is not iterable")
        it = made[1]
        if tipe(it) == "larik":
            return it
        if not isInstance(it):
            return nusaList(it)
        out = []
        while True:
            try:
                step = self.callDunder(it, "__next__", [])
            except e:
                if isSignal(e):
                    raise e
                err = normalizeError(e)
                if isInstance(err) and err["class"]["name"] == "StopIteration":
                    break
                if tipe(err) == "peta" and "pesan" in err and err["pesan"] == "StopIteration":
                    break
                raise e
            if not step[0]:
                rtError("iterator has no __next__")
            out.append(step[1])
        return out

    func toList(self, value):
        if isInstance(value):
            return self.instanceToList(value)
        return nusaList(value)

    func binaryValue(self, op, leftVal, rightVal):
        if op == "+":
            return leftVal + rightVal
        elif op == "-":
            return leftVal - rightVal
        elif op == "*":
            if (tipe(leftVal) == "teks" or tipe(leftVal) == "larik") and tipe(rightVal) == "angka":
                return leftVal * rightVal
            return leftVal * rightVal
        elif op == "/":
            if rightVal == 0:
                rtError("division by zero")
            return leftVal / rightVal
        elif op == "//":
            if rightVal == 0:
                rtError("division by zero")
            return leftVal // rightVal
        elif op == "%":
            if rightVal == 0:
                rtError("division by zero")
            return leftVal % rightVal
        elif op == "**":
            return leftVal ** rightVal
        elif op == "==":
            return leftVal == rightVal
        elif op == "!=":
            return leftVal != rightVal
        elif op == "<":
            return leftVal < rightVal
        elif op == "<=":
            return leftVal <= rightVal
        elif op == ">":
            return leftVal > rightVal
        elif op == ">=":
            return leftVal >= rightVal
        elif op == "&":
            return leftVal & rightVal
        elif op == "|":
            return leftVal | rightVal
        elif op == "^":
            return leftVal ^ rightVal
        elif op == "<<":
            return leftVal << rightVal
        elif op == ">>":
            return leftVal >> rightVal
        elif op == "in":
            if isRange(rightVal):
                rightVal = nusaList(rightVal)
            rt = tipe(rightVal)
            if rt == "peta" or rt == "larik" or rt == "teks":
                return leftVal in rightVal
            return False
        return None

    func wrapHostArgs(self, args):
        wrapped = []
        for a in args:
            if hasattr(a, "isFunction"):
                wrapped.append(makeHostCallback(self, a))
            elif tipe(a) == "peta" and ("isBoundMethod" in a or ("isInstance" in a and self.findMethod(a["class"], "__call__")[0] != None)):
                wrapped.append(self.boundCallback(a))
            else:
                wrapped.append(a)
        return wrapped

    func boundCallback(self, bound):
        interp = self
        func callback(a = HOSTNOARG, b = HOSTNOARG, c = HOSTNOARG, d = HOSTNOARG):
            items = []
            if a != HOSTNOARG:
                items.append(a)
            if b != HOSTNOARG:
                items.append(b)
            if c != HOSTNOARG:
                items.append(c)
            if d != HOSTNOARG:
                items.append(d)
            return interp.callValue(bound, items, {})
        return callback
