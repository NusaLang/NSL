# The engine's own builtins, bound once under camelCase names, and the wrapper that lets the host call back into interpreted functions.

# The host engine names its builtins in snake_case. Each one is bound once here
# and used under a camelCase name below.
hostJalankanPerintah = jalankan_perintah

hostAmbilEnv = ambil_env

hostKeAngka = ke_angka

hostCallMethod = _callmeth

