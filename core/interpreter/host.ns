hostProcStreamTutup = proc_stream_tutup

hostQrBaca = qr_baca

hostPetaKunci = peta_kunci

hostBacaInput = baca_input



HOSTNOARG = {"noArg": True}


func makeHostCallback(interp, fn):
    func callback(a = HOSTNOARG, b = HOSTNOARG, c = HOSTNOARG, d = HOSTNOARG):
        items = []
        if a != HOSTNOARG:
            items.append(a)
        if b != HOSTNOARG:
            items.append(b)
        if c != HOSTNOARG:
            items.append(c)
        if d != HOSTNOARG:
            items.append(d)
        return interp.callUserFunction(fn, items, {})
    return callback

