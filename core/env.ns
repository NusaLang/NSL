class Scope:
    func __init__(self, outer):
        self.outer = outer
        self.vars = {}

    func define(self, name, val):
        self.vars[name] = val

    func get(self, name):
        if name in self.vars:
            return self.vars[name]
        if self.outer != None:
            return self.outer.get(name)
        print("RuntimeError: undefined variable '" + str(name) + "'")
        return None

    func has(self, name):
        if name in self.vars:
            return True
        return self.outer != None and self.outer.has(name)

    func set(self, name, val):
        if name not in self.vars and self.outer != None and self.outer.has(name):
            return self.outer.set(name, val)
        self.vars[name] = val
        return val
