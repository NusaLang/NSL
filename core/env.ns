class Lingkup:
    func __init__(self, lingkup_luar):
        self.luar = lingkup_luar
        self.variabel = {}

    func definisikan(self, nama, nilai):
        self.variabel[nama] = nilai

    func ambil(self, nama):
        if nama in self.variabel:
            return self.variabel[nama]
        if self.luar != None:
            return self.luar.ambil(nama)
        cetak("RuntimeError: Variabel tidak dikenal '" + str(nama) + "'")
        return None

    func ada(self, nama):
        if nama in self.variabel:
            return True
        if self.luar != None:
            return self.luar.ada(nama)
        return False

    func tetapkan(self, nama, nilai):
        if nama in self.variabel:
            self.variabel[nama] = nilai
            return nilai
        if self.luar != None and self.luar.ada(nama):
            return self.luar.tetapkan(nama, nilai)
        self.variabel[nama] = nilai
        return nilai
