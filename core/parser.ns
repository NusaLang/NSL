buat ast_mod = impor("ast");
buat AngkaExpr = ast_mod.AngkaExpr;
buat TeksExpr = ast_mod.TeksExpr;
buat BoolExpr = ast_mod.BoolExpr;
buat KosongExpr = ast_mod.KosongExpr;
buat PengenalExpr = ast_mod.PengenalExpr;
buat BinerExpr = ast_mod.BinerExpr;
buat UnerExpr = ast_mod.UnerExpr;
buat PanggilExpr = ast_mod.PanggilExpr;
buat IndexExpr = ast_mod.IndexExpr;
buat IrisanExpr = ast_mod.IrisanExpr;
buat LarikExpr = ast_mod.LarikExpr;
buat PetaExpr = ast_mod.PetaExpr;
buat TugasExpr = ast_mod.TugasExpr;
buat AksesAnggotaExpr = ast_mod.AksesAnggotaExpr;

buat BlokStmt = ast_mod.BlokStmt;
buat BuatStmt = ast_mod.BuatStmt;
buat FungsiStmt = ast_mod.FungsiStmt;
buat JikaStmt = ast_mod.JikaStmt;
buat SelamaStmt = ast_mod.SelamaStmt;
buat UntukStmt = ast_mod.UntukStmt;
buat UntukDalamStmt = ast_mod.UntukDalamStmt;
buat HasilStmt = ast_mod.HasilStmt;
buat BerhentiStmt = ast_mod.BerhentiStmt;
buat LanjutStmt = ast_mod.LanjutStmt;
buat CobaStmt = ast_mod.CobaStmt;
buat LemparStmt = ast_mod.LemparStmt;
buat EkspresiStmt = ast_mod.EkspresiStmt;
buat KelasStmt = ast_mod.KelasStmt;

kelas Parser {
    fungsi konstruktor(tokens) {
        ini.tokens = tokens;
        ini.pos = 0;
        ini.n = panjang(tokens);
    }

    fungsi intip(offset) {
        buat idx = ini.pos + offset;
        jika idx < ini.n {
            hasil ini.tokens[idx];
        }
        hasil ini.tokens[-1];
    }

    fungsi maju() {
        buat tok = ini.intip(0);
        jika ini.pos < ini.n {
            ini.pos = ini.pos + 1;
        }
        hasil tok;
    }

    fungsi periksa(tipe) {
        hasil ini.intip(0).tipe == tipe;
    }

    fungsi cocok(tipe) {
        jika ini.periksa(tipe) {
            hasil ini.maju();
        }
        hasil kosong;
    }

    fungsi harap(tipe, pesan) {
        buat tok = ini.intip(0);
        jika tok.tipe == tipe {
            hasil ini.maju();
        }
        cetak("Error parser baris " + ke_teks(tok.baris) + ", kolom " + ke_teks(tok.kolom) + ": " + pesan + " (dapat '" + tok.teks + "')");
        hasil kosong;
    }

    fungsi lewati_titik_koma() {
        selama ini.periksa(";") {
            ini.maju();
        }
    }

    fungsi parse() {
        buat program = [];
        selama !ini.periksa("EOF") {
            ini.lewati_titik_koma();
            jika ini.periksa("EOF") {
                berhenti;
            }
            buat stmt = ini.pernyataan();
            jika stmt != kosong {
                program.append(stmt);
            }
            ini.lewati_titik_koma();
        }
        hasil program;
    }

    fungsi pernyataan() {
        buat tok = ini.intip(0);

        jika tok.tipe == "FUNGSI" {
            hasil ini.pernyataan_fungsi();
        } lain jika tok.tipe == "BUAT" {
            hasil ini.pernyataan_buat();
        } lain jika tok.tipe == "KELAS" {
            hasil ini.pernyataan_kelas();
        } lain jika tok.tipe == "PASS" {
            ini.maju();
            ini.cocok(";");
            hasil BlokStmt([]);
        } lain jika tok.tipe == "JIKA" {
            hasil ini.pernyataan_jika();
        } lain jika tok.tipe == "SELAMA" {
            hasil ini.pernyataan_selama();
        } lain jika tok.tipe == "UNTUK" {
            hasil ini.pernyataan_untuk();
        } lain jika tok.tipe == "HASIL" {
            hasil ini.pernyataan_hasil();
        } lain jika tok.tipe == "BERHENTI" {
            ini.maju();
            ini.cocok(";");
            hasil BerhentiStmt();
        } lain jika tok.tipe == "LANJUT" {
            ini.maju();
            ini.cocok(";");
            hasil LanjutStmt();
        } lain jika tok.tipe == "COBA" {
            hasil ini.pernyataan_coba();
        } lain jika tok.tipe == "LEMPAR" {
            hasil ini.pernyataan_lempar();
        } lain jika tok.tipe == "{" {
            hasil ini.blok();
        } lain {
            hasil ini.pernyataan_ekspresi();
        }
    }

    fungsi blok() {
        ini.cocok(":");
        ini.harap("{", "Diharapkan '{'");
        buat stmts = [];

        selama !ini.periksa("}") dan !ini.periksa("EOF") {
            ini.lewati_titik_koma();
            jika ini.periksa("}") {
                berhenti;
            }
            buat s = ini.pernyataan();
            jika s != kosong {
                stmts.append(s);
            }
            ini.lewati_titik_koma();
        }

        ini.harap("}", "Diharapkan '}'");
        hasil BlokStmt(stmts);
    }

    fungsi pernyataan_fungsi() {
        ini.maju();
        buat nama_tok = ini.harap("IDENT", "Diharapkan nama fungsi");
        ini.harap("(", "Diharapkan '(' setelah nama fungsi");

        buat params = [];
        jika !ini.periksa(")") {
            selama benar {
                buat p = ini.harap("IDENT", "Diharapkan nama parameter");
                params.append(p.teks);
                jika ini.cocok("=") != kosong {
                    ini.ekspresi();
                }
                jika ini.cocok(",") == kosong {
                    berhenti;
                }
            }
        }

        ini.harap(")", "Diharapkan ')' setelah daftar parameter");
        ini.cocok(":");
        buat badan = ini.blok();
        hasil FungsiStmt(nama_tok.teks, params, badan);
    }

    fungsi pernyataan_kelas() {
        ini.maju();
        buat nama_tok = ini.harap("IDENT", "Diharapkan nama kelas");
        buat induk_nama = kosong;
        jika ini.cocok("(") != kosong {
            buat id_tok = ini.harap("IDENT", "Diharapkan nama kelas induk");
            induk_nama = id_tok.teks;
            ini.harap(")", "Diharapkan ')'");
        } lain jika ini.cocok("turunan") != kosong atau ini.cocok("extends") != kosong {
            buat id_tok = ini.harap("IDENT", "Diharapkan nama kelas induk");
            induk_nama = id_tok.teks;
        }

        ini.cocok(":");
        ini.harap("{", "Diharapkan '{'");
        buat metode = [];
        selama !ini.periksa("}") dan !ini.periksa("EOF") {
            ini.lewati_titik_koma();
            jika ini.periksa("}") {
                berhenti;
            }
            jika ini.periksa("FUNGSI") {
                metode.append(ini.pernyataan_fungsi());
            } lain jika ini.periksa("PASS") {
                ini.maju();
                ini.cocok(";");
            } lain {
                ini.maju();
            }
            ini.lewati_titik_koma();
        }
        ini.harap("}", "Diharapkan '}'");
        hasil KelasStmt(nama_tok.teks, induk_nama, metode);
    }

    fungsi pernyataan_buat() {
        ini.maju();
        buat nama_tok = ini.harap("IDENT", "Diharapkan nama variabel");

        buat nilai = KosongExpr();
        jika ini.cocok("=") != kosong {
            nilai = ini.ekspresi();
        }
        ini.cocok(";");
        hasil BuatStmt(nama_tok.teks, nilai);
    }

    fungsi pernyataan_jika() {
        ini.maju();
        buat kondisi = ini.ekspresi();
        ini.cocok(":");
        buat maka_blok = ini.blok();

        ini.lewati_titik_koma();
        buat lain_blok = kosong;
        jika ini.cocok("LAIN") != kosong {
            ini.lewati_titik_koma();
            ini.cocok(":");
            ini.lewati_titik_koma();
            jika ini.periksa("JIKA") {
                lain_blok = ini.pernyataan_jika();
            } lain {
                lain_blok = ini.blok();
            }
        }
        hasil JikaStmt(kondisi, maka_blok, lain_blok);
    }

    fungsi pernyataan_selama() {
        ini.maju();
        buat kondisi = ini.ekspresi();
        ini.cocok(":");
        buat badan = ini.blok();
        hasil SelamaStmt(kondisi, badan);
    }

    fungsi pernyataan_untuk() {
        ini.maju();

        jika ini.periksa("(") {
            ini.maju();
            buat init = kosong;
            jika !ini.periksa(";") {
                init = ini.pernyataan();
            } lain {
                ini.maju();
            }

            buat cond = BoolExpr(benar);
            jika !ini.periksa(";") {
                cond = ini.ekspresi();
            }
            ini.harap(";", "Diharapkan ';' di dalam untuk");

            buat pasca = kosong;
            jika !ini.periksa(")") {
                pasca = ini.ekspresi();
            }
            ini.harap(")", "Diharapkan ')'");
            ini.cocok(":");
            buat badan = ini.blok();
            hasil UntukStmt(init, cond, pasca, badan);
        }

        buat var_tok = ini.harap("IDENT", "Diharapkan nama variabel untuk");
        ini.harap("DALAM", "Diharapkan 'dalam' atau 'in'");
        buat iter = ini.ekspresi();
        ini.cocok(":");
        buat badan = ini.blok();
        hasil UntukDalamStmt(var_tok.teks, iter, badan);
    }

    fungsi pernyataan_hasil() {
        ini.maju();
        buat nilai = KosongExpr();
        jika !ini.periksa(";") dan !ini.periksa("}") dan !ini.periksa("EOF") {
            nilai = ini.ekspresi();
        }
        ini.cocok(";");
        hasil HasilStmt(nilai);
    }

    fungsi pernyataan_coba() {
        ini.maju();
        ini.cocok(":");
        buat coba_blok = ini.blok();

        ini.lewati_titik_koma();
        buat tangkap_var = "err";
        buat tangkap_blok = kosong;
        jika ini.cocok("TANGKAP") != kosong {
            ini.lewati_titik_koma();
            jika ini.cocok("(") != kosong {
                buat v = ini.harap("IDENT", "Diharapkan nama variabel exception");
                tangkap_var = v.teks;
                ini.harap(")", "Diharapkan ')'");
            } lain jika ini.periksa("IDENT") {
                buat v = ini.maju();
                tangkap_var = v.teks;
            }
            ini.lewati_titik_koma();
            ini.cocok(":");
            tangkap_blok = ini.blok();
        }

        ini.lewati_titik_koma();
        buat akhirnya_blok = kosong;
        jika ini.cocok("AKHIRNYA") != kosong {
            ini.lewati_titik_koma();
            ini.cocok(":");
            akhirnya_blok = ini.blok();
        }

        hasil CobaStmt(coba_blok, tangkap_var, tangkap_blok, akhirnya_blok);
    }

    fungsi pernyataan_lempar() {
        ini.maju();
        buat val = ini.ekspresi();
        ini.cocok(";");
        hasil LemparStmt(val);
    }

    fungsi pernyataan_ekspresi() {
        buat expr = ini.ekspresi();
        ini.cocok(";");
        hasil EkspresiStmt(expr);
    }

    fungsi ekspresi() {
        hasil ini.penugasan();
    }

    fungsi penugasan() {
        buat target = ini.logika_atau();

        jika ini.periksa("=") atau ini.periksa("+=") atau ini.periksa("-=") atau ini.periksa("*=") atau ini.periksa("/=") {
            buat op_tok = ini.maju();
            buat nilai = ini.penugasan();
            hasil TugasExpr(target, op_tok.teks, nilai);
        }

        hasil target;
    }

    fungsi logika_atau() {
        buat kiri = ini.logika_dan();

        selama ini.periksa("atau") {
            buat op_tok = ini.maju();
            buat kanan = ini.logika_dan();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi logika_dan() {
        buat kiri = ini.kesetaraan();

        selama ini.periksa("dan") {
            buat op_tok = ini.maju();
            buat kanan = ini.kesetaraan();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi kesetaraan() {
        buat kiri = ini.perbandingan();

        selama ini.periksa("==") atau ini.periksa("!=") {
            buat op_tok = ini.maju();
            buat kanan = ini.perbandingan();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi perbandingan() {
        buat kiri = ini.penjumlahan();

        selama ini.periksa("<") atau ini.periksa("<=") atau ini.periksa(">") atau ini.periksa(">=") {
            buat op_tok = ini.maju();
            buat kanan = ini.penjumlahan();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi penjumlahan() {
        buat kiri = ini.perkalian();

        selama ini.periksa("+") atau ini.periksa("-") {
            buat op_tok = ini.maju();
            buat kanan = ini.perkalian();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi perkalian() {
        buat kiri = ini.uner();

        selama ini.periksa("*") atau ini.periksa("/") atau ini.periksa("%") {
            buat op_tok = ini.maju();
            buat kanan = ini.uner();
            kiri = BinerExpr(op_tok.teks, kiri, kanan);
        }

        hasil kiri;
    }

    fungsi uner() {
        jika ini.periksa("!") atau ini.periksa("bukan") atau ini.periksa("-") atau ini.periksa("+") {
            buat op_tok = ini.maju();
            buat operand = ini.uner();
            hasil UnerExpr(op_tok.teks, operand);
        }

        hasil ini.postfix();
    }

    fungsi postfix() {
        buat expr = ini.primer();

        selama benar {
            jika ini.cocok("(") != kosong {
                buat args = [];
                jika !ini.periksa(")") {
                    selama benar {
                        args.append(ini.ekspresi());
                        jika ini.cocok(",") == kosong {
                            berhenti;
                        }
                    }
                }
                ini.harap(")", "Diharapkan ')'");
                expr = PanggilExpr(expr, args);
            } lain jika ini.cocok("[") != kosong {
                buat awal = kosong;
                buat sampai = kosong;
                buat is_irisan = salah;

                jika !ini.periksa(":") {
                    awal = ini.ekspresi();
                }

                jika ini.cocok(":") != kosong {
                    is_irisan = benar;
                    jika !ini.periksa("]") {
                        sampai = ini.ekspresi();
                    }
                }

                ini.harap("]", "Diharapkan ']'");

                jika is_irisan {
                    expr = IrisanExpr(expr, awal, sampai);
                } lain {
                    expr = IndexExpr(expr, awal);
                }
            } lain jika ini.cocok(".") != kosong {
                buat nama_tok = ini.harap("IDENT", "Diharapkan nama anggota setelah '.'");
                expr = AksesAnggotaExpr(expr, nama_tok.teks);
            } lain {
                berhenti;
            }
        }

        hasil expr;
    }

    fungsi primer() {
        buat tok = ini.intip(0);

        jika tok.tipe == "ANGKA" {
            ini.maju();
            hasil AngkaExpr(tok.angka);
        } lain jika tok.tipe == "STRING" {
            ini.maju();
            hasil TeksExpr(tok.teks);
        } lain jika tok.tipe == "BENAR" {
            ini.maju();
            hasil BoolExpr(benar);
        } lain jika tok.tipe == "SALAH" {
            ini.maju();
            hasil BoolExpr(salah);
        } lain jika tok.tipe == "KOSONG" {
            ini.maju();
            hasil KosongExpr();
        } lain jika tok.tipe == "IDENT" {
            ini.maju();
            hasil PengenalExpr(tok.teks);
        } lain jika tok.tipe == "(" {
            ini.maju();
            buat e = ini.ekspresi();
            ini.harap(")", "Diharapkan ')'");
            hasil e;
        } lain jika tok.tipe == "[" {
            ini.maju();
            buat elemen = [];
            jika !ini.periksa("]") {
                selama benar {
                    elemen.append(ini.ekspresi());
                    jika ini.cocok(",") == kosong {
                        berhenti;
                    }
                }
            }
            ini.harap("]", "Diharapkan ']'");
            hasil LarikExpr(elemen);
        } lain jika tok.tipe == "{" {
            ini.maju();
            buat kunci = [];
            buat nilai = [];
            jika !ini.periksa("}") {
                selama benar {
                    buat k = ini.harap("STRING", "Kunci peta harus string");
                    ini.harap(":", "Diharapkan ':' setelah kunci peta");
                    buat v = ini.ekspresi();
                    kunci.append(k.teks);
                    nilai.append(v);
                    jika ini.cocok(",") == kosong {
                        berhenti;
                    }
                }
            }
            ini.harap("}", "Diharapkan '}'");
            hasil PetaExpr(kunci, nilai);
        }

        cetak("Error parser baris " + ke_teks(tok.baris) + ": Token tidak terduga '" + tok.teks + "'");
        ini.maju();
        hasil KosongExpr();
    }
}
