b64Table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

func b64Val(c):
    if c >= "A" and c <= "Z":
        return ord(c) - 65
    if c >= "a" and c <= "z":
        return ord(c) - 97 + 26
    if c >= "0" and c <= "9":
        return ord(c) - 48 + 52
    if c == "+":
        return 62
    if c == "/":
        return 63
    return -1

func encode(s):
    n = len(s)
    out = ""
    i = 0

    while i + 3 <= n:
        b0 = ord(s[i])
        b1 = ord(s[i + 1])
        b2 = ord(s[i + 2])

        out += b64Table[b0 >> 2]
        out += b64Table[((b0 & 3) << 4) | (b1 >> 4)]
        out += b64Table[((b1 & 15) << 2) | (b2 >> 6)]
        out += b64Table[b2 & 63]
        i += 3

    rem = n - i
    if rem == 1:
        b0 = ord(s[i])
        out += b64Table[b0 >> 2]
        out += b64Table[(b0 & 3) << 4]
        out += "=="
    elif rem == 2:
        b0 = ord(s[i])
        b1 = ord(s[i + 1])
        out += b64Table[b0 >> 2]
        out += b64Table[((b0 & 3) << 4) | (b1 >> 4)]
        out += b64Table[(b1 & 15) << 2]
        out += "="

    return out

func decode(s):
    buf = 0
    bits = 0
    out = ""
    n = len(s)
    i = 0

    while i < n:
        c = s[i]
        i += 1
        if c == "=" or c == "\n" or c == "\r" or c == " ":
            continue
        v = b64Val(c)
        if v < 0:
            continue
        buf = (buf << 6) | v
        bits += 6
        if bits >= 8:
            bits -= 8
            b = (buf >> bits) & 255
            out += chr(b)
            buf = buf & ((1 << bits) - 1)

    return out
