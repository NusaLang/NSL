hexChars = "0123456789abcdef"

func toHexByte(b):
    return hexChars[(b >> 4) & 15] + hexChars[b & 15]

func hexVal(c):
    if c >= "0" and c <= "9":
        return ord(c) - 48
    if c >= "a" and c <= "f":
        return ord(c) - 97 + 10
    if c >= "A" and c <= "F":
        return ord(c) - 65 + 10
    return -1

func hexEncode(s):
    out = ""
    n = len(s)
    i = 0
    while i < n:
        out += toHexByte(ord(s[i]))
        i += 1
    return out

func hexDecode(h):
    n = len(h)
    if n % 2 != 0:
        return ""
    out = ""
    i = 0
    while i < n:
        hi = hexVal(h[i])
        lo = hexVal(h[i + 1])
        if hi < 0 or lo < 0:
            return ""
        out += chr((hi << 4) | lo)
        i += 2
    return out

func xorCipher(s, k):
    if len(k) == 0:
        return s
    out = ""
    n = len(s)
    kLen = len(k)
    i = 0
    while i < n:
        b = ord(s[i]) ^ ord(k[i % kLen])
        out += chr(b)
        i += 1
    return out

func urlEncode(s):
    hexU = "0123456789ABCDEF"
    out = ""
    n = len(s)
    i = 0
    while i < n:
        c = s[i]
        unreserved = (c >= "A" and c <= "Z") or (c >= "a" and c <= "z") or (c >= "0" and c <= "9") or c == "-" or c == "_" or c == "." or c == "~"
        if unreserved:
            out += c
        else:
            b = ord(c)
            out = out + "%" + hexU[(b >> 4) & 15] + hexU[b & 15]
        i += 1
    return out

func urlDecode(s):
    out = ""
    n = len(s)
    i = 0
    while i < n:
        c = s[i]
        if c == "%":
            if i + 2 >= n:
                return ""
            hi = hexVal(s[i + 1])
            lo = hexVal(s[i + 2])
            if hi < 0 or lo < 0:
                return ""
            out += chr((hi << 4) | lo)
            i += 2
        elif c == "+":
            out += " "
        else:
            out += c
        i += 1
    return out

func crc32(s):
    crc = 4294967295
    n = len(s)
    i = 0
    while i < n:
        crc = crc ^ ord(s[i])
        j = 0
        while j < 8:
            b = crc & 1
            crc = (crc >> 1) & 2147483647
            if b != 0:
                crc = crc ^ 0xEDB88320
            j += 1
        i += 1
    crc = (crc ^ 4294967295) & 4294967295

    out = ""
    st = 28
    while st >= 0:
        out += hexChars[(crc >> st) & 15]
        st -= 4
    return out

md5K = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
]

md5S = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9,  14, 20, 5, 9,  14, 20, 5, 9,  14, 20, 5, 9,  14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

func toU32(x):
    return x & 4294967295

func rotl32(x, n):
    return toU32((x << n) | (x >> (32 - n)))

func md5Hex(s):
    a0 = 0x67452301
    b0 = 0xefcdab89
    c0 = 0x98badcfe
    d0 = 0x10325476

    bytesList = []
    n = len(s)
    i = 0
    while i < n:
        bytesList.append(ord(s[i]))
        i += 1

    bitLen = n * 8
    bytesList.append(0x80)
    while len(bytesList) % 64 != 56:
        bytesList.append(0)
    b = 0
    while b < 8:
        bytesList.append((bitLen >> (b * 8)) & 255)
        b += 1

    totLen = len(bytesList)
    chunk = 0
    while chunk < totLen:
        mBlock = []
        j = 0
        while j < 16:
            p = chunk + j * 4
            w = bytesList[p] | (bytesList[p + 1] << 8) | (bytesList[p + 2] << 16) | (bytesList[p + 3] << 24)
            mBlock.append(w)
            j += 1

        a = a0
        bVal = b0
        c = c0
        d = d0

        st = 0
        while st < 64:
            f = 0
            g = 0
            if st < 16:
                f = (bVal & c) | ((~bVal) & d)
                g = st
            elif st < 32:
                f = (d & bVal) | ((~d) & c)
                g = (5 * st + 1) % 16
            elif st < 48:
                f = bVal ^ c ^ d
                g = (3 * st + 5) % 16
            else:
                f = c ^ (bVal | (~d))
                g = (7 * st) % 16

            f = toU32(f + a + md5K[st] + mBlock[g])
            a = d
            d = c
            c = bVal
            bVal = toU32(bVal + rotl32(f, md5S[st]))
            st += 1

        a0 = toU32(a0 + a)
        b0 = toU32(b0 + bVal)
        c0 = toU32(c0 + c)
        d0 = toU32(d0 + d)
        chunk += 64

    regs = [a0, b0, c0, d0]
    out = ""
    r = 0
    while r < 4:
        val = regs[r]
        out = out + toHexByte(val & 255) + toHexByte((val >> 8) & 255) + toHexByte((val >> 16) & 255) + toHexByte((val >> 24) & 255)
        r += 1
    return out

func sha1Hex(s):
    h0 = 0x67452301
    h1 = 0xEFCDAB89
    h2 = 0x98BADCFE
    h3 = 0x10325476
    h4 = 0xC3D2E1F0

    bytesList = []
    n = len(s)
    i = 0
    while i < n:
        bytesList.append(ord(s[i]))
        i += 1

    bitLen = n * 8
    bytesList.append(0x80)
    while len(bytesList) % 64 != 56:
        bytesList.append(0)
    b = 7
    while b >= 0:
        bytesList.append((bitLen >> (b * 8)) & 255)
        b -= 1

    totLen = len(bytesList)
    chunk = 0
    while chunk < totLen:
        w = []
        j = 0
        while j < 16:
            p = chunk + j * 4
            word = (bytesList[p] << 24) | (bytesList[p + 1] << 16) | (bytesList[p + 2] << 8) | bytesList[p + 3]
            w.append(word)
            j += 1
        while j < 80:
            x = w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16]
            w.append(rotl32(x, 1))
            j += 1

        a = h0
        bVal = h1
        c = h2
        d = h3
        e = h4

        t = 0
        while t < 80:
            f = 0
            k = 0
            if t < 20:
                f = (bVal & c) | ((~bVal) & d)
                k = 0x5A827999
            elif t < 40:
                f = bVal ^ c ^ d
                k = 0x6ED9EBA1
            elif t < 60:
                f = (bVal & c) | (bVal & d) | (c & d)
                k = 0x8F1BBCDC
            else:
                f = bVal ^ c ^ d
                k = 0xCA62C1D6

            temp = toU32(rotl32(a, 5) + f + e + k + w[t])
            e = d
            d = c
            c = rotl32(bVal, 30)
            bVal = a
            a = temp
            t += 1

        h0 = toU32(h0 + a)
        h1 = toU32(h1 + bVal)
        h2 = toU32(h2 + c)
        h3 = toU32(h3 + d)
        h4 = toU32(h4 + e)
        chunk += 64

    out = ""
    regs = [h0, h1, h2, h3, h4]
    r = 0
    while r < 5:
        val = regs[r]
        st = 24
        while st >= 0:
            out += toHexByte((val >> st) & 255)
            st -= 8
        r += 1
    return out

func gcd(a, b):
    while b != 0:
        t = b
        b = a % b
        a = t
    return a

func modPow(b, e, m):
    if m == 1:
        return 0
    res = 1
    b = b % m
    while e > 0:
        if e % 2 == 1:
            res = (res * b) % m
        e = e / 2
        b = (b * b) % m
    return res

modpow = modPow

func isPrime(n):
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

adalahPrima = isPrime
