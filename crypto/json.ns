func stringify(v):
    if v == None:
        return "null"
    t = type(v)
    if t == "kosong" or t == "NoneType":
        return "null"
    elif t == "boolean" or t == "bool":
        return "true" if v else "false"
    elif t == "angka" or t == "int" or t == "float":
        return str(v)
    elif t == "string" or t == "str" or t == "teks":
        out = "\""
        n = len(v)
        i = 0
        while i < n:
            c = v[i]
            if c == "\"":
                out += "\\\""
            elif c == "\\":
                out += "\\\\"
            elif c == "\n":
                out += "\\n"
            elif c == "\r":
                out += "\\r"
            elif c == "\t":
                out += "\\t"
            else:
                out += c
            i += 1
        return out + "\""
    elif t == "larik" or t == "list":
        parts = []
        for x in v:
            parts.append(stringify(x))
        return "[" + ", ".join(parts) + "]"
    elif t == "peta" or t == "dict":
        parts = []
        for k in v:
            parts.append(stringify(k) + ": " + stringify(v[k]))
        return "{" + ", ".join(parts) + "}"
    return "null"

class JsonParser:
    func constructor(self, src):
        self.src = src
        self.pos = 0
        self.n = len(src)

    func skipWs(self):
        while self.pos < self.n:
            c = self.src[self.pos]
            if c == " " or c == "\t" or c == "\n" or c == "\r":
                self.pos += 1
            else:
                break

    func peek(self):
        self.skipWs()
        if self.pos < self.n:
            return self.src[self.pos]
        return ""

    func parse(self):
        self.skipWs()
        res = self.parseVal()
        self.skipWs()
        return res

    func parseVal(self):
        c = self.peek()
        if c == "\"":
            return self.parseStr()
        if c == "{":
            return self.parseObj()
        if c == "[":
            return self.parseArr()
        if c == "t" or c == "f":
            return self.parseBool()
        if c == "n":
            return self.parseNull()
        if (c >= "0" and c <= "9") or c == "-":
            return self.parseNum()
        return None

    func parseStr(self):
        self.pos += 1
        out = ""
        while self.pos < self.n and self.src[self.pos] != "\"":
            c = self.src[self.pos]
            self.pos += 1
            if c == "\\" and self.pos < self.n:
                esc = self.src[self.pos]
                self.pos += 1
                if esc == "n":
                    out += "\n"
                elif esc == "t":
                    out += "\t"
                elif esc == "r":
                    out += "\r"
                elif esc == "\"":
                    out += "\""
                elif esc == "\\":
                    out += "\\"
                else:
                    out += esc
            else:
                out += c
        if self.pos < self.n:
            self.pos += 1
        return out

    func parseNum(self):
        start = self.pos
        while self.pos < self.n:
            c = self.src[self.pos]
            if (c >= "0" and c <= "9") or c == "." or c == "-" or c == "e" or c == "E" or c == "+":
                self.pos += 1
            else:
                break
        return float(self.src[start:self.pos])

    func parseBool(self):
        if self.src[self.pos:self.pos + 4] == "true":
            self.pos += 4
            return True
        if self.src[self.pos:self.pos + 5] == "false":
            self.pos += 5
            return False
        return False

    func parseNull(self):
        if self.src[self.pos:self.pos + 4] == "null":
            self.pos += 4
        return None

    func parseArr(self):
        self.pos += 1
        arr = []
        self.skipWs()
        if self.peek() == "]":
            self.pos += 1
            return arr
        while True:
            arr.append(self.parseVal())
            self.skipWs()
            pk = self.peek()
            if pk == ",":
                self.pos += 1
            elif pk == "]":
                self.pos += 1
                break
            else:
                break
        return arr

    func parseObj(self):
        self.pos += 1
        obj = {}
        self.skipWs()
        if self.peek() == "}":
            self.pos += 1
            return obj
        while True:
            self.skipWs()
            k = self.parseStr()
            self.skipWs()
            if self.peek() == ":":
                self.pos += 1
            v = self.parseVal()
            obj[k] = v
            self.skipWs()
            pk = self.peek()
            if pk == ",":
                self.pos += 1
            elif pk == "}":
                self.pos += 1
                break
            else:
                break
        return obj

func parse(s):
    p = JsonParser(s)
    return p.parse()

dumps = stringify
loads = parse
