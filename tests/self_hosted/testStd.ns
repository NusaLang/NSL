sysModule = impor("sys")

func assert(cond, msg = ""):
    if not cond:
        print("FAIL: " + msg)
        sysModule.exit(1)

func loadModule(path):
    try:
        return impor(path)
    except e:
        return impor("../" + path)

i18n = loadModule("std/i18n.ns")
proc = loadModule("std/proc.ns")
sys = loadModule("std/sysmod.ns")
lib = loadModule("std/nslib.ns")
math = loadModule("std/nsstd.ns")
b64 = loadModule("crypto/base64.ns")
crypto = loadModule("crypto/crypto.ns")
json = loadModule("crypto/json.ns")
sha = loadModule("crypto/sha256.ns")
net = loadModule("net/net.ns")
http = loadModule("net/http.ns")
ws = loadModule("net/ws.ns")
audio = loadModule("media/audio.ns")
gambar = loadModule("media/gambar.ns")

assert(i18n.getLang() == "id", "i18n initial lang should be id")
assert(i18n.tr("indo", "eng") == "indo", "tr should return id text")
i18n.setLang("en")
assert(i18n.isEn(), "isEn should be true")
assert(i18n.tr("indo", "eng") == "eng", "tr should return en text")
i18n.aturBahasa("id")
assert(i18n.ambilBahasa() == "id", "ambilBahasa should be id")
cetak("PASS: std/i18n.ns")

res = proc.runCommand("echo", ["hello"])
assert(res.status == 0, "runCommand status should be 0")
assert(res.isSuccess(), "isSuccess should be true")
assert(res.sukses(), "sukses alias should be true")
assert(res.returncode == 0, "returncode should be 0")
assert(res.stdout.strip() == "hello", "stdout should be hello")
assert(res.output.strip() == "hello", "output should be hello")
sres = proc.runShell("echo shell")
assert(sres.status == 0, "runShell status should be 0")
assert(sres.output.strip() == "shell", "runShell output should be shell")
cetak("PASS: std/proc.ns")

assert(sys.isAbs("/a/b"), "isAbs should be true for /a/b")
assert(not sys.isAbs("a/b"), "isAbs should be false for a/b")
assert(sys.baseName("/a/b/c.txt") == "c.txt", "baseName should be c.txt")
assert(sys.dirName("/a/b/c.txt") == "/a/b", "dirName should be /a/b")
ext = sys.splitExt("foo.tar.gz")
assert(ext[0] == "foo.tar" and ext[1] == ".gz", "splitExt failed")
assert(sys.joinPath(["a", "b", "c"]) == "a/b/c", "joinPath failed")
assert(sys.normPath("a/./b/../c") == "a/c", "normPath failed")
assert(sys.exists("std/i18n.ns"), "std/i18n.ns should exist")
assert(sys.isFile("std/i18n.ns"), "std/i18n.ns should be file")
assert(sys.isDir("std"), "std should be dir")
assert(sys.platform() == "linux", "platform should be linux")
cetak("PASS: std/sysmod.ns")

assert(lib.isSpace(" "), "isSpace should be true")
assert(lib.isDigit("7"), "isDigit should be true")
assert(lib.isAlpha("k"), "isAlpha should be true")
assert(lib.isAlnum("k"), "isAlnum should be true")
assert(lib.isAlnumStr("k7"), "isAlnumStr should be true")
assert(lib.find("hello", "ll") == 2, "find failed")
assert(lib.rfind("hello", "l") == 3, "rfind failed")
assert(lib.count("banana", "a") == 3, "count failed")
assert(lib.replace("abc", "b", "z") == "azc", "replace failed")
assert(lib.startsWith("apple", "app"), "startsWith failed")
assert(lib.endsWith("apple", "ple"), "endsWith failed")
assert(lib.indexOf([1, 2, 3], 2) == 1, "indexOf failed")
assert(lib.unique([1, 1, 2, 3, 3]) == [1, 2, 3], "unique failed")
m = {"x": 10, "y": 20}
assert(lib.hasKey(m, "x"), "hasKey failed")
assert(lib.get(m, "x") == 10, "get failed")
cetak("PASS: std/nslib.ns")

assert(math.abs(-5) == 5, "abs failed")
assert(math.floor(3.9) == 3, "floor failed")
assert(math.ceil(3.1) == 4, "ceil failed")
assert(math.sqrt(25) == 5, "sqrt failed")
assert(math.gcd(24, 36) == 12, "gcd failed")
assert(math.factorial(4) == 24, "factorial failed")
assert(math.isClose(0.1 + 0.2, 0.3), "isClose failed")
assert(math.sin(0) == 0, "sin(0) failed")
assert(math.cos(0) == 1, "cos(0) failed")
cetak("PASS: std/nsstd.ns")

encB64 = b64.encode("nusantara")
assert(b64.decode(encB64) == "nusantara", "base64 failed")
hexVal = crypto.hexEncode("abc")
assert(crypto.hexDecode(hexVal) == "abc", "hex failed")
assert(crypto.crc32("hello") == "3610a686", "crc32 failed")
assert(crypto.md5Hex("hello") == "5d41402abc4b2a76b9719d911017c592", "md5 failed")
assert(crypto.sha1Hex("hello") == "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d", "sha1 failed")
assert(sha.sha256Hex("hello") == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", "sha256 failed")
jStr = json.dumps({"a": 1, "b": "str", "c": True})
jObj = json.loads(jStr)
assert(jObj["a"] == 1 and jObj["b"] == "str" and jObj["c"] == True, "json failed")
cetak("PASS: crypto/")

addr = net.Address("127.0.0.1", 8080)
assert(addr.toString() == "127.0.0.1:8080", "Address failed")
nb = net.NetworkBuffer()
nb.write("chunk1\r\nchunk2")
assert(nb.readUntil("\r\n") == "chunk1", "NetworkBuffer failed")
u = http.parseUrl("http://localhost:8080/test?foo=bar#hash")
assert(u.host == "localhost" and u.port == 8080 and u.path == "/test", "parseUrl failed")
assert(u.getParameters()["foo"] == "bar", "getParameters failed")
wsFrame = ws.wsMakeFrame("ping", ws.wsOpText, True)
wsParsed = ws.wsParseFrame(wsFrame)
assert(wsParsed["ok"] and wsParsed["payload"] == "ping", "wsFrame failed")
cetak("PASS: net/")

wInfo = audio.wavInfo("nonexistent.wav")
assert(wInfo.find("failed to open/parse") != -1 or wInfo.find("gagal") != -1, "audio wavInfo failed")
bInfo = gambar.bmpInfo("nonexistent.bmp")
assert(bInfo.find("failed to open/parse") != -1 or bInfo.find("gagal") != -1, "gambar bmpInfo failed")
cetak("PASS: media/")

cetak("ALL MODULE TESTS PASSED SUCCESSFULLY!")
