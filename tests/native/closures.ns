func fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)
print(fact(20))
func depth(n):
    if n == 0:
        return 0
    return 1 + depth(n - 1)
print(depth(20000))
fs = [lambda x: x + 1, lambda x: x * 2, lambda x: x - 3]
for f in fs:
    print(f(10))
func compose(f, g, x):
    return f(g(x))
print(compose(fs[0], fs[1], 5))
func counter():
    n = 0
    n += 1
    return n
print(counter(), counter())
print((lambda a, b: a * b)(6, 7))
