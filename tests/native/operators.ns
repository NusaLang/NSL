print(-2.5 < -1, 0.5 > 0.25, 2.5 == 2.5, 1 == 1.0, 3 > 2.5)
print(1.5 + 1, 1 + 1.5, 10 - 0.5, 2 * 0.25, 7.5 / 2, 7 / 2.0, 5.5 % 2)
