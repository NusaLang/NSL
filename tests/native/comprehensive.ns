import sys

helper = impor("helperModule.ns")

func assert(cond, msg):
    if not cond:
        print("FAIL:", msg)
        throw msg

# 1. Higher-order functions & callbacks
func applyFunc(fn, arg):
    return fn(arg)

func square(n):
    return n * n

func addTen(n):
    return n + 10

assert(applyFunc(square, 7) == 49, "callback named func 1")
assert(applyFunc(addTen, 5) == 15, "callback named func 2")
assert(applyFunc(lambda x: x * 3 + 1, 4) == 13, "callback lambda")

# 2. Class imports and cross-module OOP
v1 = helper.Vector2D(3, 4)
assert(v1.x == 3, "module class field x")
assert(v1.y == 4, "module class field y")
assert(v1.magnitudeSquared() == 25, "module class method call")

v2 = helper.createVector(5, 12)
assert(v2.magnitudeSquared() == 169, "module factory func creating class")

v3 = helper.transform(v1, 2)
assert(v3.x == 6 and v3.y == 8, "module transform")
assert(v3.magnitudeSquared() == 100, "transformed vector magnitude")

# 3. sys.argv inspection
assert(len(sys.argv) >= 1, "sys.argv len")
assert(len(sys.argv[0]) > 0, "sys.argv[0] string")

# 4. Built-ins
arr = [1, 2, 3]
push(arr, 4)
assert(len(arr) == 4, "push")
popped = pop(arr)
assert(popped == 4 and len(arr) == 3, "pop")
assert(str(123) == "123", "str int")
assert(int("456") == 456, "int str")
t = time()
assert(t > 0, "time > 0")

print("COMPREHENSIVE NATIVE TESTS PASSED")
