class Vector2D:
    func __init__(self, x, y):
        self.x = x
        self.y = y

    func magnitudeSquared(self):
        return self.x * self.x + self.y * self.y

func createVector(x, y):
    return Vector2D(x, y)

func transform(vec, factor):
    return Vector2D(vec.x * factor, vec.y * factor)
