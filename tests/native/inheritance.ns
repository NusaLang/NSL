class A:
    func __init__(self, n):
        self.n = n
        self.tag = "A"
    func who(self):
        return "A" + str(self.n)
    func base(self):
        return self.who()
class B(A):
    func __init__(self, n, m):
        self.n = n
        self.m = m
        self.tag = "B"
    func who(self):
        return "B" + str(self.n) + str(self.m)
class C(B):
    func extra(self):
        return self.n + self.m
a = A(1)
b = B(2, 3)
c = C(4, 5)
print(a.who(), b.who(), c.who(), a.base(), b.base(), c.base())
print(c.extra(), c.tag, b.tag, a.tag)
b.n = 99
print(b.n, b.who())
objs = [a, b, c]
for o in objs:
    print(o.who())
