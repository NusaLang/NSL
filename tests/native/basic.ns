func gcd(a, b):
    while b != 0:
        t = a % b
        a = b
        b = t
    return a

func fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)

func many(a, b, c, d, e, f, g):
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7

total = 0
i = 0
while i < 10:
    if i == 3:
        i += 1
        continue
    if i == 8:
        break
    total += i
    i += 1

print(gcd(48, 18), fact(10), many(1, 2, 3, 4, 5, 6, 7), total, -5 + 2, 7 / 2, 7 % 3)
print("ok", 1 < 2 and 2 < 3, 1 > 2 or 0, not 0)
