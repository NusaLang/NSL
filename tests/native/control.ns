s = 0
for (i = 0; i < 5; i += 1):
    s += i
print(s)
w = 0
t = 0
while w < 10:
    w += 1
    if w == 3:
        continue
    if w == 8:
        break
    t += w
print(t)
x = 5 if s > 3 else 9
print(x)
print(not True, 1 < 2 and 2 < 3, 0 or 7)
print(5 & 3, 5 | 3, 5 ^ 3, 1 << 4, 256 >> 2, ~5)
print(17 % 5, -7 + 2)
