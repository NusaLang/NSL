func greet(name, greeting = "Hi", punct = "!"):
    return greeting + ", " + name + punct
print(greet("Ann"))
print(greet("Bob", "Yo"))
print(greet("Cy", "Hey", "?"))
class P:
    func __init__(self, a, b = 10):
        self.a = a
        self.b = b
    func total(self, extra = 1):
        return self.a + self.b + extra
p = P(1)
q = P(1, 2)
print(p.total(), q.total(5), p.a, q.b)
