path = "nslFileSystemTest.txt"
tulis_file(path, "line one\nline two\n")
print(file_ada(path), file_ada("nslNoSuchFileXyz"))
text = baca_file(path)
print(len(text), text)
print(len(baca_file("nslNoSuchFileXyz")))
res = JalankanPerintah("echo", ["hello", "world"])
print(res.status, res.keluaran, len(res.error))
bad = JalankanPerintah("sh", ["-c", "echo oops 1>&2; exit 3"])
print(bad.status, len(bad.keluaran), bad.error)
cat = JalankanPerintah("cat", [path])
print(cat.keluaran == text)
JalankanPerintah("rm", ["-f", path])
print(file_ada(path))
