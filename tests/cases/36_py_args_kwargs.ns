def f(a, *r):
    return [a, r]
print(f(1), f(1, 2, 3), f(1, [2]))
def g(*args, **kw):
    return [len(args), kw]
print(g(), g(1, 2), g(x=1, y=2), g(1, k=3))
def h(a, b=2, *rest, **kw):
    return [a, b, rest, kw]
print(h(1), h(1, 5, 6, 7), h(1, z=9), h(a=3), h(1, 2, 3, q=4))
xs = [1, 2]
d = {"y": 5}
def k(a, b, c=0, **kw):
    return [a, b, c, kw]
print(k(*xs), k(*xs, c=7), k(0, *xs), k(*xs, **d), k(*xs, 9, **{"z": 1}))
class P:
    def __init__(self, *items, sep=","):
        self.items = items
    def total(self, *more, **kw):
        return sum(self.items) + sum(more) + len(kw)
p = P(1, 2, 3)
print(p.items, p.total(), p.total(10, x=1))
print("ok", *["a", "b"], sep="-")
