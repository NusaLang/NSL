buat tok = jwt_buat(peta_baru(), "rahasia");
cetak(tipe(tok));
buat p = peta_baru();
p["sub"] = "user1";
p["n"] = 7;
buat tok2 = jwt_buat(p, "rahasia");
buat cek = jwt_verifikasi(tok2, "rahasia");
cetak(cek["sub"]);
cetak(cek["n"]);
cetak(jwt_verifikasi(tok2, "salah"));

