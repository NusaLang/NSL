import itertools
from itertools import islice, count, chain, product, permutations, combinations, groupby, accumulate, zip_longest
import heapq
import bisect
import operator
import statistics
import textwrap
print(list(islice(count(5, 2), 4)))
print(list(chain([1, 2], "ab")))
print(list(product([1, 2], "ab")))
print(list(permutations([1, 2, 3], 2)))
print(list(combinations("abcd", 2)))
print([(k, list(g)) for k, g in groupby([1, 1, 2, 3, 3])])
print(list(accumulate([1, 2, 3, 4])))
print(list(zip_longest([1, 2, 3], "ab", fillvalue="-")))
print(list(itertools.takewhile(lambda x: x < 3, count())))
print(list(itertools.pairwise([1, 2, 3])))
h = []
for x in [5, 1, 4, 2, 3]:
    heapq.heappush(h, x)
print([heapq.heappop(h) for _ in range(5)])
h2 = [(3, "c"), (1, "a"), (2, "b")]
heapq.heapify(h2)
print(heapq.heappop(h2), heapq.nlargest(2, [4, 9, 1, 7]))
a = [1, 3, 5, 7]
print(bisect.bisect_left(a, 5), bisect.bisect_right(a, 5))
bisect.insort(a, 4)
print(a)
print(operator.itemgetter(1)([9, 8, 7]), operator.add(2, 3), sorted([(1, "b"), (0, "z")], key=operator.itemgetter(0)))
print(statistics.mean([1, 2, 3, 4]), statistics.median([5, 1, 3]), statistics.mode([1, 2, 2, 3]), round(statistics.stdev([1, 2, 3, 4]), 4))
print(textwrap.wrap("the quick brown fox jumps over the lazy dog", 15))
print(textwrap.dedent("   a\n   b"))
