fungsi kuadrat(n) { hasil n * n; }

buat saluran = kanal_baru();
fungsi kirim_kuadrat(n) { kanal_kirim(saluran, kuadrat(n)); }
untuk (buat i = 0; i < 5; i = i + 1) {
    jalan(kirim_kuadrat, i);
}
buat total = 0;
untuk (buat i = 0; i < 5; i = i + 1) {
    total = total + kanal_terima(saluran);
}
cetak("total kuadrat 0..4:", total);

buat jobs = kanal_baru(10);
buat keluaran = kanal_baru();
fungsi pekerja() {
    buat terus = benar;
    selama terus {
        buat job = kanal_terima(jobs);
        jika job == kosong {
            terus = salah;
        } lain {
            kanal_kirim(keluaran, kuadrat(job));
        }
    }
}
buat n_worker = 4;
untuk (buat w = 0; w < n_worker; w = w + 1) { jalan(pekerja); }
fungsi bagi_job() {
    untuk (buat i = 0; i < 20; i = i + 1) { kanal_kirim(jobs, i); }
    untuk (buat w = 0; w < n_worker; w = w + 1) { kanal_kirim(jobs, kosong); }
}
jalan(bagi_job);
buat total2 = 0;
untuk (buat i = 0; i < 20; i = i + 1) {
    total2 = total2 + kanal_terima(keluaran);
}
cetak("total kuadrat 0..19 lewat 4 worker:", total2);

buat wg = wg_baru();
buat saluran3 = kanal_baru();
fungsi kirim_dan_selesai(n) {
    kanal_kirim(saluran3, kuadrat(n));
    wg_selesai(wg);
}
wg_tambah(wg, 5);
untuk (buat i = 0; i < 5; i = i + 1) { jalan(kirim_dan_selesai, i); }
wg_tunggu(wg);
cetak("waitgroup selesai");
buat total3 = 0;
untuk (buat i = 0; i < 5; i = i + 1) {
    total3 = total3 + kanal_terima(saluran3);
}
cetak("total kuadrat 0..4 lewat waitgroup:", total3);

buat kanal_a = kanal_baru();
buat kanal_b = kanal_baru();
fungsi kirim_ke_b() { kanal_kirim(kanal_b, "duluan dari B"); }
jalan(kirim_ke_b);
buat r = pilih_kanal([kanal_a, kanal_b]);
cetak("pilih_kanal indeks:", r["indeks"], "nilai:", r["nilai"]);

buat kt = kanal_baru(3);
kanal_kirim(kt, 1);
kanal_kirim(kt, 2);
cetak("panjang kanal:", kanal_panjang(kt));
cetak(kanal_terima(kt));
cetak(kanal_terima(kt));
kanal_tutup(kt);
cetak("kanal ditutup");

buat kdata = kanal_baru();
fungsi kirim_beragam() {
    kanal_kirim(kdata, "teks");
    kanal_kirim(kdata, [1, 2, 3]);
    buat m = peta_baru();
    m["k"] = "v";
    kanal_kirim(kdata, m);
}
jalan(kirim_beragam);
cetak(kanal_terima(kdata));
cetak(kanal_terima(kdata));
cetak(kanal_terima(kdata)["k"]);
