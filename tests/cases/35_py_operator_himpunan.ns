try:
    print("a")
finally:
    print("cleanup")
def f():
    try:
        raise "boom"
    finally:
        print("fin")
try:
    f()
except e:
    print("caught", e)
a = {1, 2, 3, 2}
b = {2, 3, 4}
print(len(a), 2 in a, a | b, a & b, a - b, a ^ b, a.union(b), a.issubset({1, 2, 3, 4}))
a.add(9)
a.add(1)
print(a)
print(5 & 3, 5 | 3, 5 ^ 3, 1 << 4, 256 >> 2, ~5)
x = 10
x //= 3
x **= 2
x %= 5
x |= 8
x <<= 1
print(x)
class C:
    def __init__(self):
        self.n = 0
        self.d = {"k": 1}
    def inc(self):
        self.n += 1
        self.d["k"] *= 5
c = C()
c.inc()
c.inc()
print(c.n, c.d)
