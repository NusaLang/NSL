print("%s-%d-%5.2f" % ("a", 3, 2.5), "{:>5}|{:<5}|{:^5}".format(1, 2, 3))
print(f"{3.14159:.2f} {42:05d} {'x':>3} {255:x} {1234567:,}")
print(list(range(10, 0, -3)), list(reversed([1, 2])), any([]), all([]))
print(isinstance(1, int), isinstance("a", str), isinstance([], list), isinstance(1.5, float))
g = {"a": 1}
g.update(b=2)
print(g, list(g), "a" in g, g.get("z", 0))
