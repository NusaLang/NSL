import json, re, sys, os, time, random, math
from collections import defaultdict, Counter, deque
from dataclasses import dataclass
from typing import Optional, List

@dataclass
class Emp:
    name: str
    dept: str
    sal: float
    mgr: Optional[str] = None

emps = [Emp("a", "x", 10.0), Emp("b", "y", 20.0, "a"), Emp("c", "x", 30.0, "a")]
by = defaultdict(list)
for e in emps:
    by[e.dept].append(e)
for d, es in sorted(by.items()):
    print(d, len(es), sum(e.sal for e in es) / len(es), max(es, key=lambda e: e.sal).name)
print(json.dumps([e.__dict__ if hasattr(e, "__dict__") else vars(e) for e in emps][:1]))
words = re.findall(r"[a-z]+", "the cat and the hat and the bat")
c = Counter(words)
print(c.most_common(2), dict(c)["the"])
q = deque([(0, 0)])
seen = {(0, 0)}
steps = 0
while q:
    x, y = q.popleft()
    steps += 1
    for dx, dy in ((1, 0), (0, 1)):
        n = (x + dx, y + dy)
        if n[0] < 3 and n[1] < 3 and n not in seen:
            seen.add(n)
            q.append(n)
print(steps, len(seen))
matrix = [[i * j for j in range(3)] for i in range(3)]
print(matrix, [list(r) for r in zip(*matrix)])
print({k: v for k, v in zip("abc", range(3))}, {x % 3 for x in range(10)})
s = "Hello, World"
print(s.lower().count("l"), s[::-1], s.split(", "), "-".join(reversed(s.split(", "))))
print(f"{'left':<8}|{'right':>8}|{3.14159:8.3f}|{255:#x}|{1e6:,.0f}")
def memo(f):
    cache = {}
    def w(n):
        if n not in cache:
            cache[n] = f(n)
        return cache[n]
    return w
@memo
def fib(n):
    return n if n < 2 else fib(n - 1) + fib(n - 2)
print(fib(50))
