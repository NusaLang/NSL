with open("/tmp/nusa_t54.txt") as f:
    print([l.strip() for l in f])
print(sorted([("b", 2), ("a", 2), ("c", 1)], key=lambda t: (t[1], t[0])))
print(list(map(str, [1, 2])), list(filter(None, [0, 1, "", "a"])), any(x > 2 for x in [1, 3]))
x = 10
def outer():
    y = 1
    def inner():
        nonlocal y
        y += 1
        return y
    return inner
i = outer()
print(i(), i())
print(isinstance(True, int), 7 // 2 * 2 + 7 % 2, 2 ** 10, 10 ** -1, abs(-2.5), pow(2, 3), bin(5), hex(255), oct(8))
print(chr(65), ord("a"), "abc".isalpha(), "12".isdigit(), " a ".strip(), "a b".title())
