a, b = 1, 2
a, b = b, a
print(a, b)
for i, x in enumerate([5, 6]):
    print(i, x)
print([x * 2 for x in [1, 2, 3]], [x for x in range(10) if x % 2 == 0])
print({k: k * 2 for k in [1, 2]})
print([(i, j) for i in range(2) for j in range(2) if i != j])
x = [1, 2, 3, 4]
print(x[1:3], x[::-1], x[-2:], x[::2], x[3:0:-1], "abcdef"[::-2])
print(divmod(7, 2), 7 // 2, -7 // 2, 2 ** 10, 7 % 3, "%d items %s" % (3, "x"))
print("x", "y", sep="-", end="!\n")
print(sorted([3, 1, 2], reverse=True), sorted(["bb", "a"], key=len), max([1, 5], default=0))
def f(a, b=2, c=3):
    return a * 100 + b * 10 + c
print(f(1), f(1, c=9), f(1, 5, c=0), f(a=7, b=1))
class P:
    def __init__(self, x, y=5):
        self.x = x
        self.y = y
    def m(self, k=1, j=2):
        return self.x + self.y + k + j
p = P(1, y=2)
print(p.x, p.y, p.m(j=10), P(x=3).y)
y = [1, 2, 3]
del y[0]
d = {"a": 1, "b": 2}
del d["a"]
print(y, d)
assert 1 == 1
d.update(b=5, c=3)
print(d, "a-b".split("-", maxsplit=1), "{a}-{b}".format(a=1, b=2))
lst = [3, 1, 2]
lst.sort(reverse=True)
print(lst, sum(i * i for i in [1, 2]))
q, r, s = [10, 20, 30]
print(q + r + s)
def g():
    p1, q1 = 1, 2
    if True:
        r1, s1 = 3, 4
    return p1 + q1 + r1 + s1
print(g())
print(bool(0), bool([1]), abs(-3), round(2.5), int("ff", 16), "abc".upper(), "  hi ".strip())
