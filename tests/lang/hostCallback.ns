net = impor("net/http.ns")
srv = net.HttpServer()
calls = 0
func hello(req):
    return net.textResponse("halo " + req.path)
func data(req):
    return net.jsonResponse({"n": 42})
srv.get("/hello", hello)
srv.post("/data", data)
srv.get("/lambda", lambda req: net.textResponse("lambda ok"))
r1 = srv.handleRequest(net.HttpRequest("GET", "/hello"))
print(r1.status, r1.body)
r2 = srv.handleRequest(net.HttpRequest("POST", "/data"))
print(r2.status, r2.body)
r3 = srv.handleRequest(net.HttpRequest("GET", "/lambda"))
print(r3.status, r3.body)
r4 = srv.handleRequest(net.HttpRequest("GET", "/nope"))
print(r4.status)
print(net.parseQuery("a=1&b=hello%20world&c")["b"], len(net.parseQuery("a=1&b=2")))
