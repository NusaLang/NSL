s = "  Hello, World  "
print(s.strip() + "|" + s.lower().strip() + "|" + s.upper().strip())
parts = "a,b,c,d".split(",")
print(len(parts), parts[0], parts[3])
print("-".join(parts))
print("hello".find("l"), "hello".find("z"), "hello".find("l", 3), "hello".find("l", 4))
print("hello".startswith("he"), "hello".endswith("lo"), "hello".startswith("x"))
print("123".isdigit(), "12a".isdigit(), "abc".isalpha(), "ab1".isalnum())
print(ord("A"), chr(66), ord("a") - ord("A"))
w = "abcdef"
print(w[-1], w[-3], w[1:3], w[:2], w[4:], w[-2:], w[2:100])
print("ab" * 3, len("x" * 10))
print("a" < "b", "abc" < "abd", "b" > "a", "abc" == "abc")
