func apply(fn, a):
    return fn(a)
func square(n):
    return n * n
print(apply(square, 7))
print(apply(lambda x: x * 3 + 1, 4))
double = lambda x: x * 2
print(double(21))
fs = [lambda x: x + 1, lambda x: x * 2, lambda x: x - 3]
for f in fs:
    print(f(10))
func compose(f, g, x):
    return f(g(x))
print(compose(fs[0], fs[1], 5))
print((lambda a, b: a * b)(6, 7))
func many(a, b, c, d, e, f, g, h):
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
print(many(1, 2, 3, 4, 5, 6, 7, 8))
