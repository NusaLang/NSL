for i in range(1, 40):
    print(i / 7, i * 0.1, 1.0 / i, i / 3.0 * 1000000, 1 / (i * 1000))
x = 1.0
for k in range(45):
    x = x * 10
    print(x)
y = 1.0
for k in range(45):
    y = y / 10
    print(y)
z = 1.0
for k in range(70):
    z = z * 2
    if k != 62:
        print(z, 1 / z)
total = 0.0
for i in range(1, 200):
    total = total + 1.0 / i
    if i % 20 == 0:
        print(total)
r = 0.5
for i in range(60):
    r = r * 1.37 + 0.011
    print(r)
print(0.1 + 0.2, 0.1 * 3, 1.1 * 1.1, 4.35 * 100, 1.15 + 2.35)
print(2.5 * 4, 7.0 / 2, 9.99 + 0.01, 100.0 / 3.0, 1e300 * 1e-10)
print(123456789.123456789, 0.000123456, 98765.4321e-3, 1e15 + 0.3, 1e16 + 1)
print(0.0 - 0.5, 0.0 - 1e-7, 3.0 * 1e-5, 2.0 / 3e8)
w = 3
print(w * 1.5, w / 2, w / 3, (w + 0.5) * 2, w * w * w * 1.0)
