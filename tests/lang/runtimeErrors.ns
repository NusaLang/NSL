func probe(fn):
    try:
        fn()
        return "no error"
    catch e:
        return type(e) + " " + str("pesan" in e) + " " + str(len(e.pesan) > 0)
arr = [1, 2]
print(probe(lambda: arr[5]))
print(probe(lambda: int("abc")))
print(probe(lambda: 1 / 0))
try:
    throw "custom"
catch e2:
    print(type(e2), e2)
try:
    throw {"pesan": "mine", "kode": 7}
catch e3:
    print(e3.pesan, e3["kode"])
print("done")
