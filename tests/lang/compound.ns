class Counter:
    func __init__(self):
        self.n = 0
        self.items = []
        self.map = {"a": 1}
    func inc(self, by = 1):
        self.n += by
        return self
    func add(self, v):
        push(self.items, v)
        return self
    func total(self):
        t = 0
        for v in self.items:
            t += v
        return t
c = Counter()
c.inc().inc(5).inc()
print(c.n)
c.add(1).add(2).add(3)
print(c.total(), len(c.items))
c.map["a"] += 10
c.map["b"] = 5
c.map["b"] *= 3
print(c.map["a"], c.map["b"])
arr = [1, 2, 3, 4]
arr[0] += 10
arr[-1] = 40
arr[1] *= 5
arr[2] -= 1
print(arr[0], arr[1], arr[2], arr[3])
c.n -= 2
c.n *= 3
c.n %= 7
print(c.n)
